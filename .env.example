# ================================================
# PRODUCTION MULTIPLAYER CHESS ENVIRONMENT CONFIG
# ================================================

# Server & Network
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000,http://localhost:80

# PostgreSQL Database
POSTGRES_USER=chess_user
POSTGRES_PASSWORD=chess_secure_pass_2026
POSTGRES_DB=chess_db
DATABASE_URL=postgres://chess_user:chess_secure_pass_2026@postgres:5432/chess_db

# Redis Cache & Pub/Sub
REDIS_PASSWORD=chess_redis_secret
REDIS_URL=redis://:chess_redis_secret@redis:6379

# JWT Secrets & Security
JWT_SECRET=super_secret_jwt_chess_key_2026
JWT_REFRESH_SECRET=refresh_secret_jwt_chess_key_2026

# Stockfish / Anti-Cheat
STOCKFISH_MAX_DEPTH=18
ANTI_CHEAT_VARIANCE_THRESHOLD=50
ANTI_CHEAT_MAX_FLAGS=5
