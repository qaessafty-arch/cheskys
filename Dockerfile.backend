# FILE: Dockerfile.backend
FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
COPY backend/package*.json ./backend/
RUN npm ci --only=production

# Copy backend source
COPY backend/ ./backend/
COPY server.ts ./
COPY tsconfig.json ./

EXPOSE 3000

ENV NODE_ENV=production
CMD ["node", "backend/index.js"]
