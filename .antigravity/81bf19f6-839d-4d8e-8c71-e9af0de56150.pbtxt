          text: "    for (let i = 0; i < pointsCount; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const d = new Date();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (timeRange === \'1W\') d.setDate(now.getDate() - (pointsCount - 1 - i));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      else if (timeRange === \'1M\') d.setDate(now.getDate() - (pointsCount - 1 - i));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      else if (timeRange === \'1Y\') d.setDate(now.getDate() - (pointsCount - 1 - i) * 7);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      else d.setDate(now.getDate() - (pointsCount - 1 - i) * 15);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const fluctuation = Math.floor(Math.sin(i * 0.4) * 18) + (i > pointsCount - 5 ? 8 : (i % 3 === 0 ? 6 : -3));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      currentRating += fluctuation;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
