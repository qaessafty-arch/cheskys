  file_change {
    absolute_path_uri: "file:///src/components/Header.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "    <header\n      id=\"top-header-bar\"\n      className=\"w-full h-14 bg-[#10140e]/95 border-b border-[#F5C453]/25 backdrop-blur-2xl sticky top-0 z-30 shadow-xl shadow-black/50 transition-all flex items-center justify-between px-3 sm:px-6 select-none\"\n    >\n      {/* 1. Far Left: Hamburger Toggle Button */}\n      <div className=\"flex items-center gap-3\">\n        <button\n          id=\"header-hamburger-toggle\"\n          type=\"button\"\n          onClick={onToggleSidebar}\n          className=\"w-10 h-10 min-w-[44px] min-h-[44px] rounded-xl bg-white/5 hover:bg-white/10 active:scale-95 text-[#F5C453] hover:text-white flex items-center justify-center border border-[#F5C453]/30 transition-all cursor-pointer shadow-sm\"\n          aria-label={isSidebarOpen ? \'Close Navigation Menu\' : \'Open Navigation Menu\'}\n        >\n          {isSidebarOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n        </button>\n\n        {/* 2. Brand Logo: \"Chesskys\" with highlighted \"PRO\" badge */}\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-7 h-7 rounded-lg bg-gradient-to-br from-[#52673A] to-[#8C2425] border border-[#F5C453]/60 flex items-center justify-center text-sm shadow-md\">\n            \342\230\200\357\270\217\n          </div>\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"font-display font-black text-lg tracking-wide text-white drop-shadow-sm\">\n              Chesskys\n            </span>\n            <span className=\"text-[10px] font-black px-1.5 py-0.2 rounded-md bg-gradient-to-r from-amber-400 to-yellow-500 text-black shadow-sm uppercase tracking-wider\">\n              PRO\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* 3. Far Right: User Profile Avatar */}\n      <div className=\"flex items-center gap-2\">\n        <button\n          id=\"header-user-avatar-btn\"\n          type=\"button\"\n        