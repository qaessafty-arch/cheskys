  file_change {
    absolute_path_uri: "file:///src/components/Sidebar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { GameMode, RespectProfile, BoardThemeId, PieceThemeId } from \'../types/chess\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { listenToFriendsList } from \'../services/friendService\';\nimport {\n  Bot,\n  Swords,\n  Sparkles,\n  Compass,\n  User,\n  Globe,\n  Users,\n  Palette,\n  Sun,\n  Moon,\n  X,\n  ChevronRight,\n  Shield,\n  Crown,\n  Layers,\n  Settings\n} from \'lucide-react\';\n\ninterface SidebarProps {\n  isOpen: boolean;\n  onClose: () => void;\n  activeMode: GameMode;\n  onSelectMode: (mode: GameMode) => void;\n  onOpenFriends: () => void;\n  onOpenWorldwideMatch: () => void;\n  onOpenThemes: () => void;\n  onOpenSettings: () => void;\n  onOpenProfile: () => void;\n  currentThemeName?: string;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  isOpen,\n  onClose,\n  activeMode,\n  onSelectMode,\n  onOpenFriends,\n  onOpenWorldwideMatch,\n  onOpenThemes,\n  onOpenSettings,\n  onOpenProfile,\n  currentThemeName = \'Peshmerga\'\n}) => {\n  const { user, profile } = useAuth();\n  const [onlineFriendsCount, setOnlineFriendsCount] = useState<number>(0);\n  const [totalFriendsCount, setTotalFriendsCount] = useState<number>(0);\n\n  // Subscribe to friends list for live online count\n  useEffect(() => {\n    if (!profile?.uid) {\n      setOnlineFriendsCount(0);\n      setTotalFriendsCount(0);\n      return;\n    }\n\n    const unsub = listenToFriendsList(profile.uid, friends => {\n      if (Array.isArray(friends)) {\n        setTotalFriendsCount(friends.length);\n        const online = friends.filter(f => f && f.isOnline !== false).length;\n        setOnlineFriendsCount(online);\n      } else {\n        setOnlineFriendsCount(0);\n        setTotalFriendsCount(0);\n      }\n    });\n\n    return () => {\n      if (unsub) unsub();\n    };\n  }, [profile?.uid]);\n\n  // Clean formatted online string that NEVER returns \"null null\"\n  const formattedOnlineText = () => {\n    if (onlineFriendsCount > 0) {\n      return `${onlineFriendsCount} Online`;\n    }\n    if (totalFriendsCount > 0) {\n      return `${totalFriendsCount} ${totalFriendsCount === 1 ? \'Friend\' : \'Friends\'}`;\n    }\n    return \'Social\';\n  };\n\n  const navItems = [\n    {\n      id: \'ai\',\n      mode: \'ai\' as GameMode,\n      label: \'Play AI\',\n      icon: <Bot className=\"w-5 h-5 text-emerald-400\" />,\n      action: () => {\n        onSelectMode(\'ai\');\n        onClose();\n      }\n    },\n    {\n      id: \'multiplayer\',\n      mode: \'multiplayer\' as GameMode,\n      label: \'Multiplayer\',\n      icon: <Swords className=\"w-5 h-5 text-amber-400\" />,\n      action: () => {\n        onSelectMode(\'multiplayer\');\n        onClose();\n      }\n    },\n    {\n      id: \'puzzle\',\n      mode: \'puzzle\' as GameMode,\n      label: \'Puzzles & Daily\',\n      badge: \'DAILY\',\n      badgeClass: \'bg-gradient-to-r from-amber-400 to-yellow-500 text-black font-black text-[10px] px-1.5 py-0.5 rounded shadow-sm\',\n      icon: <Sparkles className=\"w-5 h-5 text-yellow-300\" />,\n      action: () => {\n        onSelectMode(\'puzzle\');\n        onClose();\n      }\n    },\n    {\n      id: \'analysis\',\n      mode: \'analysis\' as GameMode,\n      label: \'Analysis\',\n      icon: <Compass className=\"w-5 h-5 text-sky-400\" />,\n      action: () => {\n        onSelectMode(\'analysis\');\n        onClose();\n      }\n    },\n    {\n      id: \'profile\',\n      mode: \'profile_page\' as GameMode,\n      label: \'Profile\',\n      icon: <User className=\"w-5 h-5 text-purple-400\" />,\n      action: () => {\n        onOpenProfile();\n        onClose();\n      }\n    },\n    {\n      id: \'worldwide\',\n      label: \'Worldwide\',\n      icon: <Globe className=\"w-5 h-5 text-blue-400 animate-pulse\" />,\n      action: () => {\n        onOpenWorldwideMatch();\n        onClose();\n      }\n    },\n    {\n      id: \'friends\',\n      label: \'Friends\',\n      badge: formattedOnlineText(),\n      badgeClass: onlineFriendsCount > 0 \n        ? \'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[10px] font-bold px-2 py-0.5 rounded-full flex items-center gap-1\'\n        : \'bg-white/10 text-white/70 text-[10px] px-2 py-0.5 rounded-full\',\n      badgeDot: onlineFriendsCount > 0,\n      icon: <Users className=\"w-5 h-5 text-indigo-400\" />,\n      action: () => {\n        onOpenFriends();\n        onClose();\n      }\n    }\n  ];\n\n  return (\n    <>\n      {/* Mobile Backdrop Overlay */}\n      {isOpen && (\n        <div\n          id=\"sidebar-backdrop\"\n          onClick={onClose}\n          className=\"fixed inset-0 z-40 bg-black/70 backdrop-blur-sm transition-opacity duration-300 ease-in-out\"\n          aria-hidden=\"true\"\n        />\n      )}\n\n      {/* Collapsible Left Sidebar Drawer */}\n      <aside\n        id=\"app-collapsible-sidebar\"\n        className={`fixed top-0 bottom-0 left-0 z-50 w-72 sm:w-80 bg-[#121710] border-r border-[#F5C453]/20 shadow-2xl flex flex-col justify-between transform transition-transform duration-300 ease-in-out select-none ${\n          isOpen ? \'translate-x-0\' : \'-translate-x-full\'\n        }`}\n        aria-label=\"Application Main Sidebar\"\n      >\n        {/* Sidebar Header & Brand */}\n        <div className=\"p-4 border-b border-white/10 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-9 h-9 rounded-xl bg-gradient-to-br from-[#52673A] to-[#8C2425] border border-[#F5C453]/60 flex items-center justify-center text-lg shadow-lg\">\n              \342\230\200\357\270\217\n            </div>\n            <div>\n              <div className=\"flex items-center gap-1.5\">\n                <span className=\"font-display font-black text-base text-white tracking-wide\">\n                  Chesskys\n                </span>\n                <span className=\"text-[10px] font-black px-1.5 py-0.2 rounded-md bg-gradient-to-r from-amber-400 to-yellow-500 text-black shadow-sm uppercase tracking-wider\">\n                  PRO\n                </span>\n              </div>\n              <p className=\"text-[10px] text-[#DFD0B0]/60 font-mono\">Peshmerga Edition</p>\n            </div>\n          </div>\n\n          <button\n            id=\"sidebar-close-btn\"\n            type=\"button\"\n            onClick={onClose}\n            className=\"w-9 h-9 rounded-xl bg-white/5 hover:bg-white/10 text-white/70 hover:text-white flex items-center justify-center transition-colors cursor-pointer border border-white/10\"\n            aria-label=\"Close Sidebar\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Sidebar Navigation Items */}\n        <div className=\"flex-1 overflow-y-auto p-3 space-y-1.5\">\n          <div className=\"px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-[#DFD0B0]/40\">\n            Game Navigation\n          </div>\n\n          {navItems.map(item => {\n            const isActive = item.mode && activeMode === item.mode;\n            return (\n              <button\n                key={item.id}\n                id={`sidebar-nav-${item.id}`}\n                type=\"button\"\n                onClick={item.action}\n                className={`w-full min-h-[44px] px-3.5 py-2.5 rounded-2xl flex items-center justify-between text-left transition-all cursor-pointer group ${\n                  isActive\n                    ? \'bg-gradient-to-r from-[#52673A]/90 to-[#52673A]/60 text-white font-bold border border-[#F5C453]/50 shadow-lg shadow-[#52673A]/30\'\n                    : \'text-[#DFD0B0]/80 hover:text-white hover:bg-white/[0.06] border border-transparent\'\n                }`}\n              >\n                <div className=\"flex items-center gap-3\">\n                  <div className={`p-1.5 rounded-xl transition-transform group-hover:scale-110 ${\n                    isActive ? \'bg-white/10\' : \'bg-black/30\'\n                  }`}>\n                    {item.icon}\n                  </div>\n                  <span className=\"text-sm font-semibold\">{item.label}</span>\n                </div>\n\n                {item.badge && (\n                  <div className=\"flex items-center gap-1\">\n                    <span className={item.badgeClass}>\n                      {item.badgeDot && (\n                        <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\" />\n                      )}\n                      {item.badge}\n                    </span>\n                  </div>\n                )}\n              </button>\n            );\n          })}\n        </div>\n\n        {/* Bottom Theme & Settings Controls (Pinned) */}\n        <div className=\"p-3 border-t border-white/10 bg-black/40 space-y-2\">\n          {/* Switch Theme Button */}\n          <button\n            id=\"sidebar-switch-theme-btn\"\n            type=\"button\"\n            onClick={() => {\n              onOpenThemes();\n              onClose();\n            }}\n            className=\"w-full min-h-[44px] px-3.5 py-2.5 rounded-2xl bg-gradient-to-r from-purple-900/40 via-indigo-900/30 to-amber-900/30 hover:from-purple-900/60 hover:to-amber-900/50 border border-white/15 text-white flex items-center justify-between transition-all cursor-pointer shadow-md group\"\n          >\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-8 h-8 rounded-xl bg-purple-500/20 border border-purple-400/40 flex items-center justify-center text-purple-300 group-hover:rotate-12 transition-transform\">\n                <Palette className=\"w-4 h-4\" />\n              </div>\n              <div className=\"text-left\">\n                <div className=\"text-xs font-bold text-white flex items-center gap-1.5\">\n                  <span>Switch Theme</span>\n                  <span className=\"text-[9px] px-1.5 py-0.2 rounded bg-amber-400 text-black font-black\">\n                    3 PACK\n                  </span>\n                </div>\n                <span className=\"text-[10px] text-[#DFD0B0]/60 truncate block max-w-[130px]\">\n                  AoT \342\200\242 Batman \342\200\242 Classic\n                </span>\n              </div>\n            </div>\n            <ChevronRight className=\"w-4 h-4 text-white/50 group-hover:translate-x-0.5 transition-transform\" />\n          </button>\n\n          {/* Quick Settings Action */}\n          <button\n            id=\"sidebar-settings-btn\"\n            type=\"button\"\n            onClick={() => {\n              onOpenSettings();\n              onClose();\n            }}\n            className=\"w-full min-h-[40px] px-3 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-white/70 hover:text-white flex items-center justify-center gap-2 text-xs font-semibold transition-colors cursor-pointer border border-white/5\"\n          >\n            <Settings className=\"w-3.5 h-3.5 text-amber-400\" />\n            <span>Preferences & Custom Board</span>\n          </button>\n        </div>\n      </aside>\n    </>\n  );\n};\n"
    }
