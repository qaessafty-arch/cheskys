\"\n          type=\"button\"\n          onClick={user ? onOpenProfile : (onOpenLogin || onOpenProfile)}\n          className=\"min-w-[44px] min-h-[44px] p-1 rounded-2xl bg-[#111827]/80 hover:bg-[#1F293D] flex items-center gap-2.5 transition-all cursor-pointer border border-[#1F293D] hover:border-[#F59E0B]/40\"\n          title={user ? `${userDisplayName} (Profile & Stats)` : \'Sign In / Profile\'}\n        >\n          {/* User Avatar Circle */}\n          <div className=\"relative\">\n            {profile?.photoURL || user?.photoURL ? (\n              <img\n                src={profile?.photoURL || user?.photoURL || \'\'}\n                alt={userDisplayName}\n                className=\"w-9 h-9 rounded-full object-cover border-2 border-[#F59E0B] shadow-md\"\n                referrerPolicy=\"no-referrer\"\n              />\n            ) : (\n              <div className=\"w-9 h-9 rounded-full bg-gradient-to-br from-[#1E293B] to-[#0F172A] border-2 border-[#F59E0B] flex items-center justify-center font-bold text-xs text-white shadow-md\">\n                {user ? userDisplayName.charAt(0).toUpperCase() : <User className=\"w-4 h-4 text-white/80\" />}\n              </div>\n            )}\n            <span className=\"absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-emerald-500 border border-black ring-1 ring-black\" />\n          </div>\n\n          {/* User Rating Display on Desktop */}\n          <div className=\"hidden sm:flex flex-col text-left leading-tight pr-1.5\">\n            <span className=\"text-xs font-black text-white truncate max-w-[100px]\">\n              {userDisplayName}\n            </span>\n            <span className=\"text-[10px] font-mono text-[#F59E0B] font-bold\">\n              {currentElo} Elo\n            </span>\n          </div>\n        </button>\n      </div>\n    </header>"
