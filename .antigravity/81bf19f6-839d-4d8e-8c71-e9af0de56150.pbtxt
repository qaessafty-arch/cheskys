    replacement_chunks {
      target_content: "/* Smooth drag piece styling */\n.chess-drag-piece {\n  will-change: transform, left, top;\n  transform: translate3d(0, 0, 0);\n  pointer-events: none;\n  touch-action: none;\n}"
      replacement_content: "/* Smooth drag piece styling */\n.chess-drag-piece {\n  will-change: transform, left, top;\n  transform: translate3d(0, 0, 0);\n  pointer-events: none;\n  touch-action: none;\n}\n\n/* ========================================================================= */\n/* RESPECT HONOR BADGE & POINTS REWARD CSS ANIMATIONS                         */\n/* ========================================================================= */\n\n@keyframes respect-badge-enter {\n  0% {\n    opacity: 0;\n    transform: scale(0.9) translateY(6px);\n    box-shadow: 0 0 0 0 rgba(245, 196, 83, 0);\n  }\n  60% {\n    opacity: 1;\n    transform: scale(1.04) translateY(-1px);\n    box-shadow: 0 0 20px 2px rgba(245, 196, 83, 0.35);\n  }\n  100% {\n    opacity: 1;\n    transform: scale(1) translateY(0);\n    box-shadow: 0 0 10px 0 rgba(245, 196, 83, 0.15);\n  }\n}\n\n.respect-badge-entry {\n  animation: respect-badge-enter 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;\n  will-change: transform, opacity, box-shadow;\n}\n\n@keyframes respect-points-pop {\n  0% {\n    transform: scale(1);\n    color: #F5C453;\n    text-shadow: 0 0 0px transparent;\n  }\n  40% {\n    transform: scale(1.22) translateY(-2px);\n    color: #FFF6D6;\n    text-shadow: 0 0 14px rgba(245, 196, 83, 0.85), 0 0 24px rgba(245, 196, 83, 0.4);\n  }\n  75% {\n    transform: scale(1.06) translateY(-0.5px);\n    color: #FEE79A;\n  }\n  100% {\n    transform: scale(1) translateY(0);\n    color: #F5C453;\n    text-shadow: 0 0 4px rgba(245, 196, 83, 0.25);\n  }\n}\n\n.respect-points-bump {\n  animation: respect-points-pop 0.65s cubic-bezier(0.34, 1.56, 0.64, 1);\n  will-change: transform, color, text-shadow;\n}\n\n@keyframes respect-glow-sweep {\n  0% {\n    background-position: -200% 0;\n  }\n  100% {\n    background-position: 200% 0;\n  }\n}\n\n.respect-shimmer-sheen {\n  background: linear-gradient(\n    90deg,\n    rgba(245, 196, 83, 0) 0%,\n    rgba(245, 196, 83, 0.18) 50%,\n    rgba(245, 196, 83, 0) 100%\n  );\n  background-size: 200% 100%;\n  animation: respect-glow-sweep 3s infinite ease-in-out;\n}\n\n@keyframes respect-ring-bloom {\n  0% {\n    box-shadow: 0 0 0 0 rgba(245, 196, 83, 0.65);\n  }\n  50% {\n    box-shadow: 0 0 0 8px rgba(245, 196, 83, 0.2);\n  }\n  100% {\n    box-shadow: 0 0 0 14px rgba(245, 196, 83, 0);\n  }\n}\n\n.respect-bloom-active {\n  animation: respect-ring-bloom 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n@keyframes respect-delta-float {\n  0% {\n    opacity: 0;\n    transform: translateY(6px) scale(0.85);\n  }\n  20% {\n    opacity: 1;\n    transform: translateY(-2px) scale(1.1);\n  }\n  80% {\n    opacity: 0.9;\n    transform: translateY(-16px) scale(1);\n  }\n  100% {\n    opacity: 0;\n    transform: translateY(-26px) scale(0.9);\n  }\n}\n\n.respect-delta-pill {\n  animation: respect-delta-float 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;\n  pointer-events: none;\n  user-select: none;\n}\n"
    }
