 onSelectMode: (mode: GameMode) => void;\n36:   onOpenSettings: () => void;\n37:   onOpenHowToPlay: () => void;\n38:   onOpenHistory?: () => void;\n39:   onOpenFriends?: () => void;\n40:   onOpenDatabase?: () => void;\n41:   onOpenThemeStudio?: () => void;\n42:   pendingFriendRequestsCount?: number;\n43:   onlineFriendsCount?: number;\n44:   respectLevel?: number;\n45:   respectPoints?: number;\n46:   currentTitle?: string;\n47:   soundEnabled?: boolean;\n48:   onToggleMute?: () => void;\n49: }\n50: \n51: export const Header: React.FC<HeaderProps> = ({\n52:   activeMode,\n53:   onSelectMode,\n54:   onOpenSettings,\n55:   onOpenHowToPlay,\n56:   onOpenHistory,\n57:   onOpenFriends,\n58:   onOpenDatabase,\n59:   onOpenThemeStudio,\n60:   pendingFriendRequestsCount = 0,\n61:   onlineFriendsCount = 0,\n62:   respectLevel = 1,\n63:   respectPoints = 0,\n64:   currentTitle = \'Scout Cadet\',\n65:   soundEnabled = true,\n66:   onToggleMute\n67: }) => {\n68:   const [showMobileMenu, setShowMobileMenu] = useState(false);\n69:   const desktopNavRef = useRef<HTMLDivElement>(null);\n70:   const subNavRef = useRef<HTMLDivElement>(null);\n71: \n72:   const scrollNav = (ref: React.RefObject<HTMLDivElement | null>, direction: \'left\' | \'right\') => {\n73:     if (ref.current) {\n74:       const scrollAmount = direction === \'left\' ? -200 : 200;\n75:       ref.current.scrollBy({ left: scrollAmount, behavior: \'smooth\' });\n76:     }\n77:   };\n78: \n79:   const handleWheelScroll = (e: React.WheelEvent<HTMLDivElement>) => {\n80:     if (e.currentTarget && e.deltaY !== 0) {\n81:       e.currentTarget.scrollLeft += e.deltaY;\n82:     }\n83:   };\n84:   const { currentUser, userProfile: profile } = useAuth();\n85: \n86:   const navItems: { mode: GameMode; label: string; icon: React.ReactNode; badge?: string }[] = [\n87:     { mode: \'ai\', label: \'Play AI\', icon: <Bot className=\"w-4 h-4\" /> },\n88:     { mode: \'multiplayer\', label: \'Multiplayer\', icon: <Users className=\"w-4 h-4\" />, badge: \'LIVE\' },\n89:     { mode: \'puzzle\', label: \'Puzzles\', icon: <Puzzle className=\"w-4 h-4\" /> },\n90:     { mode: \'analysis\', label: \'Analysis\', icon: <BarChart2 className=\"w-4 h-4\" /> },\n91:     { mode: \'pass_and_play\', label: \'Pass & Play\', icon: <Swords className=\"w-4 h-4\" /> },\n92:     { mode: \'online_match\', label: \'Worldwide\', icon: <Globe2 className=\"w-4 h-4\" /> },\n93:     { mode: \'authoring\', label: \'Studio\', icon: <Sparkles className=\"w-4 h-4\" />, badge: \'NEW\' },\n94:     { mode: \'logging\', label: \'Logs\', icon: <Database className=\"w-4 h-4\" /> }\n95:   ];\n96: \n97:   return (\n98:     <header className=\"sticky top-0 z-40 w-full border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-xl transition-all duration-300\">\n99:       <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n100:         <div className=\"flex items-center justify-between h-16 sm:h-18\">\n101:           {/* Brand & Logo */}\n102:           <div className=\"flex items-center gap-3\">\n103:             <button\n104:               onClick={() => onSelectMode(\'ai\')}\n105:               className=\"flex items-center gap-2.5 group focus:outline-none text-left\"\n106:               id=\"brand-logo-btn\"\n107:             >\n108:               <div className=\"relative w-9 h-9 sm:w-10 sm:h-10 rounded-2xl bg-gradient-to-br from-amber-400 via-amber-500 to-amber-700 p-0.5 shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform\">\n109:                 <div className=\"w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center\">\n110:                   <span className=\"text-xl sm:text-2xl select-none group-hover:rotate-12 transition-transform\">\342\231\232</span>\n111:                 </div>\n112:               </div>\n113: \n114:               <div className=\"flex flex-col\">\n115:                 <div className=\"flex items-center gap-1.5\">\n116:                   <span className=\"font-b