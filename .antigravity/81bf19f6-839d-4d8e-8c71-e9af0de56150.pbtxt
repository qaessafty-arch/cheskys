strokeWidth=\"0.8\" />\n                {/* Acid Squirting Lapel Carnation */}\n                <circle cx=\"16\" cy=\"23\" r=\"2.2\" fill=\"url(#joker-toxic-green)\" stroke=\"#18181B\" strokeWidth=\"0.8\" />\n                <circle cx=\"16\" cy=\"23\" r=\"1\" fill=\"#FEF08A\" />\n                {/* Pale White Visage with Wild Neon Green Hair */}\n                <path\n                  d=\"M 14 10 C 13 4 17 3 22.5 3 C 28 3 32 4 31 10 C 33 7 35 11 31 15 C 30 19 28 22 22.5 22 C 17 22 15 19 14 15 C 10 11 12 7 14 10 Z\"\n                  fill=\"url(#joker-toxic-green)\"\n                  stroke=\"#15803D\"\n                  strokeWidth=\"1.2\"\n                />\n                {/* Pale Skin Face Mask */}\n                <path\n                  d=\"M 16 12 C 16 8 20 6 22.5 6 C 25 6 29 8 29 12 C 29 17 27 20 22.5 20 C 18 20 16 17 16 12 Z\"\n                  fill=\"#F8FAFC\"\n                  stroke=\"#18181B\"\n                  strokeWidth=\"1.2\"\n                />\n                {/* Signature Red Slashed Smile */}\n                <path d=\"M 17 15 C 19 19 26 19 28 15\" stroke=\"#DC2626\" strokeWidth=\"2.2\" fill=\"none\" />\n                <path d=\"M 18.5 15.5 L 26.5 15.5\" stroke=\"#FEF08A\" strokeWidth=\"1.2\" />\n                {/* Sunken Toxic Amber Eyes */}\n                <circle cx=\"19\" cy=\"11\" r=\"1.3\" fill=\"#FACC15\" stroke=\"#18181B\" strokeWidth=\"0.6\" />\n                <circle cx=\"26\" cy=\"11\" r=\"1.3\" fill=\"#FACC15\" stroke=\"#18181B\" strokeWidth=\"0.6\" />\n                {/* Crown Playing Card Jester Finial */}\n                <rect x=\"20.5\" y=\"0.5\" width=\"4\" height=\"6\" rx=\"0.5\" fill=\"#FFFFFF\" stroke=\"#DC2626\" strokeWidth=\"0.8\" />\n                <polygon points=\"22.5,2 23.5,3.5 22.5,5 21.5,3.5\" fill=\"#DC2626\" />\n              </g>\n            )}\n          </g>\n        )}\n      </svg>\n    </div>\n  );\n};\n```\n}"
    thinking: "**Designing Piece Components**\n\nOkay, I\'m making progress on component design. I\'ve decided on a `/src/components/pieces/BatmanPiece.tsx` file for all the Gotham City Batman assets. This keeps things tidy. I\'m starting with the \"White Pieces\" or \"Gotham Heroes,\" and the King is Batman, specifically focused on his Dark Knight Cowl, Bat Ears, and Chest Emblem features. I\'m focusing on modularity and avoiding token constraints.\n\n\n**Defining Piece Characters**\n\nI\'ve been fleshing out the remaining component characters. I\'ve got detailed descriptions for both white and black pieces, including Queen, Bishop, Knight, Rook, and Pawn variations. I have carefully considered visual elements for each piece, such as Catwoman\'s whip curve and Two-Face\'s split coin. I\'m aiming for unique, thematic representations.\n\nOkay, I\'m making progress on component design. I\'ve decided on a `/src/components/pieces/BatmanPiece.tsx` file for all the Gotham City Batman assets. This keeps things tidy. I\'m starting with the \"White Pieces\" or \"Gotham Heroes,\" and the King is Batman, specifically focused on his Dark Knight Cowl, Bat Ears, and Chest Emblem features. I\'m focusing on modularity and avoiding token constraints.\n\n\n"
    modified_response: "I will create `/src/components/pieces/BatmanPiece.tsx` with high-detail SVG vectors for all Gotham Heroes (White) and Gotham Villains (Black).The following action was requested:\nCreate file /src/components/pieces/BatmanPiece.tsxThe action produced the following result:\nTarget file `/src/components/pieces/BatmanPiece.tsx` created successfully.\nFile Content:\n```\nimport React from \'react\';\nimport { PieceType, PieceColor } from \'../../types/chess\';\n\ninterface BatmanPieceProps {\n  type: PieceType;\n  color: PieceColor;\n  className?: string;\n}\n\nexport const BatmanPiece: React.FC<BatmanPieceProps> = ({\n  type,\n  color,\n  className = \'w-full h-full\'\n}) => {\n  const isWhite = color === \'w\';\n\n  return (\n    <div className=\"relative w-full h-full flex items-center justify-center select-none pointer-events-none drop-shadow-[0_4px_10px_rgba(0,0,0,0.65)]\">\n      <svg viewBox=\"0 0 45 45\" className={className} xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          {/* Hero Gradients (Batman / Gotham Heroes) */}\n          <linearGradient id=\"bat-suit-dark\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#334155\" />\n            <stop offset=\"50%\" stopColor=\"#1E293B\" />\n            <stop offset=\"100%\" stopColor=\"#0F172A\" />\n          </linearGradient>\n          <linearGradient id=\"bat-gold-signal\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#FEF08A\" />\n            <stop offset=\"50%\" stopColor=\"#EAB308\" />\n            <stop offset=\"100%\" stopColor=\"#CA8A04\" />\n          </linearGradient>\n          <linearGradient id=\"bat-metal-slate\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#E2E8F0\" />\n            <stop offset=\"50%\" stopColor=\"#94A3B8\" />\n            <stop offset=\"100%\" stopColor=\"#475569\" />\n          </linearGradient>\n          <linearGradient id=\"bat-cat-violet\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#C084FC\" />\n            <stop offset=\"50%\" stopColor=\"#7E22CE\" />\n            <stop offset=\"100%\" stopColor=\"#3B0764\" />\n          </linearGradient>\n          <linearGradient id=\"bat-nightwing-blue\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#38BDF8\" />\n            <stop offset=\"50%\" stopColor=\"#0284C7\" />\n            <stop offset=\"100%\" stopColor=\"#0C4A6E\" />\n          </linearGradient>\n\n          {/* Villain Gradients (Joker / Arkham Rogues) */}\n          <linearGradient id=\"joker-purple\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#A855F7\" />\n            <stop offset=\"50%\" stopColor=\"#6B21A8\" />\n            <stop offset=\"100%\" stopColor=\"#3B0764\" />\n          </linearGradient>\n          <linearGradient id=\"joker-toxic-green\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#4ADE80\" />\n            <stop offset=\"50%\" stopColor=\"#22C55E\" />\n            <stop offset=\"100%\" stopColor=\"#15803D\" />\n          </linearGradient>\n          <linearGradient id=\"harley-crimson\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#F87171\" />\n            <stop offset=\"50%\" stopColor=\"#DC2626\" />\n            <stop offset=\"100%\" stopColor=\"#7F1D1D\" />\n          </linearGradient>\n          <linearGradient id=\"bane-venom-glow\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#86EFAC\" />\n            <stop offset=\"50%\" stopColor=\"#10B981\" />\n            <stop offset=\"100%\" stopColor=\"#047857\" />\n          </linearGradient>\n          <linearGradient id=\"arkham-stone-dark\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#3F3F46\" />\n            <stop offset=\"50%\" stopColor=\"#27272A\" />\n            <stop offset=\"100%\" stopColor=\"#09090B\" />\n          </linearGradient>\n\n          {/* Glow Filters */}\n          <filter id=\"bat-glow-yellow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n            <feDropShadow dx=\"0\" dy=\"1\" stdDeviation=\"1.5\" floodColor=\"#EAB308\" floodOpacity=\"0.65\" />\n          </filter>\n          <filter id=\"joker-glow-purple\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n            <feDropShadow dx=\"0\" dy=\"1\" stdDeviation=\"1.5\" floodColor=\"#A855F7\" floodOpacity=\"0.65\" />\n          </filter>\n        </defs>\n\n        {/* =================================================================== */}\n        {/* WHITE PIECES: GOTHAM HEROES (BATMAN, CATWOMAN, NIGHTWING, GCPD)    */}\n        {/* =================================================================== */}\n        {isWhite && (\n          <g filter=\"url(#bat-glow-yellow)\">\n            {/* WHITE PAWN: GCPD Officer (Badge Shield & Flashlight Beam) */}\n            {type === \'p\' && (\n              <g strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                {/* Tactical Base */}\n                <path d=\"M 12 39.5 L 33 39.5 L 31 35 L 14 35 Z\" fill=\"#1E293B\" stroke=\"#EAB308\" strokeWidth=\"1.2\" />\n                {/* GCPD 7-Point Star Shield */}\n                <path\n                  d=\"M 22.5 8 L 26.5 13.5 L 33 13.5 L 29 19 L 31.5 25.5 L 25 24 L 22.5 30 L 20 24 L 13.5 25.5 L 16 19 L 12 13.5 L 18.5 13.5 Z\"\n                  fill=\"url(#bat-gold-signal)\"\n                  stroke=\"#713F12\"\n                  strokeWidth=\"1\"\n                />\n                {/* Blue Enamel Badge Center */}\n                <circle cx=\"22.5\" cy=\"18.5\" r=\"5\" fill=\"#0F172A\" stroke=\"#EAB308\" strokeWidth=\"1\" />\n                {/* GCPD Police Cap Monogram */}\n                <path d=\"M 19 18.5 L 22.5 15.5 L 26 18.5\" stroke=\"#E2E8F0\" strokeWidth=\"1.2\" fill=\"none\" />\n                <path d=\"M 20 20.5 L 25 20.5\" stroke=\"#EAB308\" strokeWidth=\"1\" />\n                {/* Tactical Vest Armor Ribs */}\n                <path d=\"M 16 35 L 17 30 L 28 30 L 29 35 Z\" fill=\"#334155\" stroke=\"#0F172A\" strokeWidth=\"1\" />\n                <circle cx=\"22.5\" cy=\"32.5\" r=\"1\" fill=\"#EAB308\" />\n              </g>\n            )}\n\n            {/* WHITE KNIGHT: The Batmobile (Jet Turbine & Bat Fins) */}\n            {type === \'n\' && (\n              <g strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                {/* Base Platform */}\n                <path d=\"M 9 39 L 36 39 L 34 35 L 11 35 Z\" fill=\"#0F172A\" stroke=\"#EAB308\" strokeWidth=\"1.2\" />\n                {/* Batmobile Aerodynamic Chasis & Cockpit */}\n                <path\n                  d=\"M 22 7 C 32 9 38 15 37 35 L 13 35 C 13 28 20 29 20 17 C 21 19 16 22 13 24 C 9 26 7 28 5 26 C 4 24 8 21 9 19 C 7 17 9 12 14 11 C 15 9 18 8 22 7 Z\"\n                  fill=\"url(#bat-suit-dark)\"\n                  stroke=\"#EAB308\"\n                  strokeWidth=\"1.4\"\n                />\n                {/* Swept Back Bat Wing Rear Fins */}\n                <path d=\"M 24 10 L 37 18 L 33 24 L 27 18 Z\" fill=\"#1E293B\" stroke=\"#EAB308\" strokeWidth=\"1\" />\n                {/* Armored Canopy Window (Neon Gold Glass) */}\n                <path d=\"M 12 18 C 15 14 20 14 23 18 L 20 23 L 14 22 Z\" fill=\"url(#bat-gold-signal)\" stroke=\"#0F172A\" strokeWidth=\"0.8\" opacity=\"0.9\" />\n                {/* Afterburner Turbine Jet & Wheel Arch */}\n                <circle cx=\"30\" cy=\"29\" r=\"3.5\" fill=\"#0F172A\" stroke=\"#EAB308\" strokeWidth=\"1.2\" />\n                <circle cx=\"30\" cy=\"29\" r=\"1.5\" fill=\"#EAB308\" />\n                {/* Front Battering Ram & Headlight */}\n                <path d=\"M 6 26 L 10 24\" stroke=\"#EAB308\" strokeWidth=\"2.2\" />\n                <circle cx=\"8\" cy=\"22\" r=\"1\" fill=\"#FEF08A\" />\n              </g>\n            )}\n\n            {/* WHITE BISHOP: Nightwing & Robin (Dual Escrima Sticks & Winged Domino Mask) */}\n            {type === \'b\' && (\n              <g strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                {/* Base Pedestal */}\n                <path d=\"M 10 39.5 L 35 39.5 L 33 36 L 12 36 Z\" fill=\"#0F172A\" stroke=\"#38BDF8\" strokeWidth=\"1.4\" />\n                {/* Hero Cowl & Shoulders */}\n                <path\n                  d=\"M 14 36 C 13 30 15 26 17 24 C 16 22 13 19 13 15 C 13 10 18 6 22.5 5 C 27 6 32 10 32 15 C 32 19 29 22 28 24 C 30 26 32 30 31 36 Z\"\n                  fill=\"url(#bat-suit-dark)\"\n                  stroke=\"#38BDF8\"\n                  strokeWidth=\"1.5\"\n                />\n                {/* Crossed Neon Blue Escrima Fighting Sticks */}\n                <path d=\"M 10 16 L 35 28\" stroke=\"url(#bat-nightwing-blue)\" strokeWidth=\"2.5\" />\n                <path d=\"M 35 16 L 10 28\" stroke=\"url(#bat-nightwing-blue)\" strokeWidth=\"2.5\" />\n                {/* Nightwing V-Wing Chest Insignia */}\n                <path\n                  d=\"M 15 20 L 22.5 25 L 30 20 L 26 18 L 22.5 21 L 19 18 Z\"\n                  fill=\"url(#bat-nightwing-blue)\"\n                  stroke=\"#38BDF8\"\n                  strokeWidth=\"0.8\"\n                />\n                {/* Winged Domino Mask Eyes */}\n                <polygon points=\"17,14 21,15 19,13\" fill=\"#38BDF8\" />\n                <polygon points=\"28,14 24,15 26,13\" fill=\"#38BDF8\" />\n                {/* Top Bat Finial */}\n                <circle cx=\"22.5\" cy=\"4\" r=\"2.2\" fill=\"#38BDF8\" stroke=\"#0F172A\" strokeWidth=\"1\" />\n              </g>\n            )}\n\n            {/* WHITE ROOK: Wayne Tower (Art Deco Gothic Skyscraper & Bat-Signal Crest) */}\n            {type === \'r\' && (\n              <g strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                {/* Fortified Skyscraper Base */}\n                <path d=\"M 8 39.5 L 37 39.5 L 35 34 L 10 34 Z\" fill=\"#0F172A\" stroke=\"#EAB308\" strokeWidth=\"1.4\" />\n                {/* Art Deco Wayne Tower Monolith Shaft */}\n                <path d=\"M 12 34 L 13.5 15 L 31.5 15 L 33 34 Z\" fill=\"url(#bat-suit-dark)\" stroke=\"#EAB308\" strokeWidth=\"1.5\" />\n                {/* Gothic Gargoyle Castle Battlements */}\n                <path\n                  d=\"M 10 15 L 10 7 L 14 7 L 14 10 L 19 10 L 19 7 L 26 7 L 26 10 L 31 10 L 31 7 L 35 7 L 35 15 Z\"\n                  fill=\"#1E293B\"\n                  stroke=\"#EAB308\"\n                  strokeWidth=\"1.5\"\n                />\n                {/* Art Deco Vertical Fluting Pillars */}\n                <path d=\"M 17 15 L 17 34 M 22.5 15 L 22.5 34 M 28 15 L 28 34\" stroke=\"#475569\" strokeWidth=\"1.2\" />\n                {/* Golden \"W\" Wayne Enterprises Crest */}\n                <path d=\"M 18 24 L 20 30 L 22.5 25 L 25 30 L 27 24\" stroke=\"url(#bat-gold-signal)\" strokeWidth=\"1.8\" fill=\"none\" />\n                {/* Spire Beacon Light */}\n                <circle cx=\"22.5\" cy=\"7\" r=\"1.5\" fill=\"#FEF08A\" />\n                <path d=\"M 11 34.5 L 34 34.5\" stroke=\"#EAB308\" strokeWidth=\"2.2\" />\n              </g>\n            )}\n\n            {/* WHITE QUEEN: Catwoman (Cat Mask, Ruby Whip & Emerald Eyes) */}\n            {type === \'q\' && (\n              <g strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                {/* Throne Pedestal */}\n                <path d=\"M 10 39.5 L 35 39.5 C 35 36 33 34 31 32 L 14 32 C 12 34 10 36 10 39.5 Z\" fill=\"#0F172A\" stroke=\"#C084FC\" strokeWidth=\"1.5\" />\n                {/* Catsuit Sleek Torso */}\n                <path\n                  d=\"M 13 32 C 12 25 15 21 22.5 20 C 30 21 33 25 32 32 Z\"\n                  fill=\"url(#bat-suit-dark)\"\n                  stroke=\"#C084FC\"\n                  strokeWidth=\"1.5\"\n                />\n                {/* Coiled Bullwhip Curve */}\n                <path\n                  d=\"M 8 36 C 6 26 12 18 22.5 18 C 34 18 38 27 36 36\"\n                  stroke=\"url(#bat-cat-violet)\"\n                  strokeWidth=\"2\"\n                  fill=\"none\"\n                />\n                <circle cx=\"7.5\" cy=\"35\" r=\"1.5\" fill=\"#EAB308\" />\n                {/* Catwoman Cowl with Pointed Ears */}\n                <path\n                  d=\"M 15 20 L 14 8 L 19 13 L 26 13 L 31 8 L 30 20 Z\"\n                  fill=\"url(#bat-suit-dark)\"\n                  stroke=\"#C084FC\"\n                  strokeWidth=\"1.4\"\n                />\n                {/* Glowing Cat Goggles / Emerald Eyes */}\n                <ellipse cx=\"18\" cy=\"15\" rx=\"2.5\" ry=\"1.5\" fill=\"#4ADE80\" stroke=\"#0F172A\" strokeWidth=\"0.6\" />\n                <ellipse cx=\"27\" cy=\"15\" rx=\"2.5\" ry=\"1.5\" fill=\"#4ADE80\" stroke=\"#0F172A\" strokeWidth=\"0.6\" />\n                {/* Crown Diamond Jewels on Headpiece */}\n                <circle cx=\"14\" cy=\"7.5\" r=\"1.5\" fill=\"#C084FC\" stroke=\"#0F172A\" strokeWidth=\"0.8\" />\n                <circle cx=\"22.5\" cy=\"11\" r=\"2\" fill=\"#EAB308\" stroke=\"#0F172A\" strokeWidth=\"0.8\" />\n                <circle cx=\"31\" cy=\"7.5\" r=\"1.5\" fill=\"#C084FC\" stroke=\"#0F172A\" strokeWidth=\"0.8\" />\n              </g>\n            )}\n\n            {/* WHITE KING: Batman The Dark Knight (Bat Ears Cowl & Chest Bat-Insignia) */}\n            {type === \'k\' && (\n              <g strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                {/* Royal Pedestal Base */}\n                <path d=\"M 10 39.5 L 35 39.5 C 35 35 33 33 31 31 L 14 31 C 12 33 10 35 10 39.5 Z\" fill=\"#0F172A\" stroke=\"#EAB308\" strokeWidth=\"1.6\" />\n                {/* Sweeping Dark Knight Scalloped Cape Wings */}\n                <path\n                  d=\"M 7 36 C 6 22 13 14 22.5 13 C 32 14 39 22 38 36 C 33 32 30 35 27 31 C 24 35 21 35 18 31 C 15 35 12 32 7 36 Z\"\n                  fill=\"url(#bat-suit-dark)\"\n                  stroke=\"#EAB308\"\n                  strokeWidth=\"1.4\"\n                />\n                {/* Broad Armored Torso with Utility Belt */}\n                <path d=\"M 14 31 C 13 25 16 20 22.5 19 C 29 20 32 25 31 31 Z\" fill=\"#1E293B\" stroke=\"#0F172A\" strokeWidth=\"1.2\" />\n                {/* Golden Utility Belt */}\n                <rect x=\"15\" y=\"28\" width=\"15\" height=\"3\" rx=\"1\" fill=\"url(#bat-gold-signal)\" stroke=\"#713F12\" strokeWidth=\"0.8\" />\n                <rect x=\"21\" y=\"27.5\" width=\"3\" height=\"4\" rx=\"0.5\" fill=\"#FEF08A\" stroke=\"#713F12\" strokeWidth=\"0.8\" />\n                {/* Iconic Batman Chest Emblem (Bat Silhouette in Oval) */}\n                <ellipse cx=\"22.5\" cy=\"23\" rx=\"5.5\" ry=\"3.5\" fill=\"url(#bat-gold-signal)\" stroke=\"#713F12\" strokeWidth=\"0.8\" />\n                <path\n                  d=\"M 19 23 C 19 21 21 21.5 22.5 23.5 C 24 21.5 26 21 26 23 C 25.5 24.5 24 25 22.5 24 C 21 25 19.5 24.5 19 23 Z\"\n                  fill=\"#0F172A\"\n                />\n                {/* Batman Cowl with Tall Sharp Bat Ears */}\n                <path\n                  d=\"M 16 17 L 15 4 L 19.5 10 L 25.5 10 L 30 4 L 29 17 Z\"\n                  fill=\"url(#bat-suit-dark)\"\n                  stroke=\"#EAB308\"\n                  strokeWidth=\"1.4\"\n                />\n                {/* Narrow White Slit Cowl Eyes */}\n                <polygon points=\"18,13 20.5,13.5 19,12\" fill=\"#FEF08A\" />\n                <polygon points=\"27,13 24.5,13.5 26,12\" fill=\"#FEF08A\" />\n                {/* Crown King Cross Finial (Bat-Signal Top Jewel) */}\n                <circle cx=\"22.5\" cy=\"3\" r=\"2.2\" fill=\"url(#bat-gold-signal)\" stroke=\"#0F172A\" strokeWidth=\"0.8\" />\n              </g>\n            )}\n          </g>\n        )}\n\n        {/* =================================================================== */}\n        {/* BLACK PIECES: GOTHAM VILLAINS (JOKER, HARLEY, RIDDLER, BANE, ARKHAM) */}\n        {/* =================================================================== */}\n        {!isWhite && (\n          <g filter=\"url(#joker-glow-purple)\">\n            {/* BLACK PAWN: Joker Goon (Clown Mask & Laughing Gas Flask) */}\n            {type === \'p\' && (\n              <g strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                {/* Toxic Base */}\n                <path d=\"M 12 39.5 L 33 39.5 L 31 35 L 14 35 Z\" fill=\"#18181B\" stroke=\"#A855F7\" strokeWidth=\"1.2\" />\n                {/* Clown Masquerade Mask Torso */}\n                <path\n                  d=\"M 13 35 C 13 28 17 25 18 22 C 15 20 14 17 14 14 C 14 9 18 6 22.5 6 C 27 6 31 9 31 14 C 31 17 30 20 27 22 C 28 25 32 28 32 35 Z\"\n                  fill=\"url(#joker-purple)\"\n                  stroke=\"#18181B\"\n                  strokeWidth=\"1.5\"\n                />\n                {/* Neon Green Clown Hair Tuft */}\n                <path d=\"M 14 12 C 11 9 12 5 17 6 M 31 12 C 34 9 33 5 28 6\" stroke=\"url(#joker-toxic-green)\" strokeWidth=\"2.2\" />\n                {/* Menacing Joker Bared-Teeth Smile */}\n                <path d=\"M 17 16 C 19 21 26 21 28 16 Z\" fill=\"#DC2626\" stroke=\"#FEF08A\" strokeWidth=\"0.8\" />\n                <path d=\"M 18.5 17.5 L 26.5 17.5 M 20.5 16.5 L 20.5 18.5 M 22.5 16.5 L 22.5 19 M 24.5 16.5 L 24.5 18.5\" stroke=\"#FFFFFF\" strokeWidth=\"1\" />\n                {/* Red Clown Nose & Yellow Eyes */}\n                <circle cx=\"22.5\" cy=\"13.5\" r=\"1.5\" fill=\"#EF4444\" />\n                <circle cx=\"18\" cy=\"11.5\" r=\"1\" fill=\"#FACC15\" />\n                <circle cx=\"27\" cy=\"11.5\" r=\"1\" fill=\"#FACC15\" />\n                {/* Green Lapel Flower with Acid Droplet */}\n                <circle cx=\"22.5\" cy=\"27\" r=\"2.2\" fill=\"url(#joker-toxic-green)\" stroke=\"#18181B\" strokeWidth=\"0.8\" />\n              </g>\n            )}\n\n            {/* BLACK KNIGHT: Bane (Venom Tubes, Respirator Mask & Titan Traps) */}\n            {type === \'n\' && (\n              <g strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                {/* Base Platform */}\n                <path d=\"M 9 39 L 36 39 L 34 35 L 11 35 Z\" fill=\"#18181B\" stroke=\"#10B981\" strokeWidth=\"1.2\" />\n                {/* Massive Muscular Titan Silhouette */}\n                <path\n                  d=\"M 22 7 C 33 9 39 15 38 35 L 13 35 C 13 28 19 29 19 17 C 20 20 15 23 13 24 C 9 26 5 28 4 26 C 3 24 7 21 8 19 C 6 17 8 12 13 11 C 14 9 17 8 22 7 Z\"\n                  fill=\"url(#arkham-stone-dark)\"\n                  stroke=\"#10B981\"\n                  strokeWidth=\"1.5\"\n                />\n                {/* Venom Injector Tubes Running into Skull */}\n                <path d=\"M 22 9 C 27 12 32 18 31 28\" stroke=\"url(#bane-venom-glow)\" strokeWidth=\"2.6\" fill=\"none\" />\n                <path d=\"M 18 11 C 23 14 27 20 26 30\" stroke=\"url(#bane-venom-glow)\" strokeWidth=\"1.8\" fill=\"none\" />\n                {/* Bane Cybernetic Respirator / Muzzle Grille */}\n                <path d=\"M 5 26 L 14 23 L 16 28 L 7 30 Z\" fill=\"#334155\" stroke=\"#94A3B8\" strokeWidth=\"1\" />\n                <path d=\"M 7 26 L 13 25 M 7 28 L 13 27\" stroke=\"#10B981\" strokeWidth=\"1.2\" />\n                {/* Glowing Primal Green Eye */}\n                <circle cx=\"11.5\" cy=\"16\" r=\"1.3\" fill=\"#4ADE80\" stroke=\"#18181B\" strokeWidth=\"0.6\" />\n                {/* Venom Tank on Back */}\n                <rect x=\"27\" y=\"16\" width=\"7\" height=\"12\" rx=\"2\" fill=\"#047857\" stroke=\"#86EFAC\" strokeWidth=\"1\" />\n                <circle cx=\"30.5\" cy=\"22\" r=\"1.5\" fill=\"#86EFAC\" />\n              </g>\n            )}\n\n            {/* BLACK BISHOP: The Riddler & Two-Face (Question Mark Cane & Split Visage) */}\n            {type === \'b\' && (\n              <g strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                {/* Pedestal Base */}\n                <path d=\"M 10 39.5 L 35 39.5 L 33 36 L 12 36 Z\" fill=\"#18181B\" stroke=\"#22C55E\" strokeWidth=\"1.4\" />\n                {/* Half Purple / Half Green Suited Silhouette */}\n                <path\n                  d=\"M 14 36 C 13 30 15 26 17 24 C 16 22 13 19 13 15 C 13 10 18 6 22.5 5 C 27 6 32 10 32 15 C 32 19 29 22 28 24 C 30 26 32 30 31 36 Z\"\n                  fill=\"url(#joker-purple)\"\n                  stroke=\"#22C55E\"\n                  strokeWidth=\"1.5\"\n                />\n                {/* Left Split Lapel in Riddler Toxic Green */}\n                <path d=\"M 14 36 C 13 30 15 26 17 24 L 22.5 22 L 22.5 36 Z\" fill=\"url(#joker-toxic-green)\" />\n                {/* Large Golden Riddler Question Mark Cane */}\n                <path\n                  d=\"M 20 14 C 20 10 25 10 25 13 C 25 16 22.5 17 22.5 20 M 22.5 23 L 22.5 24.5\"\n                  stroke=\"#FACC15\"\n                  strokeWidth=\"2.4\"\n                  fill=\"none\"\n                />\n                {/* Two-Face Scarred Eye & Riddler Eye */}\n                <circle cx=\"18\" cy=\"14\" r=\"1.4\" fill=\"#EF4444\" />\n                <circle cx=\"27\" cy=\"14\" r=\"1.4\" fill=\"#4ADE80\" />\n                {/* Bowler Hat Finial */}\n                <circle cx=\"22.5\" cy=\"4\" r=\"2.2\" fill=\"#FACC15\" stroke=\"#18181B\" strokeWidth=\"1\" />\n              </g>\n            )}\n\n            {/* BLACK ROOK: Arkham Asylum (Fortified Gothic Asylum Gate & Gargoyles) */}\n            {type === \'r\' && (\n              <g strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                {/* Heavy Asylum Foundation */}\n                <path d=\"M 8 39.5 L 37 39.5 L 35 34 L 10 34 Z\" fill=\"#09090B\" stroke=\"#A855F7\" strokeWidth=\"1.4\" />\n                {/* Gothic Asylum Stone Spire */}\n                <path d=\"M 12 34 L 13 16 L 32 16 L 33 34 Z\" fill=\"url(#arkham-stone-dark)\" stroke=\"#A855F7\" strokeWidth=\"