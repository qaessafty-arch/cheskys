    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { GameMode, RespectProfile } from \'../types/chess\';\nimport {\n  Bot,\n  Users,\n  Sparkles,\n  Compass,\n  Settings,\n  Crown,\n  Plus,\n  Palette,\n  Trophy,\n  Shield,\n  User,\n  Globe,\n  Zap,\n  Sun,\n  Flame,\n  Menu,\n  X,\n  ChevronDown,\n  Layers,\n  Award\n} from \'lucide-react\';\nimport { useAuth } from \'../context/AuthContext\';\n\ninterface HeaderProps {\n  activeMode: GameMode;\n  onSelectMode: (mode: GameMode) => void;\n  onOpenSettings: () => void;\n  onOpenThemes?: () => void;\n  onOpenLeaderboard?: () => void;\n  onOpenProfile?: () => void;\n  onOpenFriends?: () => void;\n  onOpenWorldwideMatch?: () => void;\n  onNewGame: () => void;\n  respectProfile?: RespectProfile;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  activeMode,\n  onSelectMode,\n  onOpenSettings,\n  onOpenThemes,\n  onOpenLeaderboard,\n  onOpenProfile,\n  onOpenFriends,\n  onOpenWorldwideMatch,\n  onNewGame,\n  respectProfile\n}) => {\n  const { user, profile } = useAuth();\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);\n  const menuRef = useRef<HTMLDivElement>(null);\n\n  // Close mobile menu on click outside\n  useEffect(() => {\n    const handleClickOutside = (event: MouseEvent) => {\n      if (menuRef.current && !menuRef.current.contains(event.target as Node)) {\n        setIsMobileMenuOpen(false);\n      }\n    };\n    if (isMobileMenuOpen) {\n      document.addEventListener(\'mousedown\', handleClickOutside);\n    }\n    return () => {\n      document.removeEventListener(\'mousedown\', handleClickOutside);\n    };\n  }, [isMobileMenuOpen]);\n\n  const navItems: { mode: GameMode; label: string; shortLabel: string; icon: React.ReactNode; badge?: string }[] = [\n    { mode: \'ai\', label: \'Play AI\', shortLabel: \'AI\', icon: <Bot className=\"w-4 h-4\" /> },\n    { mode: \'daily_puzzle\', label: \'Daily Mission\', shortLabel: \'Daily\', icon: <Sun className=\"w-4 h-4 text-[#F5C453]\" />, badge: \'24h\' },\n    { mode: \'puzzle\', label: \'Tactics\', shortLabel: \'Tactics\', icon: <Sparkles className=\"w-4 h-4 text-amber-300\" /> },\n    { mode: \'pass_and_play\', label: \'Pass & Play\', shortLabel: \'P&P\', icon: <Users className=\"w-4 h-4\" /> },\n    { mode: \'analysis\', label: \'Analysis\', shortLabel: \'Analyze\', icon: <Compass className=\"w-4 h-4\" /> }\n  ];\n"
      replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { GameMode, RespectProfile } from \'../types/chess\';\nimport {\n  Bot,\n  Users,\n  Sparkles,\n  Compass,\n  Settings,\n  Crown,\n  Plus,\n  Palette,\n  Trophy,\n  Shield,\n  User,\n  Globe,\n  Zap,\n  Sun,\n  Flame,\n  Menu,\n  X,\n  ChevronDown,\n  Layers,\n  Award,\n  PenTool,\n  History,\n  Swords\n} from \'lucide-react\';\nimport { useAuth } from \'../context/AuthContext\';\n\ninterface HeaderProps {\n  activeMode: GameMode;\n  onSelectMode: (mode: GameMode) => void;\n  onOpenSettings: () => void;\n  onOpenThemes?: () => void;\n  onOpenLeaderboard?: () => void;\n  onOpenProfile?: () => void;\n  onOpenFriends?: () => void;\n  onOpenWorldwideMatch?: () => void;\n  onNewGame: () => void;\n  respectProfile?: RespectProfile;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  activeMode,\n  onSelectMode,\n  onOpenSettings,\n  onOpenThemes,\n  onOpenLeaderboard,\n  onOpenProfile,\n  onOpenFriends,\n  onOpenWorldwideMatch,\n  onNewGame,\n  respectProfile\n}) => {\n  const { user, profile } = useAuth();\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);\n  const menuRef = useRef<HTMLDivElement>(null);\n\n  // Close mobile menu on click outside\n  useEffect(() => {\n    const handleClickOutside = (event: MouseEvent) => {\n      if (menuRef.current && !menuRef.current.contains(event.target as Node)) {\n        setIsMobileMenuOpen(false);\n      }\n    };\n    if (isMobileMenuOpen) {\n      document.addEventListener(\'mousedown\', handleClickOutside);\n    }\n    return () => {\n      document.removeEventListener(\'mousedown\', handleClickOutside);\n    };\n  }, [isMobileMenuOpen]);\n\n  const navItems: { mode: GameMode; label: string; shortLabel: string; icon: React.ReactNode; badge?: string }[] = [\n    { mode: \'ai\', label: \'Play AI\', shortLabel: \'AI\', icon: <Bot className=\"w-4 h-4\" /> },\n    { mode: \'multiplayer\', label: \'Multiplayer\', shortLabel: \'PvP\', icon: <Swords className=\"w-4 h-4 text-emerald-400\" /> },\n    { mode: \'daily_puzzle\', label: \'Daily Mission\', shortLabel: \'Daily\', icon: <Sun className=\"w-4 h-4 text-[#F5C453]\" />, badge: \'24h\' },\n    { mode: \'puzzle\', label: \'Tactics\', shortLabel: \'Tactics\', icon: <Sparkles className=\"w-4 h-4 text-amber-300\" /> },\n    { mode: \'authoring\', label: \'Creator Studio\', shortLabel: \'Authoring\', icon: <PenTool className=\"w-4 h-4 text-[#F5C453]\" />, badge: \'NEW\' },\n    { mode: \'logging\', label: \'Battle Logs\', shortLabel: \'Logs\', icon: <History className=\"w-4 h-4 text-amber-300\" /> },\n    { mode: \'analysis\', label: \'Analysis\', shortLabel: \'Analyze\', icon: <Compass className=\"w-4 h-4\" /> },\n    { mode: \'pass_and_play\', label: \'Pass & Play\', shortLabel: \'P&P\', icon: <Users className=\"w-4 h-4\" /> }\n  ];\n"
