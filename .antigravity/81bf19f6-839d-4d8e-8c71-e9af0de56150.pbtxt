    onClick={user ? onOpenProfile : (onOpenLogin || onOpenProfile)}\n          className=\"min-w-[44px] min-h-[44px] p-1 rounded-2xl hover:bg-white/10 flex items-center gap-2.5 transition-all cursor-pointer border border-transparent hover:border-[#F5C453]/30\"\n          title={user ? `${userDisplayName} (Profile & Stats)` : \'Sign In / Profile\'}\n        >\n          {/* User Avatar Circle */}\n          <div className=\"relative\">\n            {profile?.photoURL || user?.photoURL ? (\n              <img\n                src={profile?.photoURL || user?.photoURL || \'\'}\n                alt={userDisplayName}\n                className=\"w-9 h-9 rounded-full object-cover border-2 border-[#F5C453] shadow-md\"\n                referrerPolicy=\"no-referrer\"\n              />\n            ) : (\n              <div className=\"w-9 h-9 rounded-full bg-gradient-to-br from-[#52673A] to-[#8C2425] border-2 border-[#F5C453] flex items-center justify-center font-bold text-xs text-white shadow-md\">\n                {user ? userDisplayName.charAt(0).toUpperCase() : <User className=\"w-4 h-4 text-white/80\" />}\n              </div>\n            )}\n            <span className=\"absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-emerald-500 border border-black\" />\n          </div>\n\n          {/* User Rating Display on Desktop */}\n          <div className=\"hidden sm:flex flex-col text-left leading-tight\">\n            <span className=\"text-xs font-black text-white truncate max-w-[100px]\">\n              {userDisplayName}\n            </span>\n            <span className=\"text-[10px] font-mono text-[#F5C453] font-bold\">\n              {currentElo} Elo\n            </span>\n          </div>\n        </button>\n      </div>\n    </header>"
