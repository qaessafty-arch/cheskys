    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { GameMode, RespectProfile } from \'../types/chess\';\nimport { Menu, X, User, Crown, Shield } from \'lucide-react\';\nimport { useAuth } from \'../context/AuthContext\';\n\ninterface HeaderProps {\n  onToggleSidebar: () => void;\n  isSidebarOpen?: boolean;\n  onOpenProfile: () => void;\n  onOpenLogin?: () => void;\n  respectProfile?: RespectProfile;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  onToggleSidebar,\n  isSidebarOpen = false,\n  onOpenProfile,\n  onOpenLogin,\n  respectProfile\n}) => {\n  const { user, profile } = useAuth();\n\n  const currentRespect = profile?.respectPoints ?? respectProfile?.respectPoints ?? 100;\n  const currentElo = profile?.elo ?? respectProfile?.elo ?? 1200;\n  const userDisplayName = profile?.displayName || user?.displayName?.split(\' \')[0] || (user ? \'Grandmaster\' : \'Guest\');\n\n  return (\n    <header\n      id=\"top-header-bar\"\n      className=\"w-full h-14 bg-[#10140e]/95 border-b border-[#F5C453]/25 backdrop-blur-2xl sticky top-0 z-30 shadow-xl shadow-black/50 transition-all flex items-center justify-between px-3 sm:px-6 select-none\"\n    >\n      {/* 1. Far Left: Hamburger Toggle Button */}\n      <div className=\"flex items-center gap-3\">\n        <button\n          id=\"header-hamburger-toggle\"\n          type=\"button\"\n          onClick={onToggleSidebar}\n          className=\"w-10 h-10 min-w-[44px] min-h-[44px] rounded-xl bg-white/5 hover:bg-white/10 active:scale-95 text-[#F5C453] hover:text-white flex items-center justify-center border border-[#F5C453]/30 transition-all cursor-pointer shadow-sm\"\n          aria-label={isSidebarOpen ? \'Close Navigation Menu\' : \'Open Navigation Menu\'}\n        >\n          {isSidebarOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n        </button>\n\n        {/* 2. Brand Logo: \"Chesskys\" with highlighted \"PRO\" badge */}\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-7 h-7 rounded-lg bg-gradient-to-br from-[#52673A] to-[#8C2425] border border-[#F5C453]/60 flex items-center justify-center text-sm shadow-md\">\n            \342\230\200\357\270\217\n          </div>\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"font-display font-black text-lg tracking-wide text-white drop-shadow-sm\">\n              Chesskys\n            </span>\n            <span className=\"text-[10px] font-black px-1.5 py-0.2 rounded-md bg-gradient-to-r from-amber-400 to-yellow-500 text-black shadow-sm uppercase tracking-wider\">\n              PRO\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* 3. Far Right: User Profile Avatar */}\n      <div className=\"flex items-center gap-2\">\n        <button\n          id=\"header-user-avatar-btn\"\n          type=\"button\"\n          onClick={user ? onOpenProfile : (onOpenLogin || onOpenProfile)}\n          className=\"min-w-[44px] min-h-[44px] p-1 rounded-2xl hover:bg-white/10 flex items-center gap-2.5 transition-all cursor-pointer border border-transparent hover:border-[#F5C453]/30\"\n          title={user ? `${userDisplayName} (Profile & Stats)` : \'Sign In / Profile\'}\n        >\n          {/* User Avatar Circle */}\n          <div className=\"relative\">\n            {profile?.photoURL || user?.photoURL ? (\n              <img\n                src={profile?.photoURL || user?.photoURL || \'\'}\n                alt={userDisplayName}\n                className=\"w-9 h-9 rounded-full object-cover border-2 border-[#F5C453] shadow-md\"\n                referrerPolicy=\"no-referrer\"\n              />\n            ) : (\n              <div className=\"w-9 h-9 rounded-full bg-gradient-to-br from-[#52673A] to-[#8C2425] border-2 border-[#F5C453] flex items-center justify-center font-bold text-xs text-white shadow-md\">\n                {user ? userDisplayName.charAt(0).toUpperCase() : <User className=\"w-4 h-4 text-white/80\" />}\n              </div>\n            )}\n            <span className=\"absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-emerald-500 border border-black\" />\n          </div>\n\n          {/* User Rating Display on Desktop */}\n          <div className=\"hidden sm:flex flex-col text-left leading-tight\">\n            <span className=\"text-xs font-black text-white truncate max-w-[100px]\">\n              {userDisplayName}\n            </span>\n            <span className=\"text-[10px] font-mono text-[#F5C453] font-bold\">\n              {currentElo} Elo\n            </span>\n          </div>\n        </button>\n      </div>\n    </header>\n  );\n};\n"
    }
