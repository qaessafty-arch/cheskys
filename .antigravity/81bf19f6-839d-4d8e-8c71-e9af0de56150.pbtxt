        replacement_content: "import React from \'react\';\nimport { PieceType, PieceColor, PieceThemeId } from \'../types/chess\';\nimport { BatmanPiece } from \'./pieces/BatmanPiece\';\n\ninterface ChessPieceProps {\n  type: PieceType;\n  color: PieceColor;\n  theme?: PieceThemeId;\n  className?: string;\n}\n\nexport const ChessPiece: React.FC<ChessPieceProps> = ({\n  type,\n  color,\n  theme = \'peshmerga\',\n  className = \'w-full h-full\'\n}) => {\n  const isWhite = color === \'w\';\n\n  // --- Theme: \360\237\246\207 Batman Gotham City (Heroes vs Villains) ---\n  if (theme === \'batman\') {\n    return <BatmanPiece type={type} color={color} className={className} />;\n  }\n\n  // --- Theme 1: \342\230\200\357\270\217 Peshmerga Royal (Kurdish) ---"
