        target_content: "            {/* Profile / Account Avatar Pill */}\n            <button\n              onClick={onOpenProfile}\n              className=\"flex items-center gap-1.5 py-1.5 px-2 sm:px-2.5 rounded-xl bg-white/[0.06] hover:bg-white/[0.12] border border-[#F5C453]/30 text-white transition-all shadow-sm cursor-pointer\"\n              title={user ? `Signed in as ${userDisplayName}` : \'Sign in / Profile Settings\'}\n            >\n              {(profile?.photoURL || user?.photoURL) ? (\n                <img\n                  src={profile?.photoURL || user?.photoURL}\n                  alt={userDisplayName}\n                  className=\"w-5 h-5 rounded-full object-cover border border-[#F5C453]\"\n                  referrerPolicy=\"no-referrer\"\n                />\n              ) : (\n                <User className=\"w-4 h-4 text-[#F5C453]\" />\n              )}\n              <span className=\"text-xs font-bold hidden xl:inline max-w-[80px] truncate text-[#DFD0B0]\">\n                {userDisplayName}\n              </span>\n            </button>"
        replacement_content: "            {/* Profile / Account Avatar Pill */}\n            <button\n              onClick={onOpenProfile}\n              className=\"flex items-center gap-1.5 py-1.5 px-2 sm:px-2.5 rounded-xl bg-white/[0.06] hover:bg-white/[0.12] border border-[#F5C453]/30 text-white transition-all shadow-sm cursor-pointer\"\n              title={user ? `Signed in as ${userDisplayName}` : \'Sign in / Profile Settings\'}\n            >\n              {(profile?.photoURL || user?.photoURL) ? (\n                <img\n                  src={profile?.photoURL || user?.photoURL}\n                  alt={userDisplayName}\n                  className=\"w-5 h-5 rounded-full object-cover border border-[#F5C453]\"\n                  referrerPolicy=\"no-referrer\"\n                />\n              ) : (\n                <User className=\"w-4 h-4 text-[#F5C453]\" />\n              )}\n              <span className=\"text-xs font-bold hidden xl:inline max-w-[80px] truncate text-[#DFD0B0]\">\n                {userDisplayName}\n              </span>\n            </button>\n\n            {/* Login / Switch Account Button */}\n            {onOpenLogin && (\n              <button\n                onClick={onOpenLogin}\n                className=\"hidden sm:flex items-center gap-1.5 py-1.5 px-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-[#F5C453] hover:text-white border border-[#F5C453]/30 hover:border-[#F5C453] text-xs font-bold transition-all shadow-sm cursor-pointer whitespace-nowrap\"\n                title=\"Open Login & Authentication Page\"\n              >\n                <LogIn className=\"w-3.5 h-3.5\" />\n                <span className=\"hidden lg:inline\">{user ? \'Switch Account\' : \'Sign In\'}</span>\n              </button>\n            )}"
      }
