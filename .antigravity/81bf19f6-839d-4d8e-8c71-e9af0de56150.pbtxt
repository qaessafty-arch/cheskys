    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { PieceType, PieceColor } from \'../../types/chess\';\n\ninterface BatmanPieceProps {\n  type: PieceType;\n  color: PieceColor;\n  className?: string;\n}\n\nexport const BatmanPiece: React.FC<BatmanPieceProps> = ({\n  type,\n  color,\n  className = \'w-full h-full\'\n}) => {\n  const isHero = color === \'w\'; // White = Bat-Family Heroes, Black = Arkham Villains\n\n  // Color schemes\n  // Heroes: Night Gotham Titanium / Midnight Charcoal & Neon Bat-Signal Yellow\n  const heroPrimary = \'#1E293B\';\n  const heroSecondary = \'#334155\';\n  const heroAccent = \'#EAB308\'; // Neon Yellow\n  const heroStroke = \'#FACC15\';\n\n  // Villains: Arkham Joker Purple & Acid Green\n  const villainPrimary = \'#3B0764\'; // Deep Joker Purple\n  const villainSecondary = \'#581C87\';\n  const villainAccent = \'#22C55E\'; // Acid Green / Neon Green\n  const villainStroke = \'#A855F7\';\n\n  const strokeColor = isHero ? heroStroke : \'#4ADE80\';\n  const fillColor = isHero ? `url(#hero-grad-${type})` : `url(#villain-grad-${type})`;\n\n  return (\n    <div className=\"relative w-full h-full flex items-center justify-center select-none pointer-events-none drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)]\">\n      <svg viewBox=\"0 0 45 45\" className={className} xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          {/* Hero Gradient */}\n          <linearGradient id={`hero-grad-${type}`} x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#334155\" />\n            <stop offset=\"100%\" stopColor=\"#0F172A\" />\n          </linearGradient>\n\n          {/* Villain Gradient */}\n          <linearGradient id={`villain-grad-${type}`} x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#581C87\" />\n            <stop offset=\"100%\" stopColor=\"#1E1B4B\" />\n          </linearGradient>\n\n          <filter id={`neon-glow-${color}`} x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n            <feDropShadow dx=\"0\" dy=\"0\" stdDeviation=\"1.5\" floodColor={isHero ? \'#EAB308\' : \'#22C55E\'} floodOpacity=\"0.8\" />\n          </filter>\n        </defs>\n\n        {/* ========================================================================= */}\n        {/* HEROES (WHITE) : BAT-FAMILY                                              */}\n        {/* ========================================================================= */}\n        {isHero && (\n          <g stroke={strokeColor} strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n            {/* KING: THE DARK KNIGHT (BATMAN) */}\n            {type === \'k\' && (\n              <g>\n                {/* Armored Base */}\n                <path d=\"M 9 39 L 36 39 C 34 33 30 29 27 27 L 18 27 C 15 29 11 33 9 39 Z\" fill={fillColor} />\n                {/* Bat-Suit Torso & Cape */}\n                <path d=\"M 18 27 L 15 17 L 22.5 20 L 30 17 L 27 27 Z\" fill={fillColor} />\n                {/* Cowl with Pointed Bat Ears */}\n                <path d=\"M 17 17 L 16 7 L 19.5 12 L 25.5 12 L 29 7 L 28 17 Z\" fill={fillColor} />\n                {/* Neon Bat-Signal Crest */}\n                <path\n                  d=\"M 22.5 24 C 20.5 24 19 25 18 26 C 19 27 21 28 22.5 28 C 24 28 26 27 27 26 C 26 25 24.5 24 22.5 24 Z\"\n                  fill={heroAccent}\n                  stroke=\"none\"\n                />\n                {/* Slit Eyes Glow */}\n                <polygon points=\"19.5,13.5 21,14.5 19.5,14.5\" fill=\"#FFFFFF\" stroke=\"none\" />\n                <polygon points=\"25.5,13.5 24,14.5 25.5,14.5\" fill=\"#FFFFFF\" stroke=\"none\" />\n              </g>\n            )}\n\n            {/* QUEEN: CATWOMAN (SELINA KYLE) */}\n            {type === \'q\' && (\n              <g>\n                {/* Sleek Base */}\n                <path d=\"M 11 39 L 34 39 C 33 33 29 29 26 27 L 19 27 C 16 29 12 33 11 39 Z\" fill={fillColor} />\n                {/* Cat Goggles Cowl */}\n                <path d=\"M 18 27 L 16 16 L 18 10 L 21 14 L 24 14 L 27 10 L 29 16 L 27 27 Z\" fill={fillColor} />\n                {/* Cat Ear Tips */}\n                <polygon points=\"18,10 16,5 20,9\" fill={heroAccent} />\n                <polygon points=\"27,10 29,5 25,9\" fill={heroAccent} />\n                {/* Night-Vision Cat Goggles */}\n                <ellipse cx=\"20\" cy=\"17\" rx=\"2.5\" ry=\"1.5\" fill=\"#FACC15\" stroke=\"none\" />\n                <ellipse cx=\"25\" cy=\"17\" rx=\"2.5\" ry=\"1.5\" fill=\"#FACC15\" stroke=\"none\" />\n                <circle cx=\"22.5\" cy=\"33\" r=\"2\" fill={heroAccent} stroke=\"none\" />\n              </g>\n            )}\n\n            {/* BISHOP: NIGHTWING / ROBIN */}\n            {type === \'b\' && (\n              <g>\n                {/* Base */}\n                <path d=\"M 12 39 L 33 39 C 31 33 28 29 25 27 L 20 27 C 17 29 14 33 12 39 Z\" fill={fillColor} />\n                {/* Domino Masked Head */}\n                <path d=\"M 19 27 C 17 22 17 15 22.5 10 C 28 15 28 22 26 27 Z\" fill={fillColor} />\n                {/* Domino Eye Mask */}\n                <path d=\"M 18 17 Q 22.5 19 27 17 Q 22.5 14 18 17 Z\" fill={heroAccent} stroke=\"none\" />\n                {/* Nightwing Wing Silhouette on chest */}\n                <path d=\"M 16 33 L 22.5 35 L 29 33 L 22.5 37 Z\" fill={heroAccent} stroke=\"none\" />\n              </g>\n            )}\n\n            {/* KNIGHT: BATMOBILE (TACTICAL TUMBLER) */}\n            {type === \'n\' && (\n              <g>\n                {/* Armored Wheel Base */}\n                <path d=\"M 10 39 L 35 39 L 37 32 L 8 32 Z\" fill={fillColor} />\n                {/* Batmobile Cockpit & Wings */}\n                <path d=\"M 12 32 L 14 18 L 22 12 L 31 16 L 35 25 L 34 32 Z\" fill={fillColor} />\n                {/* Rear Afterburner Fin */}\n                <polygon points=\"14,18 10,9 18,14\" fill={heroAccent} />\n                {/* High-Tech Turbine Headlight */}\n                <circle cx=\"31\" cy=\"23\" r=\"2.5\" fill=\"#FACC15\" stroke=\"none\" filter={`url(#neon-glow-${color})`} />\n                <line x1=\"16\" y1=\"35\" x2=\"29\" y2=\"35\" stroke={heroAccent} strokeWidth=\"2\" />\n              </g>\n            )}\n\n            {/* ROOK: WAYNE TOWER (FORTRESS OF GOTHAM) */}\n            {type === \'r\' && (\n              <g>\n                {/* Tower Bastion */}\n                <path d=\"M 11 39 L 34 39 L 32 17 L 13 17 Z\" fill={fillColor} />\n                {/* Wayne Tower Spire Battlements */}\n                <path d=\"M 11 17 L 11 10 L 15 10 L 15 13 L 20 13 L 20 8 L 25 8 L 25 13 L 30 13 L 30 10 L 34 10 L 34 17 Z\" fill={fillColor} />\n                {/* Illuminated \"W\" Crest */}\n                <path d=\"M 17 25 L 19 32 L 22.5 27 L 26 32 L 28 25\" stroke={heroAccent} strokeWidth=\"2\" fill=\"none\" />\n                <circle cx=\"22.5\" cy=\"11\" r=\"1.5\" fill={heroAccent} stroke=\"none\" />\n              </g>\n            )}\n\n            {/* PAWN: GCPD DETECTIVES & OFFICERS */}\n            {type === \'p\' && (\n              <g>\n                {/* Officer Coat Base */}\n                <path d=\"M 13 39 L 32 39 C 30 33 27 28 25 25 L 20 25 C 18 28 15 33 13 39 Z\" fill={fillColor} />\n                {/* GCPD Cap */}\n                <circle cx=\"22.5\" cy=\"17\" r=\"5\" fill={fillColor} />\n                <path d=\"M 16 16 L 29 16 L 27 13 L 18 13 Z\" fill={heroSecondary} />\n                {/* Gold Police Shield Badge */}\n                <polygon points=\"22.5,27 25,30 22.5,34 20,30\" fill={heroAccent} stroke=\"none\" />\n              </g>\n            )}\n          </g>\n        )}\n\n        {/* ========================================================================= */}\n        {/* VILLAINS (BLACK) : ARKHAM ROGUES                                         */}\n        {/* ========================================================================= */}\n        {!isHero && (\n          <g stroke={strokeColor} strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n            {/* KING: THE JOKER (CLOWN PRINCE OF CRIME) */}\n            {type === \'k\' && (\n              <g>\n                {/* Tailcoat Suit Base */}\n                <path d=\"M 9 39 L 36 39 C 34 33 30 29 27 27 L 18 27 C 15 29 11 33 9 39 Z\" fill={fillColor} />\n                {/* Acid Green Vest & Bowtie */}\n                <path d=\"M 18 27 L 22.5 35 L 27 27 Z\" fill={villainAccent} stroke=\"none\" />\n                {/* Wild Spiky Green Hair & Face */}\n                <path d=\"M 16 18 L 14 9 L 19 12 L 22.5 6 L 26 12 L 31 9 L 29 18 Z\" fill=\"#15803D\" />\n                {/* Maniacal Grin */}\n                <path d=\"M 17 21 Q 22.5 28 28 21\" stroke=\"#EF4444\" strokeWidth=\"2\" fill=\"none\" />\n                <circle cx=\"19\" cy=\"16\" r=\"1.5\" fill=\"#FFFFFF\" stroke=\"none\" />\n                <circle cx=\"26\" cy=\"16\" r=\"1.5\" fill=\"#FFFFFF\" stroke=\"none\" />\n              </g>\n            )}\n\n            {/* QUEEN: HARLEY QUINN */}\n            {type === \'q\' && (\n              <g>\n                {/* Jester Diamond Suit */}\n                <path d=\"M 11 39 L 34 39 C 33 33 29 29 26 27 L 19 27 C 16 29 12 33 11 39 Z\" fill={fillColor} />\n                {/* Dual Pigtails / Jester Horns */}\n                <path d=\"M 18 26 L 15 15 C 12 11 9 13 8 18 C 11 18 14 18 16 20 Z\" fill=\"#EF4444\" />\n                <path d=\"M 27 26 L 30 15 C 33 11 36 13 37 18 C 34 18 31 18 29 20 Z\" fill=\"#3B82F6\" />\n                {/* Jester Center Head */}\n                <circle cx=\"22.5\" cy=\"18\" r=\"4.5\" fill={fillColor} />\n                {/* Diamond Crests */}\n                <polygon points=\"22.5,30 24.5,33 22.5,36 20.5,33\" fill=\"#EF4444\" stroke=\"none\" />\n                <polygon points=\"16,33 17.5,35 16,37 14.5,35\" fill=\"#3B82F6\" stroke=\"none\" />\n              </g>\n            )}\n\n            {/* BISHOP: THE RIDDLER / TWO-FACE */}\n            {type === \'b\' && (\n              <g>\n                {/* Bowler Hat Base */}\n                <path d=\"M 12 39 L 33 39 C 31 33 28 29 25 27 L 20 27 C 17 29 14 33 12 39 Z\" fill={fillColor} />\n                {/* Bowler Hat */}\n                <ellipse cx=\"22.5\" cy=\"18\" rx=\"8\" ry=\"3\" fill=\"#15803D\" />\n                <path d=\"M 17 18 C 17 11 28 11 28 18 Z\" fill=\"#16A34A\" />\n                {/* Glowing Question Mark \"?\" */}\n                <text\n                  x=\"22.5\"\n                  y=\"35\"\n                  fontSize=\"12\"\n                  fontWeight=\"900\"\n                  fontFamily=\"sans-serif\"\n                  textAnchor=\"middle\"\n                  fill={villainAccent}\n                  stroke=\"none\"\n                >\n                  ?\n                </text>\n              </g>\n            )}\n\n            {/* KNIGHT: BANE (VENOM JUGGERNAUT) */}\n            {type === \'n\' && (\n              <g>\n                {/* Massive Muscular Armor Base */}\n                <path d=\"M 10 39 L 35 39 C 34 31 30 26 27 24 L 18 24 C 15 26 11 31 10 39 Z\" fill={fillColor} />\n                {/* Bane Venom Mask & Head */}\n                <path d=\"M 16 24 C 15 15 18 9 22.5 9 C 27 9 30 15 29 24 Z\" fill={fillColor} />\n                {/* Venom Respiratory Tube Lines */}\n                <path d=\"M 17 20 Q 22.5 24 28 20\" stroke={villainAccent} strokeWidth=\"2.5\" fill=\"none\" />\n                <line x1=\"22.5\" y1=\"18\" x2=\"22.5\" y2=\"24\" stroke={villainAccent} strokeWidth=\"2\" />\n                {/* Green Glowing Venom Tanks */}\n                <circle cx=\"15\" cy=\"32\" r=\"2.5\" fill={villainAccent} stroke=\"none\" filter={`url(#neon-glow-${color})`} />\n                <circle cx=\"30\" cy=\"32\" r=\"2.5\" fill={villainAccent} stroke=\"none\" filter={`url(#neon-glow-${color})`} />\n              </g>\n            )}\n\n            {/* ROOK: ARKHAM ASYLUM (GOTHIC FORTRESS GATES) */}\n            {type === \'r\' && (\n              <g>\n                {/* Gothic Stone Wall */}\n                <path d=\"M 11 39 L 34 39 L 32 17 L 13 17 Z\" fill={fillColor} />\n                {/* Asylum Spikes & Barbed Turrets */}\n                <path d=\"M 11 17 L 10 8 L 14 13 L 18 7 L 22.5 13 L 27 7 L 31 13 L 35 8 L 34 17 Z\" fill={fillColor} />\n                {/* Iron Asylum Gate Bars */}\n                <line x1=\"17\" y1=\"24\" x2=\"17\" y2=\"36\" stroke={villainAccent} strokeWidth=\"1.5\" />\n                <line x1=\"22.5\" y1=\"22\" x2=\"22.5\" y2=\"36\" stroke={villainAccent} strokeWidth=\"1.5\" />\n                <line x1=\"28\" y1=\"24\" x2=\"28\" y2=\"36\" stroke={villainAccent} strokeWidth=\"1.5\" />\n                <circle cx=\"22.5\" cy=\"17\" r=\"2\" fill=\"#EF4444\" stroke=\"none\" />\n              </g>\n            )}\n\n            {/* PAWN: JOKER GOONS & ARKHAM INMATES */}\n            {type === \'p\' && (\n              <g>\n                {/* Inmate Uniform Base */}\n                <path d=\"M 13 39 L 32 39 C 30 33 27 28 25 25 L 20 25 C 18 28 15 33 13 39 Z\" fill={fillColor} />\n                {/* Striped Prisoner / Henchman Shirt */}\n                <line x1=\"16\" y1=\"34\" x2=\"29\" y2=\"34\" stroke={villainAccent} strokeWidth=\"2\" />\n                <line x1=\"18\" y1=\"30\" x2=\"27\" y2=\"30\" stroke=\"#FFFFFF\" strokeWidth=\"1.5\" />\n                {/* Clown Mask Head */}\n                <circle cx=\"22.5\" cy=\"17\" r=\"5\" fill={fillColor} />\n                {/* Red Clown Nose */}\n                <circle cx=\"22.5\" cy=\"17\" r=\"1.5\" fill=\"#EF4444\" stroke=\"none\" />\n              </g>\n            )}\n          </g>\n        )}\n      </svg>\n    </div>\n  );\n};\n"
    }
