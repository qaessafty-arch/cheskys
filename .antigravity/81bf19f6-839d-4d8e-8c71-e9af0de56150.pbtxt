        }
        lines {
          text: "  const rafRef = useRef<number | null>(null);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const theme = THEME_STYLES[boardTheme] || THEME_STYLES.emerald;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const isAotBoard = boardTheme === \'aot\' || boardTheme === \'wall-maria\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const isBatmanBoard = boardTheme === \'batman\' || boardTheme === \'gotham-city\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // Board ranks and files"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const files = useMemo(() => [\'a\', \'b\', \'c\', \'d\', \'e\', \'f\', \'g\', \'h\'], []);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const ranks = useMemo(() => [\'8\', \'7\', \'6\', \'5\', \'4\', \'3\', \'2\', \'1\'], []);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const displayFiles = useMemo(() => isFlipped ? [...files].reverse() : files, [isFlipped, files]);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const displayRanks = useMemo(() => isFlipped ? [...ranks].reverse() : ranks, [isFlipped, ranks]);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // Find king square in check"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const kingInCheckSquare = useMemo(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (!game.inCheck()) return null;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const turn = game.turn();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const boardState = game.board();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    for (let r = 0; r < 8; r++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      for (let f = 0; f < 8; f++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const piece = boardState[r][f];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        if (piece && piece.type === \'k\' && piece.color === turn) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          const fileStr = String.fromCharCode(\'a\'.charCodeAt(0) + f);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          const rankStr = (8 - r).toString();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          return (fileStr + rankStr) as Square;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
