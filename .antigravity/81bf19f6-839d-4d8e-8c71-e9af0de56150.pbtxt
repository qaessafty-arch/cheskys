    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { getLocalGameLogs } from \'../services/loggingService\';\nimport { \n  Trophy, \n  Swords, \n  Flame, \n  Zap, \n  Clock, \n  Sun, \n  Puzzle, \n  UserPlus, \n  Check, \n  TrendingUp, \n  Sparkles, \n  ShieldCheck, \n  Activity, \n  Award, \n  Calendar, \n  BarChart2, \n  PieChart, \n  Layers, \n  Crown, \n  Share2, \n  CheckCircle2, \n  Target,\n  Users,\n  History,\n  Compass,\n  ArrowUpRight,\n  ArrowDownRight,\n  Minus,\n  Search,\n  Filter,\n  CheckCircle,\n  ExternalLink,\n  ChevronRight,\n  Shield,\n  Camera,\n  Play\n} from \'lucide-react\';\nimport { ChessAvatarModal } from \'./ChessAvatarModal\';\n\ninterface UserProfilePageProps {\n  onChallenge?: () => void;\n  onAnalyzeGame?: (pgn?: string, fen?: string) => void;\n  onEditProfileModal?: () => void;\n  onNavigateHome?: () => void;\n}\n\ntype TabType = \'overview\' | \'matches\' | \'analytics\' | \'social\';\ntype TimeRangeFilter = \'1W\' | \'1M\' | \'1Y\' | \'ALL\';\ntype MatchFilter = \'all\' | \'win\' | \'loss\' | \'draw\';\n\ninterface MatchItem {\n  id: string;\n  opponentName: string;\n  opponentAvatar: string;\n  opponentRating: number;\n  result: \'win\' | \'loss\' | \'draw\';\n  ratingChange: number;\n  accuracy: number;\n  timeControl: string;\n  playerColor: \'w\' | \'b\';\n  date: string;\n  openingName: string;\n  pgn?: string;\n  fen?: string;\n}\n\nexport const UserProfilePage: React.FC<UserProfilePageProps> = ({\n  onChallenge,\n  onAnalyzeGame,\n  onEditProfileModal,\n  onNavigateHome\n}) => {\n  const { user, profile, isSkyAccount, isOwner } = useAuth();\n\n  // Tab State\n  const [activeTab, setActiveTab] = useState<TabType>(\'overview\');\n\n  // Profile Customization & Social States\n  const [onlineStatus, setOnlineStatus] = useState<\'online\' | \'in_game\' | \'offline\'>(\'online\');\n  const [friendStatus, setFriendStatus] = useState<\'add\' | \'sent\' | \'friends\'>(\'add\');\n  const [copiedLink, setCopiedLink] = useState(false);\n  const [isAvatarModalOpen, setIsAvatarModalOpen] = useState(false);\n\n  // Analytics & History Filters\n  const [timeRange, setTimeRange] = useState<TimeRangeFilter>(\'1M\');\n  const [matchFilter, setMatchFilter] = useState<MatchFilter>(\'all\');\n  const [searchOpponent, setSearchOpponent] = useState(\'\');\n  const [hoveredPoint, setHoveredPoint] = useState<{ index: number; x: number; y: number; data: any } | null>(null);\n\n  // Dynamic User Information\n  const displayName = profile?.displayName || user?.displayName || \'Grandmaster Qays\';\n  const username = profile?.username || \'peshmerga_gm\';\n  const countryFlag = profile?.flag || \'\342\230\200\357\270\217\';\n  const countryName = profile?.country || \'Kurdistan\';\n  const avatarUrl = profile?.photoURL || (isSkyAccount \n    ? \'https://images.unsplash.com/photo-1557925923-cd4648e211a0?w=200&auto=format&fit=crop&q=80\' \n    : user?.photoURL || \'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=200&auto=format&fit=crop&q=80\');\n\n  const baseElo = typeof profile?.elo === \'number\' ? profile.elo : 2240;\n\n  // Time Control Rating Metrics\n  const ratingsData = useMemo(() => {\n    return {\n      rapid: {\n        title: \'Rapid (Primary)\',\n        time: \'10-15 min\',\n        current: baseElo,\n        peak: baseElo + 55,\n        games: profile?.gamesPlayed || 512,\n        winRate: 72,\n        icon: <Clock className=\"w-4 h-4 text-emerald-400\" />,\n        badgeBg: \'bg-emerald-500/10 text-emerald-300 border-emerald-500/20\'\n      },\n      blitz: {\n        title: \'Blitz\',\n        time: \'3-5 min\',\n        current: Math.max(1600, Math.round(baseElo * 0.96)),\n        peak: Math.max(1700, Math.round(baseElo * 1.01)),\n        games: 389,\n        winRate: 68,\n        icon: <Flame className=\"w-4 h-4 text-orange-400\" />,\n        badgeBg: \'bg-orange-500/10 text-orange-300 border-orange-500/20\'\n      },\n      bullet: {\n        title: \'Bullet\',\n        time: \'1-2 min\',\n        current: Math.max(1400, Math.round(baseElo * 0.88)),\n        peak: Math.max(1500, Math.round(baseElo * 0.92)),\n        games: 142,\n        winRate: 64,\n        icon: <Zap className=\"w-4 h-4 text-amber-400\" />,\n        badgeBg: \'bg-amber-500/10 text-amber-300 border-amber-500/20\'\n      },\n      daily: {\n        title: \'Daily\',\n        time: \'1-3 days\',\n        current: Math.max(1800, baseElo + 70),\n        peak: baseElo + 110,\n        games: 76,\n        winRate: 79,\n        icon: <Sun className=\"w-4 h-4 text-sky-400\" />,\n        badgeBg: \'bg-sky-500/10 text-sky-300 border-sky-500/20\'\n      },\n      puzzles: {\n        title: \'Puzzles\',\n        time: \'Tactics\',\n        current: Math.max(2100, baseElo + 240),\n        peak: baseElo + 270,\n        games: 840,\n        winRate: 88,\n        icon: <Puzzle className=\"w-4 h-4 text-purple-400\" />,\n        badgeBg: \'bg-purple-500/10 text-purple-300 border-purple-500/20\'\n      }\n    };\n  }, [baseElo, profile?.gamesPlayed]);\n\n  // Generate Interactive Rating Chart Data\n  const chartData = useMemo(() => {\n    const pointsCount = timeRange === \'1W\' ? 7 : timeRange === \'1M\' ? 30 : timeRange === \'1Y\' ? 52 : 70;\n    const now = new Date();\n    const data = [];\n    let currentRating = baseElo - (pointsCount * 2);\n\n    for (let i = 0; i < pointsCount; i++) {\n      const d = new Date();\n      if (timeRange === \'1W\') d.setDate(now.getDate() - (pointsCount - 1 - i));\n      else if (timeRange === \'1M\') d.setDate(now.getDate() - (pointsCount - 1 - i));\n      else if (timeRange === \'1Y\') d.setDate(now.getDate() - (pointsCount - 1 - i) * 7);\n      else d.setDate(now.getDate() - (pointsCount - 1 - i) * 15);\n\n      const fluctuation = Math.floor(Math.sin(i * 0.4) * 18) + (i > pointsCount - 5 ? 8 : (i % 3 === 0 ? 6 : -3));\n      currentRating += fluctuation;\n      if (i === pointsCount - 1) currentRating = baseElo;\n\n      data.push({\n        date: d.toLocaleDateString(\'en-US\', { month: \'short\', day: \'numeric\' }),\n        fullDate: d.toLocaleDateString(\'en-US\', { weekday: \'short\', month: \'short\', day: \'numeric\', year: \'numeric\' }),\n        rating: Math.max(1200, currentRating),\n        change: fluctuation >= 0 ? `+${fluctuation}` : `${fluctuation}`,\n        opponent: i % 2 === 0 ? \'GM SoranTactics\' : \'Citadel_Master\'\n      });\n    }\n    return data;\n  }, [timeRange, baseElo]);\n\n  // Chart SVG Coordinates Math\n  const minRating = Math.min(...chartData.map(d => d.rating)) - 25;\n  const maxRating = Math.max(...chartData.map(d => d.rating)) + 25;\n  const chartWidth = 700;\n  const chartHeight = 220;\n  const paddingX = 35;\n  const paddingY = 25;\n\n  const points = chartData.map((d, i) => {\n    const x = paddingX + (i / (chartData.length - 1)) * (chartWidth - paddingX * 2);\n    const y = chartHeight - paddingY - ((d.rating - minRating) / (maxRating - minRating)) * (chartHeight - paddingY * 2);\n    return { x, y, data: d };\n  });\n\n  const pathD = points.reduce((acc, point, i, arr) => {\n    if (i === 0) return `M ${point.x} ${point.y}`;\n    const prev = arr[i - 1];\n    const cpX1 = prev.x + (point.x - prev.x) / 2;\n    const cpY1 = prev.y;\n    const cpX2 = prev.x + (point.x - prev.x) / 2;\n    const cpY2 = point.y;\n    return `${acc} C ${cpX1} ${cpY1}, ${cpX2} ${cpY2}, ${point.x} ${point.y}`;\n  }, \'\');\n\n  const areaD = `${pathD} L ${points[points.length - 1].x} ${chartHeight - paddingY} L ${points[0].x} ${chartHeight - paddingY} Z`;\n\n  // Recent 10 Match History List\n  const allMatches: MatchItem[] = useMemo(() => {\n    const rawLogs = getLocalGameLogs();\n    const formattedFromLogs: MatchItem[] = rawLogs.slice(0, 10).map((l, idx) => ({\n      id: l.id || `log-${idx}`,\n      opponentName: l.opponentName || \'Peshmerga Tactician\',\n      opponentAvatar: l.opponentAvatar || \'\342\231\232\',\n      opponentRating: l.opponentElo || 1850,\n      result: l.result === \'win\' || l.result === \'executed\' ? \'win\' : l.result === \'draw\' ? \'draw\' : \'loss\',\n      ratingChange: l.eloChange || (l.result === \'win\' ? 12 : l.result === \'draw\' ? 0 : -9),\n      accuracy: l.accuracy || Math.round(75 + (Math.random() * 20)),\n      timeControl: l.timeControlName || \'Rapid (10m)\',\n      playerColor: l.playerColor || \'w\',\n      date: l.date ? new Date(l.date).toLocaleDateString(\'en-US\', { month: \'short\', day: \'numeric\' }) : \'Today\',\n      openingName: \'Sicilian Defense: Najdorf\',\n      pgn: l.pgn,\n      fen: l.finalFen\n    }));\n\n    const fallbackMatches: MatchItem[] = [\n      {\n        id: \'m-1\',\n        opponentName: \'GM Alan Kurdistan\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2280,\n        result: \'win\',\n        ratingChange: 14,\n        accuracy: 94.2,\n        timeControl: \'Rapid (10m)\',\n        playerColor: \'w\',\n        date: \'Aug 29\',\n        openingName: \"Queen\'s Gambit Accepted\",\n        fen: \'r1bqk2r/pp2bppp/2n1pn2/8/3P4/2N2N2/PP2BPPP/R1BQ1RK1 w kq - 0 10\'\n      },\n      {\n        id: \'m-2\',\n        opponentName: \'Citadel Sentinel \360\237\233\241\357\270\217\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2195,\n        result: \'win\',\n        ratingChange: 10,\n        accuracy: 89.6,\n        timeControl: \'Blitz (3m)\',\n        playerColor: \'b\',\n        date: \'Aug 28\',\n        openingName: \'King\342\200\231s Indian Defense\',\n        fen: \'rnbq1rk1/ppp1ppbp/3p1np1/8/2PPP3/2N2N2/PP2BPPP/R1BQK2R b KQ - 0 6\'\n      },\n      {\n        id: \'m-3\',\n        opponentName: \'Erbil Grandmaster\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2310,\n        result: \'loss\',\n        ratingChange: -11,\n        accuracy: 78.4,\n        timeControl: \'Rapid (15m)\',\n        playerColor: \'w\',\n        date: \'Aug 28\',\n        openingName: \'Ruy Lopez: Berlin Defense\',\n        fen: \'r1bqkb1r/pppp1ppp/2n5/4p3/1bB1P3/5N2/PPPP1PPP/RNBQK2R w KQkq - 0 4\'\n      },\n      {\n        id: \'m-4\',\n        opponentName: \'Zagros Mountain Wolf\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2150,\n        result: \'win\',\n        ratingChange: 9,\n        accuracy: 92.1,\n        timeControl: \'Bullet (1m)\',\n        playerColor: \'b\',\n        date: \'Aug 27\',\n        openingName: \'Sicilian: Dragon Variation\',\n        fen: \'r1bqk2r/pp2ppbp/2np1np1/8/3NP3/2N1BP2/PPP3PP/R2QKB1R w KQkq - 0 8\'\n      },\n      {\n        id: \'m-5\',\n        opponentName: \'Stockfish Neural Bot\',\n        opponentAvatar: \'\360\237\244\226\',\n        opponentRating: 2200,\n        result: \'draw\',\n        ratingChange: 0,\n        accuracy: 96.8,\n        timeControl: \'Daily (24h)\',\n        playerColor: \'w\',\n        date: \'Aug 26\',\n        openingName: \'Catalan Opening: Closed\',\n        fen: \'r1bq1rk1/pp1nbppp/2p1pn2/8/2PP4/5NP1/PP2NPBP/R1BQ1RK1 b - - 0 9\'\n      },\n      {\n        id: \'m-6\',\n        opponentName: \'SoranTactics\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2090,\n        result: \'win\',\n        ratingChange: 8,\n        accuracy: 86.4,\n        timeControl: \'Blitz (5m)\',\n        playerColor: \'w\',\n        date: \'Aug 25\',\n        openingName: \'French Defense: Winawer\',\n        fen: \'r1bqk1nr/pp3ppp/2n1p3/2bpP3/8/2PB1N2/PP3PPP/RNBQK2R b KQkq - 0 7\'\n      },\n      {\n        id: \'m-7\',\n        opponentName: \'Duhok Knight \360\237\217\260\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2185,\n        result: \'win\',\n        ratingChange: 11,\n        accuracy: 91.0,\n        timeControl: \'Rapid (10m)\',\n        playerColor: \'b\',\n        date: \'Aug 24\',\n        openingName: \'Caro-Kann: Classical\',\n        fen: \'r2qkbnr/pp1n1ppp/2p1p3/5b2/3PN3/5N2/PPP1BPPP/R1BQK2R w KQkq - 0 7\'\n      },\n      {\n        id: \'m-8\',\n        opponentName: \'Sulaymaniyah Master\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2260,\n        result: \'loss\',\n        ratingChange: -12,\n        accuracy: 74.5,\n        timeControl: \'Blitz (3m)\',\n        playerColor: \'w\',\n        date: \'Aug 23\',\n        openingName: \'English Opening: Four Knights\',\n        fen: \'r1bqkb1r/pppp1ppp/2n2n2/4p3/2P5/2N2N2/PP1PPPPP/R1BQKB1R w KQkq - 0 4\'\n      },\n      {\n        id: \'m-9\',\n        opponentName: \'Vanguard Ranger \342\232\224\357\270\217\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2040,\n        result: \'win\',\n        ratingChange: 7,\n        accuracy: 88.2,\n        timeControl: \'Bullet (2m)\',\n        playerColor: \'b\',\n        date: \'Aug 22\',\n        openingName: \'Modern Defense\',\n        fen: \'rnbqk1nr/ppp1ppbp/3p2p1/8/2PPP3/8/PP3PPP/RNBQKBNR w KQkq - 0 4\'\n      },\n      {\n        id: \'m-10\',\n        opponentName: \'Peshmerga Colonel\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2215,\n        result: \'win\',\n        ratingChange: 13,\n        accuracy: 95.3,\n        timeControl: \'Rapid (10m)\',\n        playerColor: \'w\',\n        date: \'Aug 21\',\n        openingName: \'Nimzo-Indian Defense\',\n        fen: \'r1bqk2r/pppp1ppp/2n1pn2/8/1bPP4/2N1PN2/PP3PPP/R1BQKB1R b KQkq - 0 5\'\n      }\n    ];\n\n    return [...formattedFromLogs, ...fallbackMatches].slice(0, 10);\n  }, []);\n\n  // Filtered Matches\n  const filteredMatches = useMemo(() => {\n    return allMatches.filter(m => {\n      if (matchFilter !== \'all\' && m.result !== matchFilter) return false;\n      if (searchOpponent.trim()) {\n        const query = searchOpponent.toLowerCase();\n        return m.opponentName.toLowerCase().includes(query) || m.openingName.toLowerCase().includes(query);\n      }\n      return true;\n    });\n  }, [allMatches, matchFilter, searchOpponent]);\n\n  // Achievement Badges\n  const achievementBadges = [\n    {\n      id: \'first_tourney\',\n      name: \'First Tournament Win\',\n      desc: \'Finished 1st place in the Erbil Citadel Open Arena\',\n      icon: \'\360\237\217\206\',\n      rarity: \'Legendary\',\n      unlocked: true,\n      color: \'from-amber-500/20 to-yellow-500/10 border-amber-400/40 text-amber-300\'\n    },\n    {\n      id: \'puzzles_100\',\n      name: \'100 Puzzles Solved\',\n      desc: \'Solved over 100 tactical puzzles with precision\',\n      icon: \'\360\237\247\251\',\n      rarity: \'Epic\',\n      unlocked: true,\n      color: \'from-sky-500/20 to-blue-500/10 border-sky-400/40 text-sky-300\'\n    },\n    {\n      id: \'citadel_gm\',\n      name: \'Citadel Grandmaster\',\n      desc: \'Attained supreme 2200+ Elo rating across all modes\',\n      icon: \'\360\237\221\221\',\n      rarity: \'Mythic\',\n      unlocked: true,\n      color: \'from-purple-500/20 to-pink-500/10 border-purple-400/40 text-purple-300\'\n    },\n    {\n      id: \'lightning_tac\',\n      name: \'Lightning Tactician\',\n      desc: \'Won 20 consecutive Bullet & Blitz matches under 3 minutes\',\n      icon: \'\342\232\241\',\n      rarity: \'Rare\',\n      unlocked: true,\n      color: \'from-amber-400/20 to-orange-500/10 border-amber-300/40 text-amber-200\'\n    },\n    {\n      id: \'peshmerga_sun\',\n      name: \'Peshmerga Sun of Glory\',\n      desc: \'Awarded to defenders demonstrating supreme honor & respect\',\n      icon: \'\342\230\200\357\270\217\',\n      rarity: \'National Legend\',\n      unlocked: true,\n      color: \'from-emerald-500/20 to-amber-500/10 border-[#F5C453]/50 text-[#F5C453]\'\n    },\n    {\n      id: \'streak_10\',\n      name: \'Undefeated 10-Streak\',\n      desc: \'Maintained an unbroken 10-game win streak in rated rapid play\',\n      icon: \'\360\237\224\245\',\n      rarity: \'Epic\',\n      unlocked: true,\n      color: \'from-rose-500/20 to-orange-500/10 border-rose-400/40 text-rose-300\'\n    },\n    {\n      id: \'endgame_wiz\',\n      name: \'Endgame Wizard\',\n      desc: \'Converted 50 pawn endgames with zero blunders\',\n      icon: \'\360\237\233\241\357\270\217\',\n      rarity: \'Rare\',\n      unlocked: true,\n      color: \'from-indigo-500/20 to-cyan-500/10 border-indigo-400/40 text-indigo-300\'\n    },\n    {\n      id: \'accuracy_95\',\n      name: \'95%+ Accuracy Master\',\n      desc: \'Played a 35+ move victory with engine accuracy above 95%\',\n      icon: \'\360\237\216\257\',\n      rarity: \'Legendary\',\n      unlocked: true,\n      color: \'from-emerald-500/20 to-teal-500/10 border-emerald-400/40 text-emerald-300\'\n    }\n  ];\n\n  // Friends mock list\n  const friendsList = [\n    { id: \'f-1\', name: \'GM Alan Kurdistan\', rating: 2280, status: \'online\', flag: \'\342\230\200\357\270\217\', avatar: \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80\' },\n    { id: \'f-2\', name: \'Citadel Sentinel\', rating: 2195, status: \'in_game\', flag: \'\360\237\233\241\357\270\217\', avatar: \'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&auto=format&fit=crop&q=80\' },\n    { id: \'f-3\', name: \'SoranTactics\', rating: 2090, status: \'offline\', flag: \'\342\230\200\357\270\217\', avatar: \'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&auto=format&fit=crop&q=80\' },\n    { id: \'f-4\', name: \'Duhok Knight\', rating: 2185, status: \'online\', flag: \'\360\237\217\260\', avatar: \'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=100&auto=format&fit=crop&q=80\' }\n  ];\n\n  const handleShareProfile = () => {\n    navigator.clipboard.writeText(window.location.href);\n    setCopiedLink(true);\n    setTimeout(() => setCopiedLink(false), 3000);\n  };\n\n  const handleAddFriendClick = () => {\n    if (friendStatus === \'add\') {\n      setFriendStatus(\'sent\');\n      setTimeout(() => setFriendStatus(\'friends\'), 1000);\n    } else if (friendStatus === \'friends\') {\n      setFriendStatus(\'add\');\n    }\n  };\n\n  return (\n    <div className=\"w-full max-w-7xl mx-auto space-y-6 text-slate-100 font-ui pb-16\">\n      {/* ========================================================================= */}\n      {/* 1. TOP PROFILE HERO CARD                                                  */}\n      {/* ========================================================================= */}\n      <div className=\"relative rounded-3xl bg-slate-900/90 backdrop-blur-xl border border-slate-800 p-6 sm:p-7 shadow-xl overflow-hidden\">\n        {/* Top Kurdish National Accent Bar */}\n        <div className=\"absolute top-0 left-0 h-1.5 w-full bg-gradient-to-r from-[#8C2425] via-[#52673A] to-[#F5C453]\" />\n\n        <div className=\"flex flex-col md:flex-row items-center md:items-start justify-between gap-6 relative z-10\">\n          {/* Avatar & User Details */}\n          <div className=\"flex flex-col sm:flex-row items-center sm:items-start gap-5 text-center sm:text-left\">\n            {/* Avatar */}\n            <div className=\"relative group shrink-0\">\n              <img\n                src={avatarUrl}\n                alt={displayName}\n                className=\"w-20 h-20 sm:w-24 sm:h-24 rounded-2xl object-cover border-2 border-[#F5C453] shadow-lg shadow-black/40\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <button\n                type=\"button\"\n                onClick={() => setIsAvatarModalOpen(true)}\n                className=\"absolute inset-0 rounded-2xl bg-black/60 opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center transition-opacity text-[#F5C453] cursor-pointer\"\n                title=\"Change Avatar\"\n              >\n                <Camera className=\"w-5 h-5\" />\n                <span className=\"text-[10px] font-bold text-white mt-0.5\">Edit</span>\n              </button>\n\n              {/* Status Indicator */}\n              <div \n                className={`absolute -bottom-2 right-1/2 translate-x-1/2 sm:translate-x-0 sm:right-0 px-2 py-0.5 rounded-full text-[10px] font-bold border flex items-center gap-1.5 shadow-md ${\n                  onlineStatus === \'online\'\n                    ? \'bg-emerald-950 text-emerald-300 border-emerald-500/40\'\n                    : onlineStatus === \'in_game\'\n                    ? \'bg-amber-950 text-amber-300 border-amber-500/40 animate-pulse\'\n                    : \'bg-slate-900 text-slate-400 border-slate-700\'\n                }`}\n              >\n                <span \n                  className={`w-1.5 h-1.5 rounded-full ${\n                    onlineStatus === \'online\'\n                      ? \'bg-emerald-400\'\n                      : onlineStatus === \'in_game\'\n                      ? \'bg-amber-400\'\n                      : \'bg-slate-500\'\n                  }`} \n                />\n                <span className=\"capitalize\">{onlineStatus === \'in_game\' ? \'In-Game\' : onlineStatus}</span>\n              </div>\n            </div>\n\n            {/* Typography Details */}\n            <div className=\"space-y-1.5\">\n              <div className=\"flex items-center justify-center sm:justify-start gap-2 flex-wrap\">\n                <h1 className=\"text-2xl sm:text-3xl font-black font-heading text-white tracking-tight\">\n                  {displayName}\n                </h1>\n                <span className=\"text-lg select-none\" title={countryName}>\n                  {countryFlag}\n                </span>\n                {isOwner && (\n                  <span className=\"text-[9px] font-black px-2 py-0.5 rounded bg-[#8C2425] text-white border border-[#F5C453]/40 tracking-wider\">\n                    \360\237\221\221 FOUNDER\n                  </span>\n                )}\n                {isSkyAccount && (\n                  <span className=\"text-[9px] font-black px-2 py-0.5 rounded bg-sky-600 text-white border border-sky-300 tracking-wider\">\n                    \360\237\246\213 CELESTIAL\n                  </span>\n                )}\n              </div>\n\n              <div className=\"flex items-center justify-center sm:justify-start gap-2 text-xs text-slate-400 font-medium\">\n                <span className=\"font-mono text-slate-300\">@{username}</span>\n                <span>\342\200\242</span>\n                <span className=\"text-slate-300\">{countryName}</span>\n                <span>\342\200\242</span>\n                <span className=\"text-[#F5C453] font-bold flex items-center gap-1\">\n                  <Crown className=\"w-3.5 h-3.5\" />\n                  <span>{profile?.honorRank || \'Peshmerga Grandmaster\'}</span>\n                </span>\n              </div>\n\n              <p className=\"text-xs text-slate-400 italic max-w-md\">\n                \"{profile?.customStatus || \'Defending the mountain passes with calculated grandmaster honor.\'}\"\n              </p>\n            </div>\n          </div>\n\n          {/* Primary Action Buttons */}\n          <div className=\"flex items-center gap-2.5 w-full sm:w-auto shrink-0 justify-center\">\n            <button\n              type=\"button\"\n              onClick={onChallenge}\n              className=\"flex-1 sm:flex-none py-2.5 px-4 rounded-xl bg-gradient-to-r from-emerald-600 to-[#52673A] hover:from-emerald-500 hover:to-[#5f7843] text-white text-xs font-black uppercase tracking-wider flex items-center justify-center gap-2 shadow-md border border-emerald-400/30 transition-all cursor-pointer\"\n            >\n              <Swords className=\"w-4 h-4\" />\n              <span>Challenge</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={handleAddFriendClick}\n              className={`flex-1 sm:flex-none py-2.5 px-3.5 rounded-xl text-xs font-bold flex items-center justify-center gap-2 border transition-all cursor-pointer ${\n                friendStatus === \'friends\'\n                  ? \'bg-emerald-950/70 text-emerald-300 border-emerald-500/40\'\n                  : friendStatus === \'sent\'\n                  ? \'bg-amber-950/70 text-amber-300 border-amber-500/40\'\n                  : \'bg-slate-800 hover:bg-slate-750 text-white border-slate-700\'\n              }`}\n            >\n              {friendStatus === \'friends\' ? (\n                <>\n                  <Check className=\"w-4 h-4 text-emerald-400\" />\n                  <span>Friends</span>\n                </>\n              ) : friendStatus === \'sent\' ? (\n                <>\n                  <Activity className=\"w-4 h-4 text-amber-400 animate-spin\" />\n                  <span>Sent</span>\n                </>\n              ) : (\n                <>\n                  <UserPlus className=\"w-4 h-4 text-[#F5C453]\" />\n                  <span>Add Friend</span>\n                </>\n              )}\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={handleShareProfile}\n              className=\"p-2.5 rounded-xl bg-slate-800 hover:bg-slate-750 text-slate-300 hover:text-white border border-slate-700 transition-all cursor-pointer\"\n              title=\"Share profile link\"\n            >\n              {copiedLink ? <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" /> : <Share2 className=\"w-4 h-4\" />}\n            </button>\n\n            {onEditProfileModal && (\n              <button\n                type=\"button\"\n                onClick={onEditProfileModal}\n                className=\"py-2.5 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-bold border border-slate-700 transition-all cursor-pointer\"\n              >\n                Settings\n              </button>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* ========================================================================= */}\n      {/* 2. TABBED NAVIGATION INTERFACE                                            */}\n      {/* ========================================================================= */}\n      <div className=\"flex items-center justify-between border-b border-slate-800 pb-2\">\n        <div className=\"flex items-center gap-1.5 sm:gap-2 overflow-x-auto no-scrollbar w-full sm:w-auto\">\n          {[\n            { id: \'overview\', label: \'Overview\', icon: <Compass className=\"w-4 h-4\" /> },\n            { id: \'matches\', label: \'Match History\', icon: <History className=\"w-4 h-4\" />, count: allMatches.length },\n            { id: \'analytics\', label: \'Analytics\', icon: <BarChart2 className=\"w-4 h-4\" /> },\n            { id: \'social\', label: \'Social\', icon: <Users className=\"w-4 h-4\" />, count: friendsList.length }\n          ].map(tab => {\n            const isActive = activeTab === tab.id;\n            return (\n              <button\n                key={tab.id}\n                type=\"button\"\n                onClick={() => setActiveTab(tab.id as TabType)}\n                className={`py-2 px-3 sm:px-4 rounded-xl text-xs font-bold flex items-center gap-2 transition-all cursor-pointer whitespace-nowrap border ${\n                  isActive\n                    ? \'bg-slate-800 text-white border-slate-700 shadow-sm\'\n                    : \'bg-transparent text-slate-400 hover:text-slate-200 border-transparent hover:bg-slate-800/40\'\n                }`}\n              >\n                {tab.icon}\n                <span>{tab.label}</span>\n                {tab.count !== undefined && (\n                  <span className={`text-[10px] px-1.5 py-0.2 rounded-md font-mono ${\n                    isActive ? \'bg-slate-900 text-[#F5C453]\' : \'bg-slate-800 text-slate-400\'\n                  }`}>\n                    {tab.count}\n                  </span>\n                )}\n              </button>\n            );\n          })}\n        </div>\n\n        {/* Global Respect Points Indicator */}\n        <div className=\"hidden md:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900/80 border border-slate-800 text-xs font-mono\">\n          <span className=\"text-[#F5C453] font-bold\">\360\237\233\241\357\270\217 Respect:</span>\n          <span className=\"text-white font-black\">{profile?.respectPoints ?? 100} pts</span>\n        </div>\n      </div>\n\n      {/* ========================================================================= */}\n      {/* TAB CONTENT: 1. OVERVIEW                                                  */}\n      {/* ========================================================================= */}\n      {activeTab === \'overview\' && (\n        <div className=\"space-y-6\">\n          {/* Primary Elo Ratings Cards Grid */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5\">\n            {Object.entries(ratingsData).map(([key, item]) => (\n              <div \n                key={key}\n                className=\"p-4 rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 transition-all shadow-sm flex flex-col justify-between\"\n              >\n                <div>\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <div className=\"p-1.5 rounded-lg bg-slate-800/80 border border-slate-700\">\n                      {item.icon}\n                    </div>\n                    <span className=\"text-[10px] font-mono text-slate-500\">\n                      {item.time}\n                    </span>\n                  </div>\n                  <div className=\"text-xs font-bold text-slate-400\">{item.title}</div>\n                  <div className=\"text-2xl sm:text-3xl font-black font-mono text-white tracking-tight my-1\">\n                    {item.current}\n                  </div>\n                </div>\n\n                <div className=\"pt-2 border-t border-slate-800/80 flex items-center justify-between text-[10px] text-slate-400 font-mono\">\n                  <span>Peak <strong className=\"text-slate-200\">{item.peak}</strong></span>\n                  <span>{item.games} g</span>\n                </div>\n              </div>\n            ))}\n          </div>\n\n          {/* 2-Column Responsive Layout for Overview */}\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n            {/* Left Column (7 Cols): Quick Rating Trajectory & Win Rates */}\n            <div className=\"lg:col-span-7 space-y-6\">\n              {/* Rating Progress Teaser */}\n              <div className=\"p-5 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-sm space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2\">\n                    <TrendingUp className=\"w-4 h-4 text-emerald-400\" />\n                    <h3 className=\"text-xs font-black uppercase tracking-wider text-slate-200\">\n                      Rating Progress (Rapid)\n                    </h3>\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveTab(\'analytics\')}\n                    className=\"text-[11px] font-bold text-[#F5C453] hover:underline flex items-center gap-1 cursor-pointer\"\n                  >\n                    <span>Full Analytics</span>\n                    <ChevronRight className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n\n                {/* Mini Sparkline Curve */}\n                <div className=\"relative w-full h-32 pt-2\">\n                  <svg viewBox={`0 0 ${chartWidth} ${chartHeight}`} className=\"w-full h-full overflow-visible\">\n                    <defs>\n                      <linearGradient id=\"miniGradient\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                        <stop offset=\"0%\" stopColor=\"#10B981\" stopOpacity=\"0.3\" />\n                        <stop offset=\"100%\" stopColor=\"#10B981\" stopOpacity=\"0.0\" />\n                      </linearGradient>\n                    </defs>\n                    <path d={areaD} fill=\"url(#miniGradient)\" />\n                    <path d={pathD} fill=\"none\" stroke=\"#10B981\" strokeWidth=\"2.5\" strokeLinecap=\"round\" />\n                  </svg>\n                </div>\n\n                <div className=\"flex items-center justify-between text-xs text-slate-400 font-mono pt-2 border-t border-slate-800\">\n                  <span>Current: <strong className=\"text-white\">{baseElo} Elo</strong></span>\n                  <span>Trend: <strong className=\"text-emerald-400\">+48 past 30 days</strong></span>\n                </div>\n              </div>\n\n              {/* Color Performance Card */}\n              <div className=\"p-5 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-sm space-y-3\">\n                <div className=\"flex items-center gap-2\">\n                  <PieChart className=\"w-4 h-4 text-emerald-400\" />\n                  <h3 className=\"text-xs font-black uppercase tracking-wider text-slate-200\">\n                    Piece Performance\n                  </h3>\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1\">\n                  <div className=\"p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 space-y-2\">\n                    <div className=\"flex items-center justify-between text-xs font-bold\">\n                      <span className=\"text-white flex items-center gap-1.5\">\n                        <span>\342\231\224</span> <span>As White</span>\n                      </span>\n                      <span className=\"text-emerald-400 font-mono\">64% Wins</span>\n                    </div>\n                    <div className=\"h-2 rounded-full bg-slate-800 overflow-hidden flex\">\n                      <div style={{ width: \'64%\' }} className=\"bg-emerald-500 h-full\" />\n                      <div style={{ width: \'18%\' }} className=\"bg-slate-500 h-full\" />\n                      <div style={{ width: \'18%\' }} className=\"bg-rose-500 h-full\" />\n                    </div>\n                  </div>\n\n                  <div className=\"p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 space-y-2\">\n                    <div className=\"flex items-center justify-between text-xs font-bold\">\n                      <span className=\"text-slate-300 flex items-center gap-1.5\">\n                        <span>\342\231\232</span> <span>As Black</span>\n                      </span>\n                      <span className=\"text-emerald-400 font-mono\">56% Wins</span>\n                    </div>\n                    <div className=\"h-2 rounded-full bg-slate-800 overflow-hidden flex\">\n                      <div style={{ width: \'56%\' }} className=\"bg-emerald-500 h-full\" />\n                      <div style={{ width: \'22%\' }} className=\"bg-slate-500 h-full\" />\n                      <div style={{ width: \'22%\' }} className=\"bg-rose-500 h-full\" />\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Right Column (5 Cols): Recent 3 Matches & Highlights */}\n            <div className=\"lg:col-span-5 space-y-6\">\n              {/* Recent Matches Snapshot */}\n              <div className=\"p-5 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-sm space-y-3\">\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2\">\n                    <History className=\"w-4 h-4 text-[#F5C453]\" />\n                    <h3 className=\"text-xs font-black uppercase tracking-wider text-slate-200\">\n                      Recent Matches\n                    </h3>\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveTab(\'matches\')}\n                    className=\"text-[11px] font-bold text-[#F5C453] hover:underline flex items-center gap-1 cursor-pointer\"\n                  >\n                    <span>View All (10)</span>\n                    <ChevronRight className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n\n                <div className=\"space-y-2\">\n                  {allMatches.slice(0, 3).map(m => (\n                    <div \n                      key={m.id}\n                      className=\"p-2.5 rounded-xl bg-slate-950/60 border border-slate-800/80 flex items-center justify-between gap-3 text-xs\"\n                    >\n                      <div className=\"flex items-center gap-2.5 min-w-0\">\n                        <span className={`px-2 py-0.5 rounded text-[10px] font-black uppercase font-mono ${\n                          m.result === \'win\' ? \'bg-emerald-500/20 text-emerald-300\' : m.result === \'loss\' ? \'bg-rose-500/20 text-rose-300\' : \'bg-slate-700 text-slate-300\'\n                        }`}>\n                          {m.result}\n                        </span>\n                        <div className=\"truncate\">\n                          <div className=\"font-bold text-white truncate\">{m.opponentName}</div>\n                          <div className=\"text-[10px] text-slate-400 font-mono\">{m.timeControl} \342\200\242 {m.date}</div>\n                        </div>\n                      </div>\n                      <div className=\"text-right shrink-0\">\n                        <div className={`font-mono font-bold text-xs ${m.ratingChange >= 0 ? \'text-emerald-400\' : \'text-rose-400\'}`}>\n                          {m.ratingChange >= 0 ? `+${m.ratingChange}` : m.ratingChange}\n                        </div>\n                        <div className=\"text-[10px] text-slate-500 font-mono\">{m.accuracy}% acc</div>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              {/* Achievements Showcase Teaser */}\n              <div className=\"p-5 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-sm space-y-3\">\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2\">\n                    <Award className=\"w-4 h-4 text-amber-400\" />\n                    <h3 className=\"text-xs font-black uppercase tracking-wider text-slate-200\">\n                      Top Honors\n                    </h3>\n                  </div>\n                  <span className=\"text-[10px] font-mono text-emerald-400\">8 / 8 Badges</span>\n                </div>\n\n                <div className=\"grid grid-cols-4 gap-2\">\n                  {achievementBadges.slice(0, 4).map(b => (\n                    <div\n                      key={b.id}\n                      className=\"p-2 rounded-xl bg-slate-950/60 border border-slate-800/80 text-center flex flex-col items-center justify-center space-y-1\"\n                      title={b.name}\n                    >\n                      <span className=\"text-xl\">{b.icon}</span>\n                      <span className=\"text-[9px] font-bold text-slate-300 truncate w-full\">{b.name}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* ========================================================================= */}\n      {/* TAB CONTENT: 2. MATCH HISTORY (DEEP 10-GAME BATTLE LOG)                   */}\n      {/* ========================================================================= */}\n      {activeTab === \'matches\' && (\n        <div className=\"space-y-4\">\n          {/* Controls Bar: Filters & Search */}\n          <div className=\"p-4 rounded-2xl bg-slate-900/80 border border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-sm\">\n            {/* Filter Pills */}\n            <div className=\"flex items-center gap-1.5 bg-slate-950 p-1 rounded-xl border border-slate-800 w-full sm:w-auto justify-center\">\n              {([\'all\', \'win\', \'loss\', \'draw\'] as MatchFilter[]).map(filter => (\n                <button\n                  key={filter}\n                  type=\"button\"\n                  onClick={() => setMatchFilter(filter)}\n                  className={`px-3 py-1 text-xs font-bold rounded-lg uppercase tracking-wider transition-all cursor-pointer ${\n                    matchFilter === filter\n                      ? filter === \'win\'\n                        ? \'bg-emerald-600 text-white\'\n                        : filter === \'loss\'\n                        ? \'bg-rose-600 text-white\'\n                        : \'bg-slate-700 text-white\'\n                      : \'text-slate-400 hover:text-white\'\n                  }`}\n                >\n                  {filter}\n                </button>\n              ))}\n            </div>\n\n            {/* Search Input */}\n            <div className=\"relative w-full sm:w-64\">\n              <input\n                type=\"text\"\n                placeholder=\"Search opponent or opening...\"\n                value={searchOpponent}\n                onChange={e => setSearchOpponent(e.target.value)}\n                className=\"w-full pl-8 pr-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white placeholder:text-slate-500 focus:border-[#F5C453] outline-none\"\n              />\n              <Search className=\"w-3.5 h-3.5 text-slate-500 absolute left-2.5 top-1/2 -translate-y-1/2\" />\n            </div>\n          </div>\n\n          {/* 10 Match History List */}\n          <div className=\"space-y-2.5\">\n            {filteredMatches.length === 0 ? (\n              <div className=\"p-8 text-center rounded-2xl bg-slate-900/60 border border-slate-800 text-slate-400 text-xs\">\n                No match records found matching filter criteria.\n              </div>\n            ) : (\n              filteredMatches.map(match => {\n                const isWin = match.result === \'win\';\n                const isLoss = match.result === \'loss\';\n                const isDraw = match.result === \'draw\';\n\n                return (\n                  <div\n                    key={match.id}\n                    className=\"p-3.5 rounded-2xl bg-slate-900/80 hover:bg-slate-850 border border-slate-800/90 hover:border-slate-700 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3.5 group shadow-sm\"\n                  >\n                    {/* Left: Result Badge + Opponent */}\n                    <div className=\"flex items-center gap-3 min-w-0\">\n                      <div\n                        className={`w-14 py-1.5 rounded-xl text-center font-black text-xs uppercase tracking-wider font-mono shrink-0 ${\n                          isWin\n                            ? \'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\'\n                            : isLoss\n                            ? \'bg-rose-500/20 text-rose-300 border border-rose-500/30\'\n                            : \'bg-slate-700/30 text-slate-300 border border-slate-600/30\'\n                        }`}\n                      >\n                        {match.result}\n                      </div>\n\n                      <div className=\"flex items-center gap-2.5 min-w-0\">\n                        {match.opponentAvatar.startsWith(\'http\') ? (\n                          <img\n                            src={match.opponentAvatar}\n                            alt={match.opponentName}\n                            className=\"w-9 h-9 rounded-xl object-cover border border-slate-700 shrink-0\"\n                            referrerPolicy=\"no-referrer\"\n                          />\n                        ) : (\n                          <div className=\"w-9 h-9 rounded-xl bg-slate-800 text-base flex items-center justify-center border border-slate-700 shrink-0\">\n                            {match.opponentAvatar}\n                          </div>\n                        )}\n\n                        <div className=\"truncate\">\n                          <div className=\"text-xs font-bold text-white flex items-center gap-1.5 truncate\">\n                            <span className=\"truncate\">{match.opponentName}</span>\n                            <span className=\"text-[10px] text-slate-400 font-mono\">({match.opponentRating})</span>\n                          </div>\n                          <div className=\"text-[10px] text-slate-400 flex items-center gap-1.5 mt-0.5\">\n                            <span className=\"font-mono\">{match.timeControl}</span>\n                            <span>\342\200\242</span>\n                            <span className=\"text-slate-300 truncate\">{match.openingName}</span>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n\n                    {/* Right: Metrics & Action Buttons */}\n                    <div className=\"flex items-center justify-between sm:justify-end gap-4 w-full sm:w-auto pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-800/80\">\n                      <div className=\"flex items-center gap-3 text-right\">\n                        {/* Rating Change */}\n                        <div>\n                          <div\n                            className={`text-xs font-mono font-black ${\n                              match.ratingChange > 0\n                                ? \'text-emerald-400\'\n                                : match.ratingChange < 0\n                                ? \'text-rose-400\'\n                                : \'text-slate-400\'\n                            }`}\n                          >\n                            {match.ratingChange > 0 ? `+${match.ratingChange}` : match.ratingChange}\n                          </div>\n                          <div className=\"text-[9px] text-slate-500 uppercase font-bold\">Elo \316\224</div>\n                        </div>\n\n                        {/* Accuracy */}\n                        <div>\n                          <div className=\"text-xs font-mono font-bold text-slate-200\">\n                            {match.accuracy}%\n                          </div>\n                          <div className=\"text-[9px] text-slate-500 uppercase font-bold\">Accuracy</div>\n                        </div>\n                      </div>\n\n                      {/* Analyze Game Action Button */}\n                      <button\n                        type=\"button\"\n                        onClick={() => onAnalyzeGame && onAnalyzeGame(match.pgn, match.fen)}\n                        className=\"py-1.5 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-[#F5C453] hover:text-white text-xs font-bold border border-slate-700 transition-all flex items-center gap-1.5 cursor-pointer shrink-0\"\n                        title=\"Analyze move by move in Engine\"\n                      >\n                        <Compass className=\"w-3.5 h-3.5\" />\n                        <span>Analyze</span>\n                      </button>\n                    </div>\n                  </div>\n                );\n              })\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* ========================================================================= */}\n      {/* TAB CONTENT: 3. ANALYTICS (CHARTS, PERFORMANCE METRICS)                  */}\n      {/* ========================================================================= */}\n      {activeTab === \'analytics\' && (\n        <div className=\"space-y-6\">\n          {/* Interactive Rating Chart Card */}\n          <div className=\"p-5 sm:p-6 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-sm space-y-4\">\n            <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n              <div className=\"flex items-center gap-2\">\n                <TrendingUp className=\"w-4 h-4 text-emerald-400\" />\n                <div>\n                  <h3 className=\"text-xs font-black uppercase tracking-wider text-slate-200\">\n                    Interactive Rating Trajectory\n                  </h3>\n                  <p className=\"text-[11px] text-slate-400\">\n                    Hover data points to inspect past games and Elo shifts\n                  </p>\n                </div>\n              </div>\n\n              {/* Time Range Filter Buttons */}\n              <div className=\"flex items-center gap-1 bg-slate-950 p-1 rounded-xl border border-slate-800\">\n                {([\'1W\', \'1M\', \'1Y\', \'ALL\'] as TimeRangeFilter[]).map(tab => (\n                  <button\n                    key={tab}\n                    type=\"button\"\n                    onClick={() => setTimeRange(tab)}\n                    className={`px-3 py-1 text-xs font-bold rounded-lg transition-all cursor-pointer ${\n                      timeRange === tab\n                        ? \'bg-emerald-500 text-slate-950 font-black\'\n                        : \'text-slate-400 hover:text-white\'\n                    }`}\n                  >\n                    {tab}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* SVG Interactive Line Chart Container */}\n            <div className=\"relative w-full overflow-hidden pt-2\">\n              <svg\n                viewBox={`0 0 ${chartWidth} ${chartHeight}`}\n                className=\"w-full h-48 sm:h-64 overflow-visible select-none\"\n              >\n                <defs>\n                  <linearGradient id=\"ratingAreaGradientTab\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"0%\" stopColor=\"#10B981\" stopOpacity=\"0.35\" />\n                    <stop offset=\"100%\" stopColor=\"#047857\" stopOpacity=\"0.0\" />\n                  </linearGradient>\n                  <linearGradient id=\"ratingLineGradientTab\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n                    <stop offset=\"0%\" stopColor=\"#34D399\" />\n                    <stop offset=\"50%\" stopColor=\"#F5C453\" />\n                    <stop offset=\"100%\" stopColor=\"#10B981\" />\n                  </linearGradient>\n                </defs>\n\n                {/* Horizontal Gridlines */}\n                {[0, 0.25, 0.5, 0.75, 1].map((ratio, idx) => {\n                  const y = paddingY + ratio * (chartHeight - paddingY * 2);\n                  const labelRating = Math.round(maxRating - ratio * (maxRating - minRating));\n                  return (\n                    <g key={idx}>\n                      <line\n                        x1={paddingX}\n                        y1={y}\n                        x2={chartWidth - paddingX}\n                        y2={y}\n                        stroke=\"#334155\"\n                        strokeDasharray=\"4 4\"\n                        strokeOpacity=\"0.4\"\n                      />\n                      <text\n                        x={paddingX - 6}\n                        y={y + 3}\n                        fill=\"#64748B\"\n                        fontSize=\"9\"\n                        fontFamily=\"monospace\"\n                        textAnchor=\"end\"\n                      >\n                        {labelRating}\n                      </text>\n                    </g>\n                  );\n                })}\n\n                <path d={areaD} fill=\"url(#ratingAreaGradientTab)\" />\n                <path d={pathD} fill=\"none\" stroke=\"url(#ratingLineGradientTab)\" strokeWidth=\"3\" strokeLinecap=\"round\" />\n\n                {points.map((pt, i) => {\n                  const isHovered = hoveredPoint?.index === i;\n                  const isLast = i === points.length - 1;\n                  return (\n                    <circle\n                      key={i}\n                      cx={pt.x}\n                      cy={pt.y}\n                      r={isHovered || isLast ? 5 : 3}\n                      fill={isHovered ? \'#FFFFFF\' : \'#10B981\'}\n                      stroke=\"#0F172A\"\n                      strokeWidth=\"2\"\n                      className=\"cursor-pointer transition-all hover:scale-125\"\n                      onMouseEnter={() => setHoveredPoint({ index: i, x: pt.x, y: pt.y, data: pt.data })}\n                      onMouseLeave={() => setHoveredPoint(null)}\n                    />\n                  );\n                })}\n              </svg>\n\n              {hoveredPoint && (\n                <div\n                  className=\"absolute pointer-events-none z-20 -translate-x-1/2 -translate-y-full px-3 py-2 rounded-xl bg-slate-950 border border-emerald-500/50 shadow-xl text-xs space-y-1\"\n                  style={{\n                    left: `${(hoveredPoint.x / chartWidth) * 100}%`,\n                    top: `${(hoveredPoint.y / chartHeight) * 100}%`\n                  }}\n                >\n                  <div className=\"text-[10px] text-slate-400 font-mono\">{hoveredPoint.data.fullDate}</div>\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"text-white font-mono font-black\">{hoveredPoint.data.rating} Elo</span>\n                    <span className=\"text-emerald-400 font-bold\">{hoveredPoint.data.change}</span>\n                  </div>\n                </div>\n              )}\n            </div>\n          </div>\n\n          {/* 2-Column Grid: Repertoire & Color Performance */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            {/* Opening Repertoire Win Rates */}\n            <div className=\"p-5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-3\">\n              <div className=\"flex items-center gap-2\">\n                <Layers className=\"w-4 h-4 text-sky-400\" />\n                <h3 className=\"text-xs font-black uppercase tracking-wider text-slate-200\">\n                  Opening Repertoire Mastery\n                </h3>\n              </div>\n\n              <div className=\"space-y-2.5 pt-1\">\n                {[\n                  { name: \'Sicilian Defense: Najdorf\', games: 84, winRate: 71, score: \'w\' },\n                  { name: \"Queen\'s Gambit Accepted\", games: 62, winRate: 68, score: \'w\' },\n                  { name: \'King\342\200\231s Indian Defense\', games: 45, winRate: 64, score: \'b\' },\n                  { name: \'Ruy Lopez: Berlin Defense\', games: 39, winRate: 59, score: \'w\' }\n                ].map((op, idx) => (\n                  <div key={idx} className=\"p-2.5 rounded-xl bg-slate-950/60 border border-slate-800/80 space-y-1.5\">\n                    <div className=\"flex items-center justify-between text-xs\">\n                      <span className=\"font-bold text-white\">{op.name}</span>\n                      <span className=\"text-emerald-400 font-mono font-bold\">{op.winRate}% win</span>\n                    </div>\n                    <div className=\"h-1.5 rounded-full bg-slate-800 overflow-hidden\">\n                      <div style={{ width: `${op.winRate}%` }} className=\"bg-emerald-500 h-full\" />\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Tactical Accuracy & Precision */}\n            <div className=\"p-5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-3\">\n              <div className=\"flex items-center gap-2\">\n                <Target className=\"w-4 h-4 text-[#F5C453]\" />\n                <h3 className=\"text-xs font-black uppercase tracking-wider text-slate-200\">\n                  Game Precision & Blunder Rate\n                </h3>\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3 pt-1\">\n                <div className=\"p-3.5 rounded-xl bg-slate-950/60 border border-slate-800/80 text-center\">\n                  <div className=\"text-2xl font-black font-mono text-emerald-400\">88.4%</div>\n                  <div className=\"text-[10px] text-slate-400 uppercase font-bold mt-0.5\">Average Accuracy</div>\n                </div>\n                <div className=\"p-3.5 rounded-xl bg-slate-950/60 border border-slate-800/80 text-center\">\n                  <div className=\"text-2xl font-black font-mono text-white\">0.42</div>\n                  <div className=\"text-[10px] text-slate-400 uppercase font-bold mt-0.5\">Blunders / Game</div>\n                </div>\n                <div className=\"p-3.5 rounded-xl bg-slate-950/60 border border-slate-800/80 text-center\">\n                  <div className=\"text-2xl font-black font-mono text-sky-400\">92.1%</div>\n                  <div className=\"text-[10px] text-slate-400 uppercase font-bold mt-0.5\">Opening Precision</div>\n                </div>\n                <div className=\"p-3.5 rounded-xl bg-slate-950/60 border border-slate-800/80 text-center\">\n                  <div className=\"text-2xl font-black font-mono text-purple-400\">84.6%</div>\n                  <div className=\"text-[10px] text-slate-400 uppercase font-bold mt-0.5\">Endgame Conversion</div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* ========================================================================= */}\n      {/* TAB CONTENT: 4. SOCIAL (FRIENDS, ACHIEVEMENTS, STATUS)                     */}\n      {/* ========================================================================= */}\n      {activeTab === \'social\' && (\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n          {/* Left Column (5 Cols): Friends List & Online Status */}\n          <div className=\"lg:col-span-5 space-y-4\">\n            <div className=\"p-5 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-sm space-y-4\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <Users className=\"w-4 h-4 text-[#F5C453]\" />\n                  <h3 className=\"text-xs font-black uppercase tracking-wider text-slate-200\">\n                    Friends List ({friendsList.length})\n                  </h3>\n                </div>\n                <button\n                  type=\"button\"\n                  className=\"text-[11px] font-bold text-[#F5C453] hover:underline cursor-pointer\"\n                >\n                  + Add New\n                </button>\n              </div>\n\n              <div className=\"space-y-2\">\n                {friendsList.map(friend => (\n                  <div\n                    key={friend.id}\n                    className=\"p-2.5 rounded-xl bg-slate-950/60 border border-slate-800/80 flex items-center justify-between gap-3 text-xs\"\n                  >\n                    <div className=\"flex items-center gap-2.5 min-w-0\">\n                      <img\n                        src={friend.avatar}\n                        alt={friend.name}\n                        className=\"w-8 h-8 rounded-lg object-cover border border-slate-700 shrink-0\"\n                        referrerPolicy=\"no-referrer\"\n                      />\n                      <div className=\"truncate\">\n                        <div className=\"font-bold text-white flex items-center gap-1 truncate\">\n                          <span>{friend.name}</span>\n                          <span>{friend.flag}</span>\n                        </div>\n                        <div className=\"text-[10px] text-slate-400 font-mono\">{friend.rating} Elo</div>\n                      </div>\n                    </div>\n\n                    <div className=\"flex items-center gap-2 shrink-0\">\n                      <span className={`w-2 h-2 rounded-full ${\n                        friend.status === \'online\' ? \'bg-emerald-400\' : friend.status === \'in_game\' ? \'bg-amber-400 animate-pulse\' : \'bg-slate-600\'\n                      }`} />\n                      <button\n                        type=\"button\"\n                        onClick={onChallenge}\n                        className=\"py-1 px-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-white font-bold border border-slate-700 cursor-pointer\"\n                      >\n                        Play\n                      </button>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Quick Status Setter */}\n            <div className=\"p-4 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2 text-xs\">\n              <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider block\">\n                Set Broadcast Status\n              </span>\n              <div className=\"grid grid-cols-3 gap-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setOnlineStatus(\'online\')}\n                  className={`py-1.5 rounded-xl font-bold border transition-all cursor-pointer ${\n                    onlineStatus === \'online\' ? \'bg-emerald-950 text-emerald-300 border-emerald-500/40\' : \'bg-slate-950 text-slate-400 border-slate-800\'\n                  }`}\n                >\n                  \360\237\237\242 Online\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setOnlineStatus(\'in_game\')}\n                  className={`py-1.5 rounded-xl font-bold border transition-all cursor-pointer ${\n                    onlineStatus === \'in_game\' ? \'bg-amber-950 text-amber-300 border-amber-500/40\' : \'bg-slate-950 text-slate-400 border-slate-800\'\n                  }`}\n                >\n                  \342\232\224\357\270\217 In-Game\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setOnlineStatus(\'offline\')}\n                  className={`py-1.5 rounded-xl font-bold border transition-all cursor-pointer ${\n                    onlineStatus === \'offline\' ? \'bg-slate-800 text-slate-200 border-slate-700\' : \'bg-slate-950 text-slate-400 border-slate-800\'\n                  }`}\n                >\n                  \342\232\252 Offline\n                </button>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Column (7 Cols): Full Achievement Badges Showcase */}\n          <div className=\"lg:col-span-7 space-y-4\">\n            <div className=\"p-5 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-sm space-y-4\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <Award className=\"w-4 h-4 text-amber-400\" />\n                  <h3 className=\"text-xs font-black uppercase tracking-wider text-slate-200\">\n                    Achievement Badges (8/8)\n                  </h3>\n                </div>\n                <span className=\"text-[10px] text-[#F5C453] font-bold\">100% Unlocked</span>\n              </div>\n\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2.5\">\n                {achievementBadges.map(badge => (\n                  <div\n                    key={badge.id}\n                    className={`p-3 rounded-xl bg-gradient-to-b ${badge.color} border flex flex-col items-center text-center space-y-1 hover:scale-[1.03] transition-all shadow-sm`}\n                  >\n                    <span className=\"text-2xl select-none\">{badge.icon}</span>\n                    <span className=\"text-xs font-bold leading-tight line-clamp-1\">{badge.name}</span>\n                    <span className=\"text-[9px] text-slate-400 line-clamp-2 leading-tight\">{badge.desc}</span>\n                    <span className=\"text-[8px] font-black uppercase tracking-wider px-1.5 py-0.2 rounded bg-black/40 text-slate-300 border border-white/10 mt-auto\">\n                      {badge.rarity}\n                    </span>\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* ========================================================================= */}\n      {/* 5. AVATAR / AI STUDIO SELECTION MODAL                                     */}\n      {/* ========================================================================= */}\n      {isAvatarModalOpen && (\n        <ChessAvatarModal\n          isOpen={isAvatarModalOpen}\n          onClose={() => setIsAvatarModalOpen(false)}\n        />\n      )}\n    </div>\n  );\n};\n"
    }
