        }
        lines {
          text: "  const pointerStartPosRef = useRef<{ x: number; y: number; square: Square | null }>({ x: 0, y: 0, square: null });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const isActivelyDraggingRef = useRef<boolean>(false);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const ignoreNextClickRef = useRef<boolean>(false);"
