      replacement_content: ".respect-delta-pill {\n  animation: respect-delta-float 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;\n  pointer-events: none;\n  user-select: none;\n}\n\n/* ========================================================================= */\n/* ATTACK ON TITAN: WALL MARIA THEME & EFFECTS                               */\n/* ========================================================================= */\n\n/* Weathered Wall Maria Stone Textures */\n.wall-maria-stone-dark {\n  background-color: #1f232b;\n  background-image: \n    radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.04) 0%, transparent 80%),\n    linear-gradient(135deg, rgba(0, 0, 0, 0.25) 25%, transparent 25%), \n    linear-gradient(225deg, rgba(0, 0, 0, 0.25) 25%, transparent 25%), \n    linear-gradient(45deg, rgba(255, 255, 255, 0.02) 25%, transparent 25%), \n    linear-gradient(315deg, rgba(0, 0, 0, 0.3) 25%, transparent 25%);\n  background-position: 12px 0, 12px 0, 0 0, 0 0;\n  background-size: 24px 24px;\n}\n\n.wall-maria-stone-light {\n  background-color: #5d6f54;\n  background-image: \n    radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.07) 0%, transparent 80%),\n    linear-gradient(135deg, rgba(0, 0, 0, 0.15) 25%, transparent 25%), \n    linear-gradient(225deg, rgba(0, 0, 0, 0.15) 25%, transparent 25%), \n    linear-gradient(45deg, rgba(255, 255, 255, 0.04) 25%, transparent 25%), \n    linear-gradient(315deg, rgba(0, 0, 0, 0.2) 25%, transparent 25%);\n  background-position: 12px 0, 12px 0, 0 0, 0 0;\n  background-size: 24px 24px;\n}\n\n/* Green ODM Gas Glow Aura Animation for Active Moves & Selected Squares */\n@keyframes aot-odm-gas-pulse {\n  0%, 100% {\n    box-shadow: \n      inset 0 0 14px rgba(34, 197, 94, 0.4),\n      0 0 16px rgba(34, 197, 94, 0.45);\n    border-color: rgba(74, 222, 128, 0.85);\n  }\n  50% {\n    box-shadow: \n      inset 0 0 22px rgba(34, 197, 94, 0.7),\n      0 0 28px rgba(34, 197, 94, 0.75),\n      0 0 38px rgba(34, 197, 94, 0.35);\n    border-color: rgba(134, 239, 172, 1);\n  }\n}\n\n.aot-odm-gas-aura {\n  animation: aot-odm-gas-pulse 1.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;\n  will-change: box-shadow, border-color;\n}\n\n@keyframes aot-odm-vapor-drift {\n  0% {\n    opacity: 0.35;\n    transform: scale(0.95) translateY(2px);\n  }\n  50% {\n    opacity: 0.8;\n    transform: scale(1.06) translateY(-2px);\n  }\n  100% {\n    opacity: 0.35;\n    transform: scale(0.95) translateY(2px);\n  }\n}\n\n.aot-odm-vapor {\n  animation: aot-odm-vapor-drift 2s ease-in-out infinite;\n}\n\n/* Red Steam Boiling Danger / Check Animation */\n@keyframes aot-check-steam-pulse {\n  0% {\n    background-color: rgba(239, 68, 68, 0.6);\n    box-shadow: \n      inset 0 0 20px rgba(239, 68, 68, 0.85),\n      0 0 24px rgba(220, 38, 38, 0.6);\n    filter: drop-shadow(0 0 10px rgba(239, 68, 68, 0.7));\n  }\n  50% {\n    background-color: rgba(185, 28, 28, 0.82);\n    box-shadow: \n      inset 0 0 35px rgba(239, 68, 68, 1),\n      0 0 45px rgba(239, 68, 68, 0.95),\n      0 0 60px rgba(248, 113, 113, 0.5);\n    filter: drop-shadow(0 0 20px rgba(239, 68, 68, 0.9));\n  }\n  100% {\n    background-color: rgba(239, 68, 68, 0.6);\n    box-shadow: \n      inset 0 0 20px rgba(239, 68, 68, 0.85),\n      0 0 24px rgba(220, 38, 38, 0.6);\n    filter: drop-shadow(0 0 10px rgba(239, 68, 68, 0.7));\n  }\n}\n\n.aot-steam-danger {\n  animation: aot-check-steam-pulse 1.1s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n  will-change: background-color, box-shadow, filter;\n}\n\n/* Colossal Titan billowing thermal steam particles */\n@keyframes aot-steam-particle-rise {\n  0% {\n    opacity: 0.8;\n    transform: translateY(0) scale(0.8) rotate(0deg);\n    filter: blur(1px);\n  }\n  50% {\n    opacity: 0.5;\n    transform: translateY(-8px) scale(1.2) rotate(8deg);\n    filter: blur(3px);\n  }\n  100% {\n    opacity: 0;\n    transform: translateY(-18px) scale(1.6) rotate(-10deg);\n    filter: blur(5px);\n  }\n}\n\n.aot-steam-particle {\n  animation: aot-steam-particle-rise 1.4s ease-out infinite;\n}\n"
    }
