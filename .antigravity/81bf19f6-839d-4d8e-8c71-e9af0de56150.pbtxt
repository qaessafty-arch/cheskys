    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { getLocalGameLogs } from \'../services/loggingService\';\nimport { \n  Trophy, \n  Swords, \n  Flame, \n  Zap, \n  Clock, \n  Sun, \n  Puzzle, \n  UserPlus, \n  Check, \n  TrendingUp, \n  Sparkles, \n  ShieldCheck, \n  Activity, \n  ChevronRight, \n  Search, \n  Camera, \n  Eye, \n  Award, \n  Calendar, \n  BarChart2, \n  PieChart, \n  Layers, \n  Crown, \n  Compass, \n  Share2, \n  UserCheck, \n  CheckCircle2, \n  RotateCcw,\n  Target\n} from \'lucide-react\';\nimport { ChessAvatarModal } from \'./ChessAvatarModal\';\nimport { HONOR_RANKS, getHonorRank } from \'../utils/respectSystem\';\n\ninterface UserProfilePageProps {\n  onChallenge?: () => void;\n  onAnalyzeGame?: (pgn?: string, fen?: string) => void;\n  onEditProfileModal?: () => void;\n  onNavigateHome?: () => void;\n}\n\ntype TimeRangeFilter = \'1W\' | \'1M\' | \'1Y\' | \'ALL\';\ntype TimeControlCategory = \'all\' | \'rapid\' | \'blitz\' | \'bullet\' | \'daily\' | \'puzzles\';\n\ninterface MatchItem {\n  id: string;\n  opponentName: string;\n  opponentAvatar: string;\n  opponentRating: number;\n  result: \'win\' | \'loss\' | \'draw\';\n  ratingChange: number;\n  accuracy: number;\n  timeControl: string;\n  playerColor: \'w\' | \'b\';\n  date: string;\n  openingName: string;\n  pgn?: string;\n  fen?: string;\n}\n\nexport const UserProfilePage: React.FC<UserProfilePageProps> = ({\n  onChallenge,\n  onAnalyzeGame,\n  onEditProfileModal,\n  onNavigateHome\n}) => {\n  const { user, profile, isSkyAccount, isOwner, isDeveloper } = useAuth();\n\n  // State Management\n  const [onlineStatus, setOnlineStatus] = useState<\'online\' | \'in_game\' | \'offline\'>(\'online\');\n  const [friendStatus, setFriendStatus] = useState<\'add\' | \'sent\' | \'friends\'>(\'add\');\n  const [copiedLink, setCopiedLink] = useState(false);\n  const [timeRange, setTimeRange] = useState<TimeRangeFilter>(\'1M\');\n  const [chartCategory, setChartCategory] = useState<TimeControlCategory>(\'all\');\n  const [hoveredPoint, setHoveredPoint] = useState<{ index: number; x: number; y: number; data: any } | null>(null);\n  const [isAvatarModalOpen, setIsAvatarModalOpen] = useState(false);\n  const [selectedMatch, setSelectedMatch] = useState<MatchItem | null>(null);\n\n  // Dynamic User Information\n  const displayName = profile?.displayName || user?.displayName || \'Grandmaster Qays\';\n  const username = profile?.username || \'peshmerga_gm\';\n  const countryFlag = profile?.flag || \'\342\230\200\357\270\217\';\n  const countryName = profile?.country || \'Kurdistan\';\n  const avatarUrl = profile?.photoURL || (isSkyAccount \n    ? \'https://images.unsplash.com/photo-1557925923-cd4648e211a0?w=200&auto=format&fit=crop&q=80\' \n    : user?.photoURL || \'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=200&auto=format&fit=crop&q=80\');\n\n  const baseElo = typeof profile?.elo === \'number\' ? profile.elo : 2240;\n\n  // Time Control Rating Metrics\n  const ratingsData = useMemo(() => {\n    return {\n      bullet: {\n        current: Math.max(1400, Math.round(baseElo * 0.88)),\n        peak: Math.max(1500, Math.round(baseElo * 0.92)),\n        games: 142,\n        winRate: 64\n      },\n      blitz: {\n        current: Math.max(1600, Math.round(baseElo * 0.96)),\n        peak: Math.max(1700, Math.round(baseElo * 1.01)),\n        games: 389,\n        winRate: 68\n      },\n      rapid: {\n        current: baseElo,\n        peak: baseElo + 55,\n        games: profile?.gamesPlayed || 512,\n        winRate: 72\n      },\n      daily: {\n        current: Math.max(1800, baseElo + 70),\n        peak: baseElo + 110,\n        games: 76,\n        winRate: 79\n      },\n      puzzles: {\n        current: Math.max(2100, baseElo + 240),\n        peak: baseElo + 270,\n        games: 840,\n        winRate: 88\n      }\n    };\n  }, [baseElo, profile?.gamesPlayed]);\n\n  // Generate Interactive Rating Chart Data\n  const chartData = useMemo(() => {\n    const pointsCount = timeRange === \'1W\' ? 7 : timeRange === \'1M\' ? 30 : timeRange === \'1Y\' ? 52 : 70;\n    const now = new Date();\n    const data = [];\n    let currentRating = baseElo - (pointsCount * 2);\n\n    for (let i = 0; i < pointsCount; i++) {\n      const d = new Date();\n      if (timeRange === \'1W\') d.setDate(now.getDate() - (pointsCount - 1 - i));\n      else if (timeRange === \'1M\') d.setDate(now.getDate() - (pointsCount - 1 - i));\n      else if (timeRange === \'1Y\') d.setDate(now.getDate() - (pointsCount - 1 - i) * 7);\n      else d.setDate(now.getDate() - (pointsCount - 1 - i) * 15);\n\n      // Random natural fluctuation towards current baseElo\n      const fluctuation = Math.floor(Math.sin(i * 0.4) * 18) + (i > pointsCount - 5 ? 8 : (i % 3 === 0 ? 6 : -3));\n      currentRating += fluctuation;\n      if (i === pointsCount - 1) currentRating = baseElo;\n\n      data.push({\n        date: d.toLocaleDateString(\'en-US\', { month: \'short\', day: \'numeric\' }),\n        fullDate: d.toLocaleDateString(\'en-US\', { weekday: \'short\', month: \'short\', day: \'numeric\', year: \'numeric\' }),\n        rating: Math.max(1200, currentRating),\n        change: fluctuation >= 0 ? `+${fluctuation}` : `${fluctuation}`,\n        opponent: i % 2 === 0 ? \'GM SoranTactics\' : \'Citadel_Master\'\n      });\n    }\n    return data;\n  }, [timeRange, baseElo]);\n\n  // Chart SVG Coordinates Math\n  const minRating = Math.min(...chartData.map(d => d.rating)) - 25;\n  const maxRating = Math.max(...chartData.map(d => d.rating)) + 25;\n  const chartWidth = 700;\n  const chartHeight = 220;\n  const paddingX = 35;\n  const paddingY = 25;\n\n  const points = chartData.map((d, i) => {\n    const x = paddingX + (i / (chartData.length - 1)) * (chartWidth - paddingX * 2);\n    const y = chartHeight - paddingY - ((d.rating - minRating) / (maxRating - minRating)) * (chartHeight - paddingY * 2);\n    return { x, y, data: d };\n  });\n\n  const pathD = points.reduce((acc, point, i, arr) => {\n    if (i === 0) return `M ${point.x} ${point.y}`;\n    const prev = arr[i - 1];\n    const cpX1 = prev.x + (point.x - prev.x) / 2;\n    const cpY1 = prev.y;\n    const cpX2 = prev.x + (point.x - prev.x) / 2;\n    const cpY2 = point.y;\n    return `${acc} C ${cpX1} ${cpY1}, ${cpX2} ${cpY2}, ${point.x} ${point.y}`;\n  }, \'\');\n\n  const areaD = `${pathD} L ${points[points.length - 1].x} ${chartHeight - paddingY} L ${points[0].x} ${chartHeight - paddingY} Z`;\n\n  // Real or Sample Recent 10 Match History List\n  const recentMatches: MatchItem[] = useMemo(() => {\n    const rawLogs = getLocalGameLogs();\n    const formattedFromLogs: MatchItem[] = rawLogs.slice(0, 10).map((l, idx) => ({\n      id: l.id || `log-${idx}`,\n      opponentName: l.opponentName || \'Peshmerga Tactician\',\n      opponentAvatar: l.opponentAvatar || \'\342\231\232\',\n      opponentRating: l.opponentElo || 1850,\n      result: l.result === \'win\' || l.result === \'executed\' ? \'win\' : l.result === \'draw\' ? \'draw\' : \'loss\',\n      ratingChange: l.eloChange || (l.result === \'win\' ? 12 : l.result === \'draw\' ? 0 : -9),\n      accuracy: l.accuracy || Math.round(75 + (Math.random() * 20)),\n      timeControl: l.timeControlName || \'Rapid (10m)\',\n      playerColor: l.playerColor || \'w\',\n      date: l.date ? new Date(l.date).toLocaleDateString(\'en-US\', { month: \'short\', day: \'numeric\' }) : \'Today\',\n      openingName: \'Sicilian Defense: Najdorf\',\n      pgn: l.pgn,\n      fen: l.finalFen\n    }));\n\n    if (formattedFromLogs.length >= 10) {\n      return formattedFromLogs;\n    }\n\n    // Curated high quality entries to ensure full 10-match depth\n    const fallbackMatches: MatchItem[] = [\n      {\n        id: \'m-1\',\n        opponentName: \'GM Alan Kurdistan\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2280,\n        result: \'win\',\n        ratingChange: 14,\n        accuracy: 94.2,\n        timeControl: \'Rapid (10m)\',\n        playerColor: \'w\',\n        date: \'Aug 29\',\n        openingName: \"Queen\'s Gambit Accepted\",\n        fen: \'r1bqk2r/pp2bppp/2n1pn2/8/3P4/2N2N2/PP2BPPP/R1BQ1RK1 w kq - 0 10\'\n      },\n      {\n        id: \'m-2\',\n        opponentName: \'Citadel Sentinel \360\237\233\241\357\270\217\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2195,\n        result: \'win\',\n        ratingChange: 10,\n        accuracy: 89.6,\n        timeControl: \'Blitz (3m)\',\n        playerColor: \'b\',\n        date: \'Aug 28\',\n        openingName: \'King\342\200\231s Indian Defense\',\n        fen: \'rnbq1rk1/ppp1ppbp/3p1np1/8/2PPP3/2N2N2/PP2BPPP/R1BQK2R b KQ - 0 6\'\n      },\n      {\n        id: \'m-3\',\n        opponentName: \'Erbil Grandmaster\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2310,\n        result: \'loss\',\n        ratingChange: -11,\n        accuracy: 78.4,\n        timeControl: \'Rapid (15m)\',\n        playerColor: \'w\',\n        date: \'Aug 28\',\n        openingName: \'Ruy Lopez: Berlin Defense\',\n        fen: \'r1bqkb1r/pppp1ppp/2n5/4p3/1bB1P3/5N2/PPPP1PPP/RNBQK2R w KQkq - 0 4\'\n      },\n      {\n        id: \'m-4\',\n        opponentName: \'Zagros Mountain Wolf\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2150,\n        result: \'win\',\n        ratingChange: 9,\n        accuracy: 92.1,\n        timeControl: \'Bullet (1m)\',\n        playerColor: \'b\',\n        date: \'Aug 27\',\n        openingName: \'Sicilian: Dragon Variation\',\n        fen: \'r1bqk2r/pp2ppbp/2np1np1/8/3NP3/2N1BP2/PPP3PP/R2QKB1R w KQkq - 0 8\'\n      },\n      {\n        id: \'m-5\',\n        opponentName: \'Stockfish Neural Bot\',\n        opponentAvatar: \'\360\237\244\226\',\n        opponentRating: 2200,\n        result: \'draw\',\n        ratingChange: 0,\n        accuracy: 96.8,\n        timeControl: \'Daily (24h)\',\n        playerColor: \'w\',\n        date: \'Aug 26\',\n        openingName: \'Catalan Opening: Closed\',\n        fen: \'r1bq1rk1/pp1nbppp/2p1pn2/8/2PP4/5NP1/PP2NPBP/R1BQ1RK1 b - - 0 9\'\n      },\n      {\n        id: \'m-6\',\n        opponentName: \'SoranTactics\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2090,\n        result: \'win\',\n        ratingChange: 8,\n        accuracy: 86.4,\n        timeControl: \'Blitz (5m)\',\n        playerColor: \'w\',\n        date: \'Aug 25\',\n        openingName: \'French Defense: Winawer\',\n        fen: \'r1bqk1nr/pp3ppp/2n1p3/2bpP3/8/2PB1N2/PP3PPP/RNBQK2R b KQkq - 0 7\'\n      },\n      {\n        id: \'m-7\',\n        opponentName: \'Duhok Knight \360\237\217\260\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2185,\n        result: \'win\',\n        ratingChange: 11,\n        accuracy: 91.0,\n        timeControl: \'Rapid (10m)\',\n        playerColor: \'b\',\n        date: \'Aug 24\',\n        openingName: \'Caro-Kann: Classical\',\n        fen: \'r2qkbnr/pp1n1ppp/2p1p3/5b2/3PN3/5N2/PPP1BPPP/R1BQK2R w KQkq - 0 7\'\n      },\n      {\n        id: \'m-8\',\n        opponentName: \'Sulaymaniyah Master\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2260,\n        result: \'loss\',\n        ratingChange: -12,\n        accuracy: 74.5,\n        timeControl: \'Blitz (3m)\',\n        playerColor: \'w\',\n        date: \'Aug 23\',\n        openingName: \'English Opening: Four Knights\',\n        fen: \'r1bqkb1r/pppp1ppp/2n2n2/4p3/2P5/2N2N2/PP1PPPPP/R1BQKB1R w KQkq - 0 4\'\n      },\n      {\n        id: \'m-9\',\n        opponentName: \'Vanguard Ranger \342\232\224\357\270\217\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2040,\n        result: \'win\',\n        ratingChange: 7,\n        accuracy: 88.2,\n        timeControl: \'Bullet (2m)\',\n        playerColor: \'b\',\n        date: \'Aug 22\',\n        openingName: \'Modern Defense\',\n        fen: \'rnbqk1nr/ppp1ppbp/3p2p1/8/2PPP3/8/PP3PPP/RNBQKBNR w KQkq - 0 4\'\n      },\n      {\n        id: \'m-10\',\n        opponentName: \'Peshmerga Colonel\',\n        opponentAvatar: \'https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?w=100&auto=format&fit=crop&q=80\',\n        opponentRating: 2215,\n        result: \'win\',\n        ratingChange: 13,\n        accuracy: 95.3,\n        timeControl: \'Rapid (10m)\',\n        playerColor: \'w\',\n        date: \'Aug 21\',\n        openingName: \'Nimzo-Indian Defense\',\n        fen: \'r1bqk2r/pppp1ppp/2n1pn2/8/1bPP4/2N1PN2/PP3PPP/R1BQKB1R b KQkq - 0 5\'\n      }\n    ];\n\n    return [...formattedFromLogs, ...fallbackMatches].slice(0, 10);\n  }, []);\n\n  // Achievement Badges\n  const achievementBadges = [\n    {\n      id: \'first_tourney\',\n      name: \'First Tournament Win\',\n      desc: \'Finished 1st place in the Erbil Citadel Open Arena\',\n      icon: \'\360\237\217\206\',\n      rarity: \'Legendary\',\n      unlocked: true,\n      color: \'from-amber-500/20 to-yellow-500/10 border-amber-400/40 text-amber-300\'\n    },\n    {\n      id: \'puzzles_100\',\n      name: \'100 Puzzles Solved\',\n      desc: \'Solved over 100 tactical puzzles with precision\',\n      icon: \'\360\237\247\251\',\n      rarity: \'Epic\',\n      unlocked: true,\n      color: \'from-sky-500/20 to-blue-500/10 border-sky-400/40 text-sky-300\'\n    },\n    {\n      id: \'citadel_gm\',\n      name: \'Citadel Grandmaster\',\n      desc: \'Attained supreme 2200+ Elo rating across all modes\',\n      icon: \'\360\237\221\221\',\n      rarity: \'Mythic\',\n      unlocked: true,\n      color: \'from-purple-500/20 to-pink-500/10 border-purple-400/40 text-purple-300\'\n    },\n    {\n      id: \'lightning_tac\',\n      name: \'Lightning Tactician\',\n      desc: \'Won 20 consecutive Bullet & Blitz matches under 3 minutes\',\n      icon: \'\342\232\241\',\n      rarity: \'Rare\',\n      unlocked: true,\n      color: \'from-amber-400/20 to-orange-500/10 border-amber-300/40 text-amber-200\'\n    },\n    {\n      id: \'peshmerga_sun\',\n      name: \'Peshmerga Sun of Glory\',\n      desc: \'Awarded to defenders demonstrating supreme honor & respect\',\n      icon: \'\342\230\200\357\270\217\',\n      rarity: \'National Legend\',\n      unlocked: true,\n      color: \'from-emerald-500/20 to-amber-500/10 border-[#F5C453]/50 text-[#F5C453]\'\n    },\n    {\n      id: \'streak_10\',\n      name: \'Undefeated 10-Streak\',\n      desc: \'Maintained an unbroken 10-game win streak in rated rapid play\',\n      icon: \'\360\237\224\245\',\n      rarity: \'Epic\',\n      unlocked: true,\n      color: \'from-rose-500/20 to-orange-500/10 border-rose-400/40 text-rose-300\'\n    },\n    {\n      id: \'endgame_wiz\',\n      name: \'Endgame Wizard\',\n      desc: \'Converted 50 pawn endgames with zero blunders\',\n      icon: \'\360\237\233\241\357\270\217\',\n      rarity: \'Rare\',\n      unlocked: true,\n      color: \'from-indigo-500/20 to-cyan-500/10 border-indigo-400/40 text-indigo-300\'\n    },\n    {\n      id: \'accuracy_95\',\n      name: \'95%+ Accuracy Master\',\n      desc: \'Played a 35+ move victory with engine accuracy above 95%\',\n      icon: \'\360\237\216\257\',\n      rarity: \'Legendary\',\n      unlocked: true,\n      color: \'from-emerald-500/20 to-teal-500/10 border-emerald-400/40 text-emerald-300\'\n    }\n  ];\n\n  const handleShareProfile = () => {\n    navigator.clipboard.writeText(window.location.href);\n    setCopiedLink(true);\n    setTimeout(() => setCopiedLink(false), 3000);\n  };\n\n  const handleAddFriendClick = () => {\n    if (friendStatus === \'add\') {\n      setFriendStatus(\'sent\');\n      setTimeout(() => setFriendStatus(\'friends\'), 1200);\n    } else if (friendStatus === \'friends\') {\n      setFriendStatus(\'add\');\n    }\n  };\n\n  return (\n    <div className=\"w-full max-w-7xl mx-auto space-y-6 text-slate-100 font-ui pb-16\">\n      {/* ========================================================================= */}\n      {/* 1. PROFILE HEADER CARD                                                    */}\n      {/* ========================================================================= */}\n      <div className=\"relative rounded-3xl bg-slate-900/85 backdrop-blur-2xl border border-slate-700/60 p-6 sm:p-8 shadow-[0_15px_40px_rgba(0,0,0,0.6)] overflow-hidden\">\n        {/* Subtle decorative background gradient & mesh */}\n        <div className=\"absolute top-0 right-0 w-96 h-96 bg-gradient-to-bl from-emerald-500/10 via-[#F5C453]/5 to-transparent rounded-full blur-3xl pointer-events-none\" />\n        <div className=\"absolute top-0 left-0 h-1.5 w-full bg-gradient-to-r from-[#8C2425] via-[#52673A] to-[#F5C453]\" />\n\n        <div className=\"flex flex-col md:flex-row items-center md:items-start justify-between gap-6 relative z-10\">\n          {/* Avatar & User Details */}\n          <div className=\"flex flex-col sm:flex-row items-center sm:items-start gap-5 text-center sm:text-left\">\n            {/* Avatar with Camera Trigger */}\n            <div className=\"relative group shrink-0\">\n              <img\n                src={avatarUrl}\n                alt={displayName}\n                className=\"w-24 h-24 sm:w-28 sm:h-28 rounded-3xl object-cover border-2 border-[#F5C453] shadow-2xl shadow-black/60 group-hover:scale-[1.02] transition-transform\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <button\n                type=\"button\"\n                onClick={() => setIsAvatarModalOpen(true)}\n                className=\"absolute inset-0 rounded-3xl bg-black/60 opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center transition-opacity text-[#F5C453] cursor-pointer\"\n                title=\"Change Avatar / Open AI Studio\"\n              >\n                <Camera className=\"w-6 h-6 animate-pulse\" />\n                <span className=\"text-[10px] font-bold text-white mt-1\">Change</span>\n              </button>\n\n              {/* Online Status Pill Badge */}\n              <div \n                className={`absolute -bottom-2 right-1/2 translate-x-1/2 sm:translate-x-0 sm:right-0 px-2.5 py-0.5 rounded-full text-[10px] font-bold border flex items-center gap-1.5 shadow-lg ${\n                  onlineStatus === \'online\'\n                    ? \'bg-emerald-950/90 text-emerald-300 border-emerald-400/50\'\n                    : onlineStatus === \'in_game\'\n                    ? \'bg-amber-950/90 text-amber-300 border-amber-400/50 animate-pulse\'\n                    : \'bg-slate-900/90 text-slate-400 border-slate-600/50\'\n                }`}\n              >\n                <span \n                  className={`w-2 h-2 rounded-full ${\n                    onlineStatus === \'online\'\n                      ? \'bg-emerald-400\'\n                      : onlineStatus === \'in_game\'\n                      ? \'bg-amber-400\'\n                      : \'bg-slate-500\'\n                  }`} \n                />\n                <span className=\"capitalize\">{onlineStatus === \'in_game\' ? \'In-Game\' : onlineStatus}</span>\n              </div>\n            </div>\n\n            {/* Name, Username, Country & Honor Badges */}\n            <div className=\"space-y-2\">\n              <div className=\"flex items-center justify-center sm:justify-start gap-2 flex-wrap\">\n                <h1 className=\"text-2xl sm:text-3xl font-black font-heading text-white tracking-tight\">\n                  {displayName}\n                </h1>\n                <span className=\"text-xl select-none\" title={countryName}>\n                  {countryFlag}\n                </span>\n                {isOwner && (\n                  <span className=\"text-[10px] font-black px-2 py-0.5 rounded-md bg-[#8C2425] text-white border border-[#F5C453]/40 shadow-sm uppercase tracking-wider\">\n                    \360\237\221\221 FOUNDER #0\n                  </span>\n                )}\n                {isSkyAccount && (\n                  <span className=\"text-[10px] font-black px-2 py-0.5 rounded-md bg-sky-600 text-white border border-sky-300 shadow-sm uppercase tracking-wider\">\n                    \360\237\246\213 CELESTIAL\n                  </span>\n                )}\n              </div>\n\n              <div className=\"flex items-center justify-center sm:justify-start gap-2.5 text-xs text-slate-400 font-medium\">\n                <span className=\"font-mono text-slate-300\">@{username}</span>\n                <span>\342\200\242</span>\n                <span className=\"text-[#DFD0B0]/80\">{countryName}</span>\n                <span>\342\200\242</span>\n                <span className=\"text-amber-300 font-bold flex items-center gap-1\">\n                  <Crown className=\"w-3.5 h-3.5\" />\n                  <span>{profile?.honorRank || \'Peshmerga Grandmaster\'}</span>\n                </span>\n              </div>\n\n              {/* Status Quote */}\n              <p className=\"text-xs text-slate-300 italic max-w-lg bg-slate-950/40 px-3 py-1.5 rounded-xl border border-slate-800\">\n                \"{profile?.customStatus || \'Defending the mountain passes with calculated grandmaster honor.\'}\"\n              </p>\n\n              {/* Status Switcher Quick Toggles */}\n              <div className=\"flex items-center justify-center sm:justify-start gap-1.5 pt-1\">\n                <span className=\"text-[10px] text-slate-500 uppercase font-bold tracking-wider mr-1\">Status:</span>\n                <button\n                  type=\"button\"\n                  onClick={() => setOnlineStatus(\'online\')}\n                  className={`px-2 py-0.5 text-[10px] font-bold rounded-lg transition-all cursor-pointer ${\n                    onlineStatus === \'online\' ? \'bg-emerald-500/20 text-emerald-300 border border-emerald-400/40\' : \'text-slate-500 hover:text-slate-300\'\n                  }`}\n                >\n                  \360\237\237\242 Online\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setOnlineStatus(\'in_game\')}\n                  className={`px-2 py-0.5 text-[10px] font-bold rounded-lg transition-all cursor-pointer ${\n                    onlineStatus === \'in_game\' ? \'bg-amber-500/20 text-amber-300 border border-amber-400/40\' : \'text-slate-500 hover:text-slate-300\'\n                  }`}\n                >\n                  \342\232\224\357\270\217 In-Game\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setOnlineStatus(\'offline\')}\n                  className={`px-2 py-0.5 text-[10px] font-bold rounded-lg transition-all cursor-pointer ${\n                    onlineStatus === \'offline\' ? \'bg-slate-700/50 text-slate-300 border border-slate-600/40\' : \'text-slate-500 hover:text-slate-300\'\n                  }`}\n                >\n                  \342\232\252 Offline\n                </button>\n              </div>\n            </div>\n          </div>\n\n          {/* Primary Action Buttons: Challenge & Add Friend */}\n          <div className=\"flex flex-row sm:flex-col lg:flex-row items-center gap-2.5 w-full sm:w-auto shrink-0 justify-center\">\n            {/* Challenge to Game Button */}\n            <button\n              type=\"button\"\n              onClick={onChallenge}\n              className=\"flex-1 sm:flex-none py-2.5 px-5 rounded-2xl bg-gradient-to-r from-emerald-600 via-emerald-500 to-[#52673A] hover:from-emerald-500 hover:to-[#5f7843] text-white text-xs font-black uppercase tracking-wider flex items-center justify-center gap-2 shadow-lg shadow-emerald-900/30 border border-emerald-400/40 transition-all cursor-pointer hover:scale-105\"\n            >\n              <Swords className=\"w-4 h-4\" />\n              <span>Challenge to Game</span>\n            </button>\n\n            {/* Add Friend Button */}\n            <button\n              type=\"button\"\n              onClick={handleAddFriendClick}\n              className={`flex-1 sm:flex-none py-2.5 px-4 rounded-2xl text-xs font-bold flex items-center justify-center gap-2 border transition-all cursor-pointer shadow-sm ${\n                friendStatus === \'friends\'\n                  ? \'bg-emerald-950/60 text-emerald-300 border-emerald-400/40 hover:bg-emerald-950\'\n                  : friendStatus === \'sent\'\n                  ? \'bg-amber-950/60 text-amber-300 border-amber-400/40\'\n                  : \'bg-slate-800 hover:bg-slate-750 text-white border-slate-700 hover:border-slate-600\'\n              }`}\n            >\n              {friendStatus === \'friends\' ? (\n                <>\n                  <Check className=\"w-4 h-4 text-emerald-400\" />\n                  <span>Friends \342\234\223</span>\n                </>\n              ) : friendStatus === \'sent\' ? (\n                <>\n                  <Activity className=\"w-4 h-4 text-amber-400 animate-spin\" />\n                  <span>Request Sent</span>\n                </>\n              ) : (\n                <>\n                  <UserPlus className=\"w-4 h-4 text-[#F5C453]\" />\n                  <span>Add Friend</span>\n                </>\n              )}\n            </button>\n\n            {/* Share Profile Button */}\n            <button\n              type=\"button\"\n              onClick={handleShareProfile}\n              className=\"p-2.5 rounded-2xl bg-slate-800 hover:bg-slate-750 text-slate-300 hover:text-white border border-slate-700 transition-all cursor-pointer\"\n              title=\"Share profile link\"\n            >\n              {copiedLink ? <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" /> : <Share2 className=\"w-4 h-4\" />}\n            </button>\n\n            {/* Edit Profile Trigger */}\n            {onEditProfileModal && (\n              <button\n                type=\"button\"\n                onClick={onEditProfileModal}\n                className=\"py-2.5 px-3 rounded-2xl bg-white/[0.06] hover:bg-white/[0.12] text-slate-300 hover:text-white text-xs font-bold border border-white/10 transition-all cursor-pointer\"\n              >\n                Edit\n              </button>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* ========================================================================= */}\n      {/* 2. RATINGS CARD (TIME CONTROLS)                                           */}\n      {/* ========================================================================= */}\n      <div className=\"space-y-3\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Trophy className=\"w-4 h-4 text-[#F5C453]\" />\n            <h2 className=\"text-sm font-black uppercase tracking-wider text-slate-200\">\n              Elo Ratings by Time Control\n            </h2>\n          </div>\n          <span className=\"text-[11px] text-slate-400 font-mono\">\n            Overall Rank: <strong className=\"text-emerald-400\">#42 Worldwide</strong>\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5\">\n          {/* Bullet */}\n          <div className=\"p-4 rounded-2xl bg-slate-900/80 border border-slate-700/60 shadow-md hover:border-amber-500/40 transition-all group\">\n            <div className=\"flex items-center justify-between mb-3\">\n              <div className=\"p-2 rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/20 group-hover:scale-110 transition-transform\">\n                <Zap className=\"w-4 h-4\" />\n              </div>\n              <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700 font-mono\">\n                1-2 min\n              </span>\n            </div>\n            <div className=\"text-xs font-bold text-slate-400\">Bullet</div>\n            <div className=\"text-2xl font-black font-mono text-white tracking-tight my-0.5\">\n              {ratingsData.bullet.current}\n            </div>\n            <div className=\"flex items-center justify-between text-[11px] text-slate-400 pt-2 border-t border-slate-800\">\n              <span>Peak: <strong className=\"text-amber-300\">{ratingsData.bullet.peak}</strong></span>\n              <span>{ratingsData.bullet.games} Games</span>\n            </div>\n          </div>\n\n          {/* Blitz */}\n          <div className=\"p-4 rounded-2xl bg-slate-900/80 border border-slate-700/60 shadow-md hover:border-orange-500/40 transition-all group\">\n            <div className=\"flex items-center justify-between mb-3\">\n              <div className=\"p-2 rounded-xl bg-orange-500/10 text-orange-400 border border-orange-500/20 group-hover:scale-110 transition-transform\">\n                <Flame className=\"w-4 h-4\" />\n              </div>\n              <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700 font-mono\">\n                3-5 min\n              </span>\n            </div>\n            <div className=\"text-xs font-bold text-slate-400\">Blitz</div>\n            <div className=\"text-2xl font-black font-mono text-white tracking-tight my-0.5\">\n              {ratingsData.blitz.current}\n            </div>\n            <div className=\"flex items-center justify-between text-[11px] text-slate-400 pt-2 border-t border-slate-800\">\n              <span>Peak: <strong className=\"text-orange-300\">{ratingsData.blitz.peak}</strong></span>\n              <span>{ratingsData.blitz.games} Games</span>\n            </div>\n          </div>\n\n          {/* Rapid */}\n          <div className=\"p-4 rounded-2xl bg-slate-900/80 border border-slate-700/60 shadow-md hover:border-emerald-500/40 transition-all group relative overflow-hidden\">\n            <div className=\"absolute top-0 right-0 w-2 h-2 rounded-bl bg-emerald-400\" />\n            <div className=\"flex items-center justify-between mb-3\">\n              <div className=\"p-2 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 group-hover:scale-110 transition-transform\">\n                <Clock className=\"w-4 h-4\" />\n              </div>\n              <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-950/60 text-emerald-300 border border-emerald-400/30 font-mono\">\n                10-15 min\n              </span>\n            </div>\n            <div className=\"text-xs font-bold text-emerald-300\">Rapid (Primary)</div>\n            <div className=\"text-2xl font-black font-mono text-white tracking-tight my-0.5\">\n              {ratingsData.rapid.current}\n            </div>\n            <div className=\"flex items-center justify-between text-[11px] text-slate-400 pt-2 border-t border-slate-800\">\n              <span>Peak: <strong className=\"text-emerald-300\">{ratingsData.rapid.peak}</strong></span>\n              <span>{ratingsData.rapid.games} Games</span>\n            </div>\n          </div>\n\n          {/* Daily */}\n          <div className=\"p-4 rounded-2xl bg-slate-900/80 border border-slate-700/60 shadow-md hover:border-sky-500/40 transition-all group\">\n            <div className=\"flex items-center justify-between mb-3\">\n              <div className=\"p-2 rounded-xl bg-sky-500/10 text-sky-400 border border-sky-500/20 group-hover:scale-110 transition-transform\">\n                <Sun className=\"w-4 h-4\" />\n              </div>\n              <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700 font-mono\">\n                1-3 days\n              </span>\n            </div>\n            <div className=\"text-xs font-bold text-slate-400\">Daily Correspondence</div>\n            <div className=\"text-2xl font-black font-mono text-white tracking-tight my-0.5\">\n              {ratingsData.daily.current}\n            </div>\n            <div className=\"flex items-center justify-between text-[11px] text-slate-400 pt-2 border-t border-slate-800\">\n              <span>Peak: <strong className=\"text-sky-300\">{ratingsData.daily.peak}</strong></span>\n              <span>{ratingsData.daily.games} Games</span>\n            </div>\n          </div>\n\n          {/* Puzzles */}\n          <div className=\"p-4 rounded-2xl bg-slate-900/80 border border-slate-700/60 shadow-md hover:border-purple-500/40 transition-all group\">\n            <div className=\"flex items-center justify-between mb-3\">\n              <div className=\"p-2 rounded-xl bg-purple-500/10 text-purple-400 border border-purple-500/20 group-hover:scale-110 transition-transform\">\n                <Puzzle className=\"w-4 h-4\" />\n              </div>\n              <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700 font-mono\">\n                Tactics\n              </span>\n            </div>\n            <div className=\"text-xs font-bold text-slate-400\">Puzzles Rating</div>\n            <div className=\"text-2xl font-black font-mono text-white tracking-tight my-0.5\">\n              {ratingsData.puzzles.current}\n            </div>\n            <div className=\"flex items-center justify-between text-[11px] text-slate-400 pt-2 border-t border-slate-800\">\n              <span>Peak: <strong className=\"text-purple-300\">{ratingsData.puzzles.peak}</strong></span>\n              <span>{ratingsData.puzzles.games} Solved</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* ========================================================================= */}\n      {/* 3. INTERACTIVE RATING PROGRESS CHART                                      */}\n      {/* ========================================================================= */}\n      <div className=\"p-5 sm:p-6 rounded-3xl bg-slate-900/85 backdrop-blur-2xl border border-slate-700/60 shadow-[0_15px_40px_rgba(0,0,0,0.6)] space-y-4\">\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"p-1.5 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\">\n              <TrendingUp className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-sm font-black uppercase tracking-wider text-slate-200\">\n                Interactive Rating Progress\n              </h3>\n              <p className=\"text-[11px] text-slate-400\">\n                Performance trajectory and Elo progression over time\n              </p>\n            </div>\n          </div>\n\n          {/* Time Range Filter Buttons */}\n          <div className=\"flex items-center gap-1 bg-slate-950/70 p-1 rounded-xl border border-slate-800 self-stretch sm:self-auto justify-center\">\n            {([\'1W\', \'1M\', \'1Y\', \'ALL\'] as TimeRangeFilter[]).map(tab => (\n              <button\n                key={tab}\n                type=\"button\"\n                onClick={() => setTimeRange(tab)}\n                className={`px-3 py-1 text-xs font-bold rounded-lg transition-all cursor-pointer ${\n                  timeRange === tab\n                    ? \'bg-emerald-500 text-slate-950 font-black shadow-md\'\n                    : \'text-slate-400 hover:text-white\'\n                }`}\n              >\n                {tab}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* SVG Interactive Line Chart Container */}\n        <div className=\"relative w-full overflow-hidden pt-2\">\n          <svg\n            viewBox={`0 0 ${chartWidth} ${chartHeight}`}\n            className=\"w-full h-48 sm:h-64 overflow-visible select-none\"\n          >\n            <defs>\n              {/* Radiant Area Gradient */}\n              <linearGradient id=\"ratingAreaGradient\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                <stop offset=\"0%\" stopColor=\"#10B981\" stopOpacity=\"0.35\" />\n                <stop offset=\"50%\" stopColor=\"#059669\" stopOpacity=\"0.12\" />\n                <stop offset=\"100%\" stopColor=\"#047857\" stopOpacity=\"0.0\" />\n              </linearGradient>\n\n              {/* Stroke Gradient */}\n              <linearGradient id=\"ratingLineGradient\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n                <stop offset=\"0%\" stopColor=\"#34D399\" />\n                <stop offset=\"50%\" stopColor=\"#F5C453\" />\n                <stop offset=\"100%\" stopColor=\"#10B981\" />\n              </linearGradient>\n            </defs>\n\n            {/* Horizontal Gridlines */}\n            {[0, 0.25, 0.5, 0.75, 1].map((ratio, idx) => {\n              const y = paddingY + ratio * (chartHeight - paddingY * 2);\n              const labelRating = Math.round(maxRating - ratio * (maxRating - minRating));\n              return (\n                <g key={idx}>\n                  <line\n                    x1={paddingX}\n                    y1={y}\n                    x2={chartWidth - paddingX}\n                    y2={y}\n                    stroke=\"#334155\"\n                    strokeDasharray=\"4 4\"\n                    strokeOpacity=\"0.4\"\n                  />\n                  <text\n                    x={paddingX - 6}\n                    y={y + 3}\n                    fill=\"#64748B\"\n                    fontSize=\"9\"\n                    fontFamily=\"monospace\"\n                    textAnchor=\"end\"\n                  >\n                    {labelRating}\n                  </text>\n                </g>\n              );\n            })}\n\n            {/* Filled Area */}\n            <path d={areaD} fill=\"url(#ratingAreaGradient)\" />\n\n            {/* Glowing Main Curve */}\n            <path\n              d={pathD}\n              fill=\"none\"\n              stroke=\"url(#ratingLineGradient)\"\n              strokeWidth=\"3\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n              className=\"filter drop-shadow-[0_2px_8px_rgba(16,185,129,0.4)]\"\n            />\n\n            {/* Interactive Data Points */}\n            {points.map((pt, i) => {\n              const isHovered = hoveredPoint?.index === i;\n              const isLast = i === points.length - 1;\n              return (\n                <g key={i}>\n                  <circle\n                    cx={pt.x}\n                    cy={pt.y}\n                    r={isHovered || isLast ? 5 : 3}\n                    fill={isHovered ? \'#FFFFFF\' : \'#10B981\'}\n                    stroke={isHovered ? \'#10B981\' : \'#0F172A\'}\n                    strokeWidth=\"2\"\n                    className=\"cursor-pointer transition-all hover:scale-150\"\n                    onMouseEnter={() => setHoveredPoint({ index: i, x: pt.x, y: pt.y, data: pt.data })}\n                    onMouseLeave={() => setHoveredPoint(null)}\n                  />\n                </g>\n              );\n            })}\n          </svg>\n\n          {/* Interactive Tooltip Card */}\n          {hoveredPoint && (\n            <div\n              className=\"absolute pointer-events-none z-20 -translate-x-1/2 -translate-y-full px-3 py-2 rounded-xl bg-slate-950/95 border border-emerald-500/50 shadow-2xl text-xs space-y-1 animate-in fade-in zoom-in-95 duration-150\"\n              style={{\n                left: `${(hoveredPoint.x / chartWidth) * 100}%`,\n                top: `${(hoveredPoint.y / chartHeight) * 100}%`\n              }}\n            >\n              <div className=\"text-[10px] text-slate-400 font-mono\">\n                {hoveredPoint.data.fullDate}\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-white font-mono font-black text-sm\">\n                  {hoveredPoint.data.rating} Elo\n                </span>\n                <span className={`text-[10px] font-bold px-1.5 py-0.2 rounded ${\n                  hoveredPoint.data.change.startsWith(\'+\') ? \'bg-emerald-500/20 text-emerald-300\' : \'bg-rose-500/20 text-rose-300\'\n                }`}>\n                  {hoveredPoint.data.change}\n                </span>\n              </div>\n              <div className=\"text-[10px] text-slate-400\">\n                vs {hoveredPoint.data.opponent}\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* ========================================================================= */}\n      {/* 4. PLAYER STATS (COLOR BREAKDOWN) & ACHIEVEMENT BADGES                     */}\n      {/* ========================================================================= */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">\n        {/* Win/Loss/Draw by Piece Color (Left 5 Cols) */}\n        <div className=\"lg:col-span-5 p-5 sm:p-6 rounded-3xl bg-slate-900/85 backdrop-blur-2xl border border-slate-700/60 shadow-[0_15px_40px_rgba(0,0,0,0.6)] space-y-4\">\n          <div className=\"flex items-center gap-2\">\n            <PieChart className=\"w-4 h-4 text-emerald-400\" />\n            <h3 className=\"text-sm font-black uppercase tracking-wider text-slate-200\">\n              Color Performance\n            </h3>\n          </div>\n\n          {/* White Piece Performance */}\n          <div className=\"p-3.5 rounded-2xl bg-slate-950/60 border border-slate-800 space-y-2\">\n            <div className=\"flex items-center justify-between text-xs font-bold\">\n              <span className=\"flex items-center gap-1.5 text-white\">\n                <span className=\"text-base\">\342\231\224</span>\n                <span>As White</span>\n              </span>\n              <span className=\"text-emerald-400 font-mono\">64% Win Rate</span>\n            </div>\n            {/* Segmented Progress Bar */}\n            <div className=\"h-3 w-full rounded-full bg-slate-800 overflow-hidden flex shadow-inner\">\n              <div style={{ width: \'64%\' }} className=\"bg-emerald-500 h-full\" title=\"64% Wins\" />\n              <div style={{ width: \'18%\' }} className=\"bg-slate-500 h-full\" title=\"18% Draws\" />\n              <div style={{ width: \'18%\' }} className=\"bg-rose-500 h-full\" title=\"18% Losses\" />\n            </div>\n            <div className=\"flex items-center justify-between text-[10px] text-slate-400 font-mono\">\n              <span className=\"text-emerald-400\">128 Wins</span>\n              <span className=\"text-slate-400\">36 Draws</span>\n              <span className=\"text-rose-400\">36 Losses</span>\n            </div>\n          </div>\n\n          {/* Black Piece Performance */}\n          <div className=\"p-3.5 rounded-2xl bg-slate-950/60 border border-slate-800 space-y-2\">\n            <div className=\"flex items-center justify-between text-xs font-bold\">\n              <span className=\"flex items-center gap-1.5 text-slate-300\">\n                <span className=\"text-base\">\342\231\232</span>\n                <span>As Black</span>\n              </span>\n              <span className=\"text-emerald-400 font-mono\">56% Win Rate</span>\n            </div>\n            {/* Segmented Progress Bar */}\n            <div className=\"h-3 w-full rounded-full bg-slate-800 overflow-hidden flex shadow-inner\">\n              <div style={{ width: \'56%\' }} className=\"bg-emerald-500 h-full\" title=\"56% Wins\" />\n              <div style={{ width: \'22%\' }} className=\"bg-slate-500 h-full\" title=\"22% Draws\" />\n              <div style={{ width: \'22%\' }} className=\"bg-rose-500 h-full\" title=\"22% Losses\" />\n            </div>\n            <div className=\"flex items-center justify-between text-[10px] text-slate-400 font-mono\">\n              <span className=\"text-emerald-400\">104 Wins</span>\n              <span className=\"text-slate-400\">42 Draws</span>\n              <span className=\"text-rose-400\">40 Losses</span>\n            </div>\n          </div>\n\n          {/* Overall Tactical Summary */}\n          <div className=\"p-3 rounded-xl bg-[#52673A]/20 border border-[#F5C453]/30 flex items-center justify-between text-xs\">\n            <div className=\"flex items-center gap-2\">\n              <Target className=\"w-4 h-4 text-[#F5C453]\" />\n              <span className=\"text-slate-300 font-medium\">Avg. Game Accuracy</span>\n            </div>\n            <span className=\"text-white font-mono font-black\">88.4%</span>\n          </div>\n        </div>\n\n        {/* Achievement Badges Grid (Right 7 Cols) */}\n        <div className=\"lg:col-span-7 p-5 sm:p-6 rounded-3xl bg-slate-900/85 backdrop-blur-2xl border border-slate-700/60 shadow-[0_15px_40px_rgba(0,0,0,0.6)] space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-2\">\n              <Award className=\"w-4 h-4 text-amber-400\" />\n              <h3 className=\"text-sm font-black uppercase tracking-wider text-slate-200\">\n                Achievement Badges & Honors\n              </h3>\n            </div>\n            <span className=\"text-[11px] text-[#F5C453] font-bold\">\n              8 / 8 Unlocked (100%)\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2.5\">\n            {achievementBadges.map(badge => (\n              <div\n                key={badge.id}\n                className={`p-3 rounded-2xl bg-gradient-to-b ${badge.color} border flex flex-col items-center text-center space-y-1.5 hover:scale-105 transition-all shadow-md group`}\n              >\n                <span className=\"text-2xl select-none filter drop-shadow group-hover:scale-125 transition-transform\">\n                  {badge.icon}\n                </span>\n                <span className=\"text-xs font-bold leading-tight line-clamp-1\">\n                  {badge.name}\n                </span>\n                <span className=\"text-[9px] text-slate-400 line-clamp-2 leading-tight\">\n                  {badge.desc}\n                </span>\n                <span className=\"text-[8px] font-black uppercase tracking-wider px-1.5 py-0.2 rounded-full bg-black/40 text-slate-300 border border-white/10 mt-auto\">\n                  {badge.rarity}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* ========================================================================= */}\n      {/* 5. RECENT MATCH HISTORY LIST (LAST 10 GAMES)                              */}\n      {/* ========================================================================= */}\n      <div className=\"p-5 sm:p-6 rounded-3xl bg-slate-900/85 backdrop-blur-2xl border border-slate-700/60 shadow-[0_15px_40px_rgba(0,0,0,0.6)] space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"p-1.5 rounded-xl bg-slate-800 text-[#F5C453] border border-slate-700\">\n              <Swords className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-sm font-black uppercase tracking-wider text-slate-200\">\n                Recent Match History (Last 10 Games)\n              </h3>\n              <p className=\"text-[11px] text-slate-400\">\n                Live battle records, Elo fluctuations, and engine accuracy telemetry\n              </p>\n            </div>\n          </div>\n          <span className=\"text-xs text-slate-400 font-mono hidden sm:inline\">\n            Showing 10 Latest Matches\n          </span>\n        </div>\n\n        {/* Matches Table / List */}\n        <div className=\"space-y-2\">\n          {recentMatches.map((match, idx) => {\n            const isWin = match.result === \'win\';\n            const isLoss = match.result === \'loss\';\n            const isDraw = match.result === \'draw\';\n\n            return (\n              <div\n                key={match.id}\n                className=\"p-3.5 rounded-2xl bg-slate-950/70 hover:bg-slate-950 border border-slate-800/80 hover:border-slate-700 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3.5 group shadow-sm\"\n              >\n                {/* Result Badge + Opponent Info */}\n                <div className=\"flex items-center gap-3 min-w-0\">\n                  {/* Result Badge */}\n                  <div\n                    className={`w-14 py-1 rounded-xl text-center font-black text-xs uppercase tracking-wider border shrink-0 ${\n                      isWin\n                        ? \'bg-emerald-500/20 text-emerald-300 border-emerald-500/40 shadow-sm shadow-emerald-950\'\n                        : isLoss\n                        ? \'bg-rose-500/20 text-rose-300 border-rose-500/40 shadow-sm shadow-rose-950\'\n                        : \'bg-slate-700/30 text-slate-300 border-slate-600/40\'\n                    }`}\n                  >\n                    {isWin ? \'WIN\' : isLoss ? \'LOSS\' : \'DRAW\'}\n                  </div>\n\n                  {/* Opponent Avatar & Details */}\n                  <div className=\"flex items-center gap-2.5 min-w-0\">\n                    {match.opponentAvatar.startsWith(\'http\') ? (\n                      <img\n                        src={match.opponentAvatar}\n                        alt={match.opponentName}\n                        className=\"w-9 h-9 rounded-xl object-cover border border-slate-700 shrink-0\"\n                        referrerPolicy=\"no-referrer\"\n                      />\n                    ) : (\n                      <div className=\"w-9 h-9 rounded-xl bg-slate-800 text-lg flex items-center justify-center border border-slate-700 shrink-0\">\n                        {match.opponentAvatar}\n                      </div>\n                    )}\n\n                    <div className=\"truncate\">\n                      <div className=\"text-xs font-bold text-white flex items-center gap-1.5 truncate\">\n                        <span className=\"truncate\">{match.opponentName}</span>\n                        <span className=\"text-[10px] text-slate-400 font-mono\">({match.opponentRating})</span>\n                      </div>\n                      <div className=\"text-[10px] text-slate-400 flex items-center gap-1.5 mt-0.5\">\n                        <span className=\"font-mono\">{match.timeControl}</span>\n                        <span>\342\200\242</span>\n                        <span className=\"text-[#DFD0B0]/70 truncate\">{match.openingName}</span>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Rating Change & Accuracy Meter + Actions */}\n                <div className=\"flex items-center justify-between sm:justify-end gap-4 w-full sm:w-auto shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-800/60\">\n                  {/* Rating Change */}\n                  <div className=\"text-right\">\n                    <div\n                      className={`text-xs font-black font-mono ${\n                        match.ratingChange > 0\n                          ? \'text-emerald-400\'\n                          : match.ratingChange < 0\n                          ? \'text-rose-400\'\n                          : \'text-slate-400\'\n                      }`}\n                    >\n                      {match.ratingChange > 0 ? `+${match.ratingChange}` : match.ratingChange}\n                    </div>\n                    <div className=\"text-[9px] text-slate-500\">{match.date}</div>\n                  </div>\n\n                  {/* Accuracy Badge */}\n                  <div className=\"flex items-center gap-1.5 bg-slate-900 px-2.5 py-1 rounded-xl border border-slate-800\">\n                    <Target className=\"w-3 h-3 text-[#F5C453]\" />\n                    <span className=\"text-[11px] font-bold font-mono text-slate-200\">\n                      {match.accuracy}% acc\n                    </span>\n                  </div>\n\n                  {/* Analyze / Replay Action Button */}\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      if (onAnalyzeGame) {\n                        onAnalyzeGame(match.pgn, match.fen);\n                      }\n                    }}\n                    className=\"py-1.5 px-3 rounded-xl bg-slate-800 hover:bg-[#52673A] text-white hover:text-[#F5C453] text-[11px] font-bold border border-slate-700 hover:border-[#F5C453]/40 flex items-center gap-1.5 transition-all cursor-pointer shadow-sm group-hover:border-slate-600\"\n                    title=\"Analyze and replay match in engine\"\n                  >\n                    <Compass className=\"w-3.5 h-3.5 text-[#F5C453]\" />\n                    <span>Analyze Game</span>\n                  </button>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* AI Chess Avatar Studio Modal */}\n      {isAvatarModalOpen && (\n        <ChessAvatarModal\n          isOpen={isAvatarModalOpen}\n          onClose={() => setIsAvatarModalOpen(false)}\n        />\n      )}\n    </div>\n  );\n};\n"
