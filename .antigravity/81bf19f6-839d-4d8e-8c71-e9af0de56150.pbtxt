  file_change {
    absolute_path_uri: "file:///src/components/Header.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { GameMode, RespectProfile } from \'../types/chess\';\nimport {\n  Bot,\n  Users,\n  Sparkles,\n  Compass,\n  Settings,\n  Crown,\n  Plus,\n  Palette,\n  Trophy,\n  Shield,\n  User,\n  Globe,\n  Zap,\n  Sun,\n  Flame,\n  Menu,\n  X,\n  ChevronDown,\n  Layers,\n  Award\n} from \'lucide-react\';\nimport { useAuth } from \'../context/AuthContext\';\n\ninterface HeaderProps {\n  activeMode: GameMode;\n  onSelectMode: (mode: GameMode) => void;\n  onOpenSettings: () => void;\n  onOpenThemes?: () => void;\n  onOpenLeaderboard?: () => void;\n  onOpenProfile?: () => void;\n  onOpenFriends?: () => void;\n  onOpenWorldwideMatch?: () => void;\n  onNewGame: () => void;\n  respectProfile?: RespectProfile;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  activeMode,\n  onSelectMode,\n  onOpenSettings,\n  onOpenThemes,\n  onOpenLeaderboard,\n  onOpenProfile,\n  onOpenFriends,\n  onOpenWorldwideMatch,\n  onNewGame,\n  respectProfile\n}) => {\n  const { user, profile } = useAuth();\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);\n  const menuRef = useRef<HTMLDivElement>(null);\n\n  // Close mobile menu on click outside\n  useEffect(() => {\n    const handleClickOutside = (event: MouseEvent) => {\n      if (menuRef.current && !menuRef.current.contains(event.target as Node)) {\n        setIsMobileMenuOpen(false);\n      }\n    };\n    if (isMobileMenuOpen) {\n      document.addEventListener(\'mousedown\', handleClickOutside);\n    }\n    return () => {\n      document.removeEventListener(\'mousedown\', handleClickOutside);\n    };\n  }, [isMobileMenuOpen]);\n\n  const navItems: { mode: GameMode; label: string; shortLabel: string; icon: React.ReactNode; badge?: string }[] = [\n    { mode: \'ai\', label: \'Play AI\', shortLabel: \'AI\', icon: <Bot className=\"w-4 h-4\" /> },\n    { mode: \'daily_puzzle\', label: \'Daily Mission\', shortLabel: \'Daily\', icon: <Sun className=\"w-4 h-4 text-[#F5C453]\" />, badge: \'24h\' },\n    { mode: \'puzzle\', label: \'Tactics\', shortLabel: \'Tactics\', icon: <Sparkles className=\"w-4 h-4 text-amber-300\" /> },\n    { mode: \'pass_and_play\', label: \'Pass & Play\', shortLabel: \'P&P\', icon: <Users className=\"w-4 h-4\" /> },\n    { mode: \'analysis\', label: \'Analysis\', shortLabel: \'Analyze\', icon: <Compass className=\"w-4 h-4\" /> }\n  ];\n\n  const currentRespect = profile?.respectPoints ?? respectProfile?.respectPoints ?? 100;\n  const userDisplayName = profile?.displayName || user?.displayName?.split(\' \')[0] || (user ? \'Warrior\' : \'Guest\');\n\n  return (\n    <header className=\"w-full bg-[#10140e]/95 border-b border-[#F5C453]/25 backdrop-blur-2xl sticky top-0 z-40 shadow-2xl shadow-black/60 transition-all\">\n      {/* Primary Header Row */}\n      <div className=\"max-w-7xl mx-auto px-3 sm:px-4 lg:px-6 py-2 sm:py-2.5\">\n        <div className=\"flex items-center justify-between gap-2 sm:gap-3 md:gap-4\">\n          \n          {/* ========================================================================= */}\n          {/* PANEL 1: Brand & Citadel Identity (Left)                                  */}\n          {/* ========================================================================= */}\n          <div className=\"flex items-center gap-2.5 sm:gap-3 flex-shrink-0\">\n            {/* Kurdish Sun of Glory Crest */}\n            <div\n              onClick={() => onSelectMode(\'ai\')}\n              className=\"relative w-9 h-9 sm:w-10 sm:h-10 rounded-2xl bg-gradient-to-tr from-[#8C2425] via-[#52673A] to-[#F5C453] p-0.5 shadow-lg shadow-[#F5C453]/20 border border-[#F5C453]/40 flex-shrink-0 cursor-pointer hover:scale-105 transition-transform\"\n              title=\"Chesskys - Peshmerga Edition\"\n            >\n              <div className=\"w-full h-full bg-[#161c12] rounded-[14px] flex items-center justify-center text-base sm:text-lg select-none\">\n                <span title=\"Kurdish 21-Ray Sun of Glory\">\342\230\200\357\270\217</span>\n              </div>\n            </div>\n\n            {/* Brand Titles & Database Status Indicator */}\n            <div className=\"flex flex-col\">\n              <div className=\"flex items-center gap-1.5 sm:gap-2 leading-none\">\n                <button\n                  onClick={() => onSelectMode(\'ai\')}\n                  className=\"font-heading font-black text-[#FDFCF7] text-base sm:text-lg tracking-tight hover:text-[#F5C453] transition-colors text-left cursor-pointer\"\n                >\n                  Chesskys\n                </button>\n                {/* Jamadani Crimson Red PRO Badge */}\n                <span className=\"text-[9px] sm:text-[10px] font-black px-1.5 sm:px-2 py-0.5 rounded-full bg-[#8C2425] text-white border border-[#F5C453]/40 shadow-sm uppercase tracking-wider\">\n                  PRO\n                </span>\n              </div>\n              \n              <div className=\"flex items-center gap-1.5 mt-0.5\">\n                <span className=\"text-[10px] sm:text-[11px] text-[#DFD0B0]/70 font-medium hidden sm:inline\">\n                  Peshmerga Edition\n                </span>\n                <span\n                  className=\"hidden md:inline-flex items-center gap-1 text-[9px] font-bold text-emerald-400/90 font-mono bg-emerald-950/40 px-1.5 py-0.2 rounded-md border border-emerald-500/20\"\n                  title=\"Live Database Connected (Firestore)\"\n                >\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse inline-block\" />\n                  <span>DB Live</span>\n                </span>\n              </div>\n            </div>\n          </div>\n\n          {/* ========================================================================= */}\n          {/* PANEL 2: Mode Navigation Tabs (Desktop & Laptop Center View)             */}\n          {/* ========================================================================= */}\n          <nav className=\"hidden lg:flex items-center gap-1 bg-[#1a2315]/80 p-1.5 rounded-2xl border border-[#F5C453]/25 backdrop-blur-md shadow-inner shadow-black/40\">\n            {navItems.map(item => {\n              const isActive = activeMode === item.mode;\n              return (\n                <button\n                  key={item.mode}\n                  onClick={() => onSelectMode(item.mode)}\n                  className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold font-ui transition-all cursor-pointer whitespace-nowrap ${\n                    isActive\n                      ? \'bg-[#52673A] text-white shadow-md shadow-[#52673A]/40 border border-[#F5C453]/60\'\n                      : \'text-[#DFD0B0]/75 hover:text-white hover:bg-white/[0.08]\'\n                  }`}\n                >\n                  {item.icon}\n                  <span>{item.label}</span>\n                  {item.badge && (\n                    <span className=\"text-[9px] font-black px-1.5 py-0.2 rounded bg-[#F5C453]/20 text-[#F5C453] border border-[#F5C453]/40 uppercase tracking-wide\">\n                      {item.badge}\n                    </span>\n                  )}\n                </button>\n              );\n            })}\n\n            {/* Worldwide Quick Match Nav Item */}\n            {onOpenWorldwideMatch && (\n              <button\n                onClick={onOpenWorldwideMatch}\n                className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-black font-ui transition-all cursor-pointer whitespace-nowrap ${\n                  activeMode === \'online_match\'\n                    ? \'bg-gradient-to-r from-[#52673A] to-[#8C2425] text-white border border-[#F5C453] shadow-md shadow-[#F5C453]/20\'\n                    : \'bg-emerald-950/50 text-emerald-300 hover:bg-emerald-900/60 border border-emerald-500/30\'\n                }`}\n                title=\"Worldwide Online Quick Match (Instant Pairing)\"\n              >\n                <Globe className=\"w-3.5 h-3.5 text-[#F5C453] animate-pulse\" />\n                <span>Worldwide</span>\n              </button>\n            )}\n          </nav>\n\n          {/* ========================================================================= */}\n          {/* PANEL 3: Actions, Honor, Social, Profile & Settings (Right)               */}\n          {/* ========================================================================= */}\n          <div className=\"flex items-center gap-1.5 sm:gap-2\">\n            \n            {/* Worldwide Quick Match Action Button (Prominent on Tablet & Desktop) */}\n            {onOpenWorldwideMatch && (\n              <button\n                onClick={onOpenWorldwideMatch}\n                className=\"hidden sm:flex md:hidden xl:flex items-center gap-1.5 py-1.5 px-2.5 sm:px-3 rounded-xl bg-gradient-to-r from-emerald-700/90 to-[#52673A] hover:brightness-110 border border-emerald-400/50 text-white text-xs font-black transition-all hover:scale-105 shadow-md shadow-emerald-500/15 cursor-pointer whitespace-nowrap\"\n                title=\"Find a worldwide live match\"\n              >\n                <Zap className=\"w-3.5 h-3.5 text-[#F5C453]\" />\n                <span className=\"hidden xl:inline\">Quick Match</span>\n                <span className=\"xl:hidden\">Match</span>\n              </button>\n            )}\n\n            {/* Friends & Social Hub Button */}\n            {onOpenFriends && (\n              <button\n                onClick={onOpenFriends}\n                className=\"hidden sm:flex items-center gap-1.5 py-1.5 px-2.5 rounded-xl bg-gradient-to-r from-[#52673A]/60 to-[#8C2425]/60 hover:brightness-110 border border-[#F5C453]/40 text-white text-xs font-bold transition-all hover:scale-[1.02] shadow-sm cursor-pointer whitespace-nowrap\"\n                title=\"Open Friends & Social Panel\"\n              >\n                <Users className=\"w-3.5 h-3.5 text-[#F5C453]\" />\n                <span className=\"hidden md:inline\">Friends</span>\n              </button>\n            )}\n\n            {/* Peshmerga Respect Honor Pill */}\n            <button\n              onClick={onOpenLeaderboard}\n              className=\"flex items-center gap-1.5 py-1.5 px-2 sm:px-3 rounded-xl bg-gradient-to-r from-[#52673A]/40 to-[#8C2425]/40 hover:from-[#52673A]/60 hover:to-[#8C2425]/60 border border-[#F5C453]/40 text-[#F5C453] text-xs font-black transition-all hover:scale-[1.02] shadow-sm shadow-[#F5C453]/10 cursor-pointer whitespace-nowrap\"\n              title=\"Click to view Peshmerga Honor & Grandmaster Leaderboard\"\n            >\n              <span className=\"text-sm select-none\">\342\234\212</span>\n              <span className=\"font-mono\">{currentRespect}</span>\n              <span className=\"hidden md:inline text-[10px] text-[#DFD0B0]/80 uppercase font-semibold\">Respect</span>\n            </button>\n\n            {/* Profile / Account Avatar Pill */}\n            <button\n              onClick={onOpenProfile}\n              className=\"flex items-center gap-1.5 py-1.5 px-2 sm:px-2.5 rounded-xl bg-white/[0.06] hover:bg-white/[0.12] border border-[#F5C453]/30 text-white transition-all shadow-sm cursor-pointer\"\n              title={user ? `Signed in as ${userDisplayName}` : \'Sign in / Profile Settings\'}\n            >\n              {(profile?.photoURL || user?.photoURL) ? (\n                <img\n                  src={profile?.photoURL || user?.photoURL}\n                  alt={userDisplayName}\n                  className=\"w-5 h-5 rounded-full object-cover border border-[#F5C453]\"\n                  referrerPolicy=\"no-referrer\"\n                />\n              ) : (\n                <User className=\"w-4 h-4 text-[#F5C453]\" />\n              )}\n              <span className=\"text-xs font-bold hidden md:inline max-w-[70px] lg:max-w-[90px] truncate text-[#DFD0B0]\">\n                {userDisplayName}\n              </span>\n            </button>\n\n            {/* New Match Action Button */}\n            <button\n              onClick={onNewGame}\n              className=\"hidden md:flex items-center gap-1.5 py-1.5 px-3 rounded-xl bg-[#52673A] hover:bg-[#52673A]/90 border border-[#F5C453]/50 text-white font-bold text-xs transition-all hover:scale-[1.02] active:scale-[0.98] shadow-md shadow-[#52673A]/30 cursor-pointer whitespace-nowrap\"\n              title=\"Start New Chess Game\"\n            >\n              <Plus className=\"w-3.5 h-3.5 text-[#F5C453]\" />\n              <span>New Match</span>\n            </button>\n\n            {/* Settings & Themes Gear */}\n            <button\n              onClick={onOpenSettings}\n              className=\"flex items-center gap-1.5 py-1.5 px-2 sm:px-2.5 rounded-xl bg-[#52673A]/30 hover:bg-[#52673A]/70 text-[#FDFCF7] border border-[#F5C453]/35 transition-all shadow-sm text-xs font-bold hover:scale-[1.02] active:scale-[0.98] cursor-pointer\"\n              title=\"Settings, Themes, Board & Piece Sets\"\n            >\n              <Settings className=\"w-4 h-4 text-[#F5C453]\" />\n              <span className=\"hidden xl:inline\">Settings</span>\n            </button>\n\n            {/* Mobile / Tablet Menu Toggle (Visible below lg) */}\n            <button\n              onClick={() => setIsMobileMenuOpen(prev => !prev)}\n              className=\"lg:hidden flex items-center justify-center p-1.5 rounded-xl bg-white/[0.08] hover:bg-white/[0.15] border border-white/20 text-white transition-all cursor-pointer\"\n              aria-label=\"Toggle Quick Navigation Menu\"\n            >\n              {isMobileMenuOpen ? <X className=\"w-4 h-4 text-[#F5C453]\" /> : <Menu className=\"w-4 h-4 text-[#DFD0B0]\" />}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* ========================================================================= */}\n      {/* SECONDARY RESPONSIVE SUB-NAV BAR (Mobile & Tablet Screen View)            */}\n      {/* ========================================================================= */}\n      <div className=\"lg:hidden border-t border-white/10 bg-[#141a12]/95 px-3 py-1.5 overflow-x-auto no-scrollbar\">\n        <div className=\"flex items-center gap-1.5 min-w-max mx-auto justify-start sm:justify-center\">\n          {navItems.map(item => {\n            const isActive = activeMode === item.mode;\n            return (\n              <button\n                key={item.mode}\n                onClick={() => onSelectMode(item.mode)}\n                className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold font-ui transition-all cursor-pointer shrink-0 ${\n                  isActive\n                    ? \'bg-[#52673A] text-white shadow-md border border-[#F5C453]/60\'\n                    : \'text-[#DFD0B0]/75 hover:text-white hover:bg-white/[0.08] bg-black/20 border border-white/5\'\n                }`}\n              >\n                {item.icon}\n                <span>{item.shortLabel}</span>\n                {item.badge && (\n                  <span className=\"text-[9px] font-black px-1.5 py-0.2 rounded bg-[#F5C453]/25 text-[#F5C453] border border-[#F5C453]/40 uppercase\">\n                    {item.badge}\n                  </span>\n                )}\n              </button>\n            );\n          })}\n\n          {/* Worldwide Match item in mobile sub-bar */}\n          {onOpenWorldwideMatch && (\n            <button\n              onClick={onOpenWorldwideMatch}\n              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-black font-ui transition-all cursor-pointer shrink-0 ${\n                activeMode === \'online_match\'\n                  ? \'bg-gradient-to-r from-[#52673A] to-[#8C2425] text-white border border-[#F5C453]\'\n                  : \'bg-emerald-950/60 text-emerald-300 hover:bg-emerald-900/70 border border-emerald-500/30\'\n              }`}\n            >\n              <Globe className=\"w-3.5 h-3.5 text-[#F5C453] animate-pulse\" />\n              <span>Worldwide</span>\n            </button>\n          )}\n\n          {/* New Match Quick CTA in mobile sub-bar */}\n          <button\n            onClick={onNewGame}\n            className=\"flex items-center gap-1 px-3 py-1.5 rounded-xl bg-[#8C2425]/70 hover:bg-[#8C2425] text-white text-xs font-bold border border-[#F5C453]/40 shrink-0 cursor-pointer\"\n          >\n            <Plus className=\"w-3 h-3 text-[#F5C453]\" />\n            <span>New</span>\n          </button>\n        </div>\n      </div>\n\n      {/* ========================================================================= */}\n      {/* MOBILE FLOATING QUICK ACTION DRAWER / DROPDOWN                            */}\n      {/* ========================================================================= */}\n      {isMobileMenuOpen && (\n        <div\n          ref={menuRef}\n          className=\"lg:hidden absolute top-full left-0 right-0 bg-[#12170f]/98 border-b border-[#F5C453]/30 backdrop-blur-2xl shadow-2xl p-4 animate-in slide-in-from-top-2 duration-200 z-50\"\n        >\n          <div className=\"max-w-md mx-auto space-y-3\">\n            <div className=\"flex items-center justify-between pb-2 border-b border-white/10\">\n              <span className=\"text-xs font-bold uppercase tracking-wider text-[#DFD0B0]/60\">\n                Peshmerga Command Panel\n              </span>\n              <button\n                onClick={() => setIsMobileMenuOpen(false)}\n                className=\"p-1 rounded-lg hover:bg-white/10 text-white/60 hover:text-white cursor-pointer\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            {/* Quick Action Grid */}\n            <div className=\"grid grid-cols-2 gap-2\">\n              <button\n                onClick={() => {\n                  setIsMobileMenuOpen(false);\n                  onNewGame();\n                }}\n                className=\"p-3 rounded-2xl bg-gradient-to-r from-[#52673A] to-[#8C2425] text-white font-bold text-xs flex items-center gap-2 border border-[#F5C453]/40 shadow-sm cursor-pointer\"\n              >\n                <Plus className=\"w-4 h-4 text-[#F5C453]\" />\n                <div className=\"text-left\">\n                  <div className=\"font-black\">New Match</div>\n                  <div className=\"text-[10px] text-white/70\">AI, Time & Color</div>\n                </div>\n              </button>\n\n              {onOpenWorldwideMatch && (\n                <button\n                  onClick={() => {\n                    setIsMobileMenuOpen(false);\n                    onOpenWorldwideMatch();\n                  }}\n                  className=\"p-3 rounded-2xl bg-emerald-950/70 border border-emerald-500/40 text-emerald-200 font-bold text-xs flex items-center gap-2 shadow-sm cursor-pointer\"\n                >\n                  <Globe className=\"w-4 h-4 text-[#F5C453]\" />\n                  <div className=\"text-left\">\n                    <div className=\"font-black text-white\">Worldwide Arena</div>\n                    <div className=\"text-[10px] text-emerald-300/80\">Live Matchmaking</div>\n                  </div>\n                </button>\n              )}\n\n              {onOpenFriends && (\n                <button\n                  onClick={() => {\n                    setIsMobileMenuOpen(false);\n                    onOpenFriends();\n                  }}\n                  className=\"p-3 rounded-2xl bg-white/[0.05] hover:bg-white/[0.10] border border-white/15 text-white font-bold text-xs flex items-center gap-2 cursor-pointer\"\n                >\n                  <Users className=\"w-4 h-4 text-[#F5C453]\" />\n                  <div className=\"text-left\">\n                    <div>Friends & Social</div>\n                    <div className=\"text-[10px] text-[#DFD0B0]/60\">Challenges & Chat</div>\n                  </div>\n                </button>\n              )}\n\n              {onOpenLeaderboard && (\n                <button\n                  onClick={() => {\n                    setIsMobileMenuOpen(false);\n                    onOpenLeaderboard();\n                  }}\n                  className=\"p-3 rounded-2xl bg-white/[0.05] hover:bg-white/[0.10] border border-white/15 text-white font-bold text-xs flex items-center gap-2 cursor-pointer\"\n                >\n                  <Trophy className=\"w-4 h-4 text-amber-400\" />\n                  <div className=\"text-left\">\n                    <div>Grandmasters</div>\n                    <div className=\"text-[10px] text-[#DFD0B0]/60\">Respect Leaderboard</div>\n                  </div>\n                </button>\n              )}\n\n              {onOpenProfile && (\n                <button\n                  onClick={() => {\n                    setIsMobileMenuOpen(false);\n                    onOpenProfile();\n                  }}\n                  className=\"p-3 rounded-2xl bg-white/[0.05] hover:bg-white/[0.10] border border-white/15 text-white font-bold text-xs flex items-center gap-2 cursor-pointer\"\n                >\n                  <User className=\"w-4 h-4 text-[#F5C453]\" />\n                  <div className=\"text-left\">\n                    <div>Warrior Profile</div>\n                    <div className=\"text-[10px] text-[#DFD0B0]/60\">{userDisplayName}</div>\n                  </div>\n                </button>\n              )}\n\n              <button\n                onClick={() => {\n                  setIsMobileMenuOpen(false);\n                  onOpenSettings();\n                }}\n                className=\"p-3 rounded-2xl bg-white/[0.05] hover:bg-white/[0.10] border border-white/15 text-white font-bold text-xs flex items-center gap-2 cursor-pointer\"\n              >\n                <Palette className=\"w-4 h-4 text-[#F5C453]\" />\n                <div className=\"text-left\">\n                  <div>Themes & Board</div>\n                  <div className=\"text-[10px] text-[#DFD0B0]/60\">Customize Sound & Pieces</div>\n                </div>\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
    }
