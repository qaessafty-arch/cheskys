       {/* Pedestal Base */}\n                <path d=\"M 10 39.5 L 35 39.5 L 33 36 L 12 36 Z\" fill=\"#18181B\" stroke=\"#22C55E\" strokeWidth=\"1.4\" />\n                {/* Half Purple / Half Green Suited Silhouette */}\n                <path\n                  d=\"M 14 36 C 13 30 15 26 17 24 C 16 22 13 19 13 15 C 13 10 18 6 22.5 5 C 27 6 32 10 32 15 C 32 19 29 22 28 24 C 30 26 32 30 31 36 Z\"\n                  fill=\"url(#joker-purple)\"\n                  stroke=\"#22C55E\"\n                  strokeWidth=\"1.5\"\n                />\n                {/* Left Split Lapel in Riddler Toxic Green */}\n                <path d=\"M 14 36 C 13 30 15 26 17 24 L 22.5 22 L 22.5 36 Z\" fill=\"url(#joker-toxic-green)\" />\n                {/* Large Golden Riddler Question Mark Cane */}\n                <path\n                  d=\"M 20 14 C 20 10 25 10 25 13 C 25 16 22.5 17 22.5 20 M 22.5 23 L 22.5 24.5\"\n                  stroke=\"#FACC15\"\n                  strokeWidth=\"2.4\"\n                  fill=\"none\"\n                />\n                {/* Two-Face Scarred Eye & Riddler Eye */}\n                <circle cx=\"18\" cy=\"14\" r=\"1.4\" fill=\"#EF4444\" />\n                <circle cx=\"27\" cy=\"14\" r=\"1.4\" fill=\"#4ADE80\" />\n                {/* Bowler Hat Finial */}\n                <circle cx=\"22.5\" cy=\"4\" r=\"2.2\" fill=\"#FACC15\" stroke=\"#18181B\" strokeWidth=\"1\" />\n              </g>\n            )}\n\n            {/* BLACK ROOK: Arkham Asylum (Fortified Gothic Asylum Gate & Gargoyles) */}\n            {type === \'r\' && (\n              <g strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                {/* Heavy Asylum Foundation */}\n                <path d=\"M 8 39.5 L 37 39.5 L 35 34 L 10 34 Z\" fill=\"#09090B\" stroke=\"#A855F7\" strokeWidth=\"1.4\" />\n                {/* Gothic Asylum Stone Spire */}\n                <path d=\"M 12 34 L 13 16 L 32 16 L 33 34 Z\" fill=\"url(#arkham-stone-dark)\" stroke=\"#A855F7\" strokeWidth=\"1.6\" />\n                {/* Iron Prison Gate Bars & Jagged Turrets */}\n                <path\n                  d=\"M 9 16 L 9 8 L 13 8 L 13 11 L 18 11 L 18 8 L 27 8 L 27 11 L 32 11 L 32 8 L 36 8 L 36 16 Z\"\n                  fill=\"#18181B\"\n                  stroke=\"#A855F7\"\n                  strokeWidth=\"1.5\"\n                />\n                {/* Wrought Iron Gate Cell Bars */}\n                <path d=\"M 16 22 L 16 34 M 20 22 L 20 34 M 25 22 L 25 34 M 29 22 L 29 34\" stroke=\"#DC2626\" strokeWidth=\"1.4\" />\n                <path d=\"M 14 26 L 31 26 M 14 30 L 31 30\" stroke=\"#71717A\" strokeWidth=\"1\" />\n                {/* Glowing Purple Arkham Emblem Archway */}\n                <path d=\"M 16 22 C 16 18 29 18 29 22 Z\" fill=\"#6B21A8\" stroke=\"#A855F7\" strokeWidth=\"1\" />\n                <path d=\"M 11 34.5 L 34 34.5\" stroke=\"#A855F7\" strokeWidth=\"2.2\" />\n              </g>\n            )}\n\n            {/* BLACK QUEEN: Harley Quinn (Jester Split Cap, Giant Mallet & Diamond Card) */}\n            {type === \'q\' && (\n              <g strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                {/* Pedestal Base */}\n                <path d=\"M 10 39.5 L 35 39.5 C 35 36 33 34 31 32 L 14 32 C 12 34 10 36 10 39.5 Z\" fill=\"#18181B\" stroke=\"#DC2626\" strokeWidth=\"1.5\" />\n                {/* Bicolor Corset (Split Crimson & Pitch Black) */}\n                <path d=\"M 13 32 C 12 25 15 21 22.5 20 L 22.5 32 Z\" fill=\"url(#harley-crimson)\" />\n                <path d=\"M 22.5 20 C 30 21 33 25 32 32 L 22.5 32 Z\" fill=\"#18181B\" stroke=\"#DC2626\" strokeWidth=\"1.2\" />\n                {/* Oversized Harley Mallet Head */}\n                <rect x=\"7\" y=\"11\" width=\"8\" height=\"12\" rx=\"2\" fill=\"#78350F\" stroke=\"#FACC15\" strokeWidth=\"1\" transform=\"rotate(-15 11 17)\" />\n                <path d=\"M 14 22 L 22 28\" stroke=\"#D97706\" strokeWidth=\"2\" />\n                {/* Classic Bicolor Jester Cowl with Hanging Bell