          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const neonGlow = isWhite ? \'#0284C7\' : \'#BE185D\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
