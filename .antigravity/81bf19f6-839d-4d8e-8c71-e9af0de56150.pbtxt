      target_content: "    const seedDefaultDocs = async () => {\n      try {\n        const skyDocRef = doc(db, \'users\', SKY_PROFILE_DEFAULT.uid);\n        const skySnap = await getDoc(skyDocRef);\n        if (!skySnap.exists()) {\n          await setDoc(skyDocRef, {\n            ...SKY_PROFILE_DEFAULT,\n            createdAt: serverTimestamp(),\n            updatedAt: serverTimestamp()\n          });\n        }\n      } catch (err) {\n        console.warn(\'Cloud seed for sky account note:\', err);\n      }\n    };"
      replacement_content: "    const seedDefaultDocs = async () => {\n      try {\n        if (!auth.currentUser) return;\n        const skyDocRef = doc(db, \'users\', SKY_PROFILE_DEFAULT.uid);\n        const skySnap = await getDoc(skyDocRef);\n        if (!skySnap.exists()) {\n          await setDoc(skyDocRef, {\n            ...SKY_PROFILE_DEFAULT,\n            createdAt: serverTimestamp(),\n            updatedAt: serverTimestamp()\n          });\n        }\n      } catch (err) {\n        // Silent catch for background seeding\n      }\n    };"
    }
