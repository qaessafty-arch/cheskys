{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with ELO, respect, role, and badge number",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "country": { "type": "string", "maxLength": 100 },
        "flag": { "type": "string", "maxLength": 20 },
        "elo": { "type": "number" },
        "respectPoints": { "type": "number" },
        "executions": { "type": "number" },
        "merciesGranted": { "type": "number" },
        "gamesPlayed": { "type": "number" },
        "wins": { "type": "number" },
        "honorRank": { "type": "string", "maxLength": 100 },
        "rankBadge": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["owner", "developer", "admin", "grandmaster", "moderator", "member"] },
        "badgeNumber": { "type": "number" },
        "customStatus": { "type": "string", "maxLength": 300 },
        "dailyStreak": { "type": "number" },
        "lastDailySolved": { "type": "string", "maxLength": 20 }
      },
      "required": ["uid", "displayName", "elo", "respectPoints"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Friend request invitation between players",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fromUserId": { "type": "string", "maxLength": 128 },
        "fromUserName": { "type": "string", "maxLength": 100 },
        "fromUsername": { "type": "string", "maxLength": 50 },
        "fromUserAvatar": { "type": "string", "maxLength": 1000 },
        "fromUserElo": { "type": "number" },
        "fromUserHonorRank": { "type": "string", "maxLength": 100 },
        "toUserId": { "type": "string", "maxLength": 128 },
        "toUsername": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "fromUserId", "toUserId", "status"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Private chat message between friends",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "chatId": { "type": "string", "maxLength": 256 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderAvatar": { "type": "string", "maxLength": 1000 },
        "senderBadge": { "type": "string", "maxLength": 50 },
        "text": { "type": "string", "maxLength": 2000 },
        "challengeId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "chatId", "senderId", "text"]
    },
    "OnlineMatch": {
      "title": "OnlineMatch",
      "description": "Real-time 2-player chess game session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "whitePlayerId": { "type": "string", "maxLength": 128 },
        "whitePlayerName": { "type": "string", "maxLength": 100 },
        "whitePlayerAvatar": { "type": "string", "maxLength": 1000 },
        "blackPlayerId": { "type": "string", "maxLength": 128 },
        "blackPlayerName": { "type": "string", "maxLength": 100 },
        "blackPlayerAvatar": { "type": "string", "maxLength": 1000 },
        "fen": { "type": "string", "maxLength": 200 },
        "pgn": { "type": "string", "maxLength": 10000 },
        "turn": { "type": "string", "enum": ["w", "b"] },
        "status": { "type": "string", "enum": ["waiting", "in_progress", "completed", "aborted"] },
        "winner": { "type": "string", "enum": ["w", "b", "draw", "none"] },
        "reason": { "type": "string", "maxLength": 200 },
        "timeControlName": { "type": "string", "maxLength": 50 },
        "whiteSeconds": { "type": "number" },
        "blackSeconds": { "type": "number" }
      },
      "required": ["id", "fen", "status", "turn"]
    },
    "UserFeedback": {
      "title": "UserFeedback",
      "description": "Feedback submitted by users for developer review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "userName": { "type": "string", "maxLength": 100 },
        "userBadge": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "enum": ["feature", "bug", "chess_engine", "theme_lore", "general"] },
        "rating": { "type": "number" },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "resolved"] },
        "developerNote": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "category", "title", "message", "rating"]
    },
    "AuthoredPuzzle": {
      "title": "AuthoredPuzzle",
      "description": "User created chess puzzles and tactical scenarios",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "theme": { "type": "string", "maxLength": 100 },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard", "Master"] },
        "rating": { "type": "number" },
        "fen": { "type": "string", "maxLength": 200 },
        "playerColor": { "type": "string", "enum": ["w", "b"] },
        "authorUid": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorBadge": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "likesCount": { "type": "number" },
        "solvesCount": { "type": "number" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["id", "title", "fen", "playerColor", "difficulty"]
    },
    "GameLog": {
      "title": "GameLog",
      "description": "Historical record of finished chess matches and audits",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string" },
        "mode": { "type": "string", "maxLength": 50 },
        "opponentName": { "type": "string", "maxLength": 100 },
        "playerColor": { "type": "string", "enum": ["w", "b"] },
        "result": { "type": "string", "enum": ["win", "loss", "draw", "executed", "mercied"] },
        "reason": { "type": "string", "maxLength": 200 },
        "movesCount": { "type": "number" },
        "timeControlName": { "type": "string", "maxLength": 50 },
        "pgn": { "type": "string", "maxLength": 10000 },
        "finalFen": { "type": "string", "maxLength": 200 },
        "respectChange": { "type": "number" },
        "eloChange": { "type": "number" }
      },
      "required": ["id", "date", "mode", "result"]
    },
    "SystemAnnouncement": {
      "title": "SystemAnnouncement",
      "description": "Global developer announcements displayed across the app",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 2000 },
        "author": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["info", "update", "championship", "maintenance"] },
        "active": { "type": "boolean" }
      },
      "required": ["id", "title", "content", "active"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User specific notifications for challenges, friends, and system alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["challenge", "friend_request", "achievement", "system"] },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "link": { "type": "string", "maxLength": 256 },
        "actionData": { "type": "object" }
      },
      "required": ["id", "userId", "type", "title", "message", "isRead", "createdAt"]
    },
    "InGameMessage": {
      "title": "InGameMessage",
      "description": "Real-time message within a specific match arena",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "senderUid": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "text": { "type": "string", "maxLength": 2000 },
        "type": { "type": "string", "enum": ["text", "canned", "emote", "system"] },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "senderUid", "text", "type"]
    },
    "TypingStatus": {
      "title": "TypingStatus",
      "description": "Real-time typing indicator for match chat",
      "type": "object",
      "properties": {
        "isTyping": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["isTyping"]
    },
    "AboutUsConfig": {
      "title": "AboutUsConfig",
      "description": "Dynamic CMS configuration for the About Us page",
      "type": "object",
      "properties": {
        "appName": { "type": "string" },
        "tagline": { "type": "string" },
        "founderNote": { "type": "string" },
        "visionParagraphs": { "type": "string" },
        "socialLinks": {
          "type": "object",
          "properties": {
            "discord": { "type": "string" },
            "github": { "type": "string" },
            "twitter": { "type": "string" },
            "telegram": { "type": "string" },
            "youtube": { "type": "string" }
          }
        },
        "credits": { "type": "string" },
        "announcementBanner": { "type": "string" },
        "lastUpdated": { "type": "any" }
      },
      "required": ["appName", "tagline", "founderNote", "visionParagraphs", "credits"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "aboutUs": { "$ref": "#/entities/AboutUsConfig" }
      },
      "required": ["maintenanceMode"]
    },
    "PrivateRoom": {
      "title": "PrivateRoom",
      "description": "Lean private waiting room document with essential metadata only",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "maxLength": 128 },
        "roomCode": { "type": "string", "maxLength": 10 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "creatorName": { "type": "string", "maxLength": 100 },
        "creatorPhotoURL": { "type": "string", "maxLength": 1000 },
        "creatorElo": { "type": "number" },
        "creatorColor": { "type": "string", "enum": ["white", "black", "random"] },
        "opponentId": { "type": "string", "maxLength": 128 },
        "opponentName": { "type": "string", "maxLength": 100 },
        "opponentPhotoURL": { "type": "string", "maxLength": 1000 },
        "opponentElo": { "type": "number" },
        "opponentColor": { "type": "string", "enum": ["white", "black"] },
        "status": { "type": "string", "enum": ["waiting", "ready", "in_progress", "ended", "expired"] },
        "settings": { "type": "object" },
        "createdAt": { "type": "any" },
        "expiresAt": { "type": "any" },
        "startedAt": { "type": "any" },
        "gameId": { "type": "string", "maxLength": 128 }
      },
      "required": ["roomCode", "creatorId", "creatorName", "status", "settings"]
    },
    "RoomMessage": {
      "title": "RoomMessage",
      "description": "Room message in subcollection",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userPhotoURL": { "type": "string", "maxLength": 1000 },
        "message": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "any" },
        "isSystem": { "type": "boolean" },
        "type": { "type": "string" }
      },
      "required": ["userId", "userName", "message"]
    },
    "RoomInvite": {
      "title": "RoomInvite",
      "description": "Invite document in room subcollection",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userPhotoURL": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "invitedAt": { "type": "any" },
        "invitedBy": { "type": "string", "maxLength": 128 },
        "settings": { "type": "object" }
      },
      "required": ["userId", "userName", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with battlefield stats, role, and badge number"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User specific notifications and actionable alerts"
    },
    "/friend_requests/{requestId}": {
      "schema": "FriendRequest",
      "description": "Pending and accepted friend requests between users"
    },
    "/direct_messages/{chatId}/messages/{messageId}": {
      "schema": "DirectMessage",
      "description": "Private direct messages exchanged between friends"
    },
    "/online_matches/{matchId}": {
      "schema": "OnlineMatch",
      "description": "Real-time multiplayer match state"
    },
    "/online_matches/{matchId}/chat/{messageId}": {
      "schema": "InGameMessage",
      "description": "Real-time messages sent within the match"
    },
    "/online_matches/{matchId}/typing/{userId}": {
      "schema": "TypingStatus",
      "description": "Real-time typing indicators for players"
    },
    "/rooms/{roomId}": {
      "schema": "PrivateRoom",
      "description": "Lean private room configuration and status"
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": "RoomMessage",
      "description": "Individual room chat messages in subcollection"
    },
    "/rooms/{roomId}/invites/{inviteId}": {
      "schema": "RoomInvite",
      "description": "Individual room invites in subcollection"
    },
    "/feedbacks/{feedbackId}": {
      "schema": "UserFeedback",
      "description": "User feedback messages accessible to developer and author"
    },
    "/announcements/{announcementId}": {
      "schema": "SystemAnnouncement",
      "description": "Broadcast announcements posted by the developer"
    },
    "/authored_puzzles/{puzzleId}": {
      "schema": "AuthoredPuzzle",
      "description": "Community and user created chess puzzles and tactical scenarios"
    },
    "/game_logs/{logId}": {
      "schema": "GameLog",
      "description": "User match logs and historical battle audit records"
    },
    "/system_configs/{configId}": {
      "schema": "SystemConfig",
      "description": "Global system configurations including CMS content and stickers"
    }
  }
}
